{% extends "layout-auth.html.jinja" %}
{% block title %}Choose a username · grund{% endblock %}
{% block card %}
{{ ui.auth_head("Choose a username", provider ~ " confirmed " ~ email ~ ". Pick the name your account and organisation go by.") }}
{% call forms.form("/auth/complete", csrf) %}
  {{ forms.form_error(error) }}
  {{ forms.field("username", "Username", value=username, autocomplete="username", hint="3 to 32 letters, digits and single hyphens. It is public.", autofocus=true) }}
  {{ ui.button("Create account", block=true) }}
{% endcall %}
{% endblock %}
