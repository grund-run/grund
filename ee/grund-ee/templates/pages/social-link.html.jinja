{% extends "layout-auth.html.jinja" %}
{% block title %}Connect {{ provider }} · grund{% endblock %}
{% block card %}
{{ ui.auth_head("Connect " ~ provider, "An account with " ~ email ~ " already exists. Enter its password to connect " ~ provider ~ " to it. After that, either way signs you in.") }}
{% call forms.form("/auth/link", csrf) %}
  {{ forms.form_error(error) }}
  {{ forms.field("password", "Password", type="password", autocomplete="current-password", autofocus=true) }}
  {{ ui.button("Connect and sign in", block=true) }}
{% endcall %}
{% call ui.foot() %}<p>No password on that account? <a href="/reset">Set one first</a>.</p>{% endcall %}
{% endblock %}
