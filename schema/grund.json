{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Definition": {
      "additionalProperties": false,
      "description": "The complete desired stack, before catalogue and image resolution.",
      "properties": {
        "machines": {
          "description": "Candidate machine names; omitted means any eligible organisation machine.",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "name": {
          "description": "Organisation-scoped identity, starting with a lowercase letter, at most 32 characters.",
          "maxLength": 32,
          "minLength": 1,
          "not": {
            "const": "machines"
          },
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/definitions/HardPlacement"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only kind and labels are allowed: stacks always place together."
        },
        "public": {
          "anyOf": [
            {
              "$ref": "#/definitions/PublicTarget"
            },
            {
              "type": "null"
            }
          ],
          "description": "The single public HTTP or h2c endpoint; omitted means private."
        },
        "services": {
          "additionalProperties": {
            "$ref": "#/definitions/StackService"
          },
          "description": "Services in declaration order. Duplicate names are refused.",
          "maxProperties": 10,
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        }
      },
      "required": [
        "name",
        "services"
      ],
      "type": "object"
    },
    "FileApp": {
      "additionalProperties": false,
      "description": "One app: what each copy runs, and how many copies run where.",
      "properties": {
        "auto_rollback": {
          "description": "Go back to the release before when a rollout fails. Default true;\nfalse halts the app as it is until the next release.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "check": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileCheck"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ready check a new copy must pass before it takes traffic and\nbefore an older copy leaves. Leave it out to count a running copy as\nready."
        },
        "command": {
          "description": "Replaces the image's entrypoint and command, one argument per item.\nLeave it out to run what the image says.",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "copies": {
          "description": "How many copies run. Default 1, at most 20.",
          "format": "uint32",
          "maximum": 20,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Environment variables, by name. A value is kept as written: `8080`,\n`1.50` and `true` are those strings. At most 128, 32 KiB in all.",
          "type": "object"
        },
        "image": {
          "description": "The container image, as `docker pull` takes it, for example\n`ghcr.io/acme/shop:2026-09-26.1` or `nginx:1.27`. grund resolves the\ntag to a digest once, at deploy, and every copy runs that digest.",
          "minLength": 1,
          "type": "string"
        },
        "machines": {
          "description": "The machines the copies may run on, by name. Leave it out for any\nmachine in the organisation.",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/definitions/FilePlacement"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which machines beyond their names, and how the copies spread over\nthem. Leave it out for any machine, spread one copy per machine\nfirst."
        },
        "ports": {
          "description": "The ports the app listens on. At most 8, of which at most 2 public.",
          "items": {
            "$ref": "#/definitions/FilePort"
          },
          "maxItems": 8,
          "type": "array"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileRelease"
            },
            {
              "type": "null"
            }
          ],
          "description": "How a new release replaces the copies of the one before."
        },
        "reschedule_after": {
          "description": "Seconds a copy's machine may be unreachable before the copy is placed\nelsewhere. Default 120, 30 to 3600.",
          "format": "uint32",
          "maximum": 3600,
          "minimum": 30,
          "type": [
            "integer",
            "null"
          ]
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileResources"
            },
            {
              "type": "null"
            }
          ],
          "description": "What each copy reserves on its machine. Default 512 MiB and 1 CPU."
        },
        "secrets": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables taken from the organisation's secrets: the\nvariable's name, then the secret's. The value never appears in the\nfile. At most 50.",
          "type": "object"
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileStop"
            },
            {
              "type": "null"
            }
          ],
          "description": "How a copy is stopped."
        },
        "volumes": {
          "additionalProperties": {
            "$ref": "#/definitions/FileVolume"
          },
          "description": "App-owned storage, by name. Omission only removes a mount from this\nrelease; it never deletes a volume. Volumes require exactly one copy.",
          "propertyNames": {
            "maxLength": 32,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        }
      },
      "required": [
        "image"
      ],
      "type": "object"
    },
    "FileBackup": {
      "enum": [
        "off",
        "daily"
      ],
      "type": "string"
    },
    "FileCheck": {
      "additionalProperties": false,
      "description": "A ready check: an HTTP path that answers 2xx or 3xx, or a TCP port that\naccepts a connection. Give exactly one of `http` and `tcp`.",
      "properties": {
        "http": {
          "description": "The path to ask, for example `/healthz`.",
          "type": [
            "string",
            "null"
          ]
        },
        "interval_ms": {
          "description": "Milliseconds between checks. Default 2000, 500 to 60000.",
          "format": "uint32",
          "maximum": 60000,
          "minimum": 500,
          "type": [
            "integer",
            "null"
          ]
        },
        "port": {
          "description": "The port an `http` check asks. Default the app's first port.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "tcp": {
          "description": "The port to connect to.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "timeout_ms": {
          "description": "Milliseconds one check may take, below the interval. Default 1000,\n100 to 30000.",
          "format": "uint32",
          "maximum": 30000,
          "minimum": 100,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "FileMachineKind": {
      "description": "Which kind of machine.",
      "oneOf": [
        {
          "const": "own",
          "description": "The organisation's own machines.",
          "type": "string"
        },
        {
          "const": "hosted",
          "description": "Machines grund hosts.",
          "type": "string"
        }
      ]
    },
    "FilePlacement": {
      "additionalProperties": false,
      "description": "Where the copies run, beyond the machines' names. A copy on a machine\nthat stops matching moves to one that does, started before it stops.",
      "properties": {
        "apart": {
          "description": "Other apps whose machines are avoided, after the spread. At most 10.",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileMachineKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "`own` for the organisation's own machines only, `hosted` for machines\ngrund hosts only. Leave it out for either."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels a machine must carry, each with this value, as set on the\nMachines page, for example `disk: ssd`. At most 16.",
          "maxProperties": 16,
          "type": "object"
        },
        "near": {
          "description": "Other apps whose machines are preferred, after the spread. At most\n10.",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "spread_by": {
          "description": "A label key whose values are failure domains, for example `zone`:\ncopies go to the value with the fewest copies first, then to the\nmachine with the fewest. Machines without the label count as one\ndomain.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "FilePort": {
      "additionalProperties": false,
      "description": "A port the app listens on.",
      "properties": {
        "name": {
          "description": "A name for the port, unique in the app, for example `http`.",
          "type": "string"
        },
        "port": {
          "description": "The port inside the container, 1 to 65535.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileProtocol"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the port speaks. Default `http`."
        },
        "public": {
          "description": "Serve the port at the app's public address. Default false: reachable\nonly inside the organisation, at `<app>.grund.internal`.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "port"
      ],
      "type": "object"
    },
    "FileProtocol": {
      "description": "What a port speaks.",
      "oneOf": [
        {
          "const": "http",
          "description": "HTTP/1.1, and HTTP/2 where the client asks for it.",
          "type": "string"
        },
        {
          "const": "h2c",
          "description": "HTTP/2 without TLS, for gRPC.",
          "type": "string"
        },
        {
          "const": "tcp",
          "description": "Plain TCP.",
          "type": "string"
        }
      ]
    },
    "FileRelease": {
      "additionalProperties": false,
      "description": "How a release rolls out.",
      "properties": {
        "drain": {
          "description": "Seconds an old copy keeps serving after traffic leaves it. Default\n30, at most 300.",
          "format": "uint32",
          "maximum": 300,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_surge": {
          "description": "Copies of the new release started beyond `copies` at once. Default\n1, at most `copies`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_unavailable": {
          "description": "Copies that may be missing during the rollout. Default 0.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_ready": {
          "description": "Seconds a new copy must stay ready before it counts. Default 10, at\nmost 600.",
          "format": "uint32",
          "maximum": 600,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ready_deadline": {
          "description": "Seconds the whole rollout may take before it fails. Default 300, 10\nto 1800.",
          "format": "uint32",
          "maximum": 1800,
          "minimum": 10,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "FileResources": {
      "additionalProperties": false,
      "description": "What each copy reserves.",
      "properties": {
        "cpu": {
          "description": "CPUs, for example 0.5 or 2. Default 1, 0.01 to 64.",
          "format": "double",
          "maximum": 64,
          "minimum": 0.01,
          "type": [
            "number",
            "null"
          ]
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/definitions/Memory"
            },
            {
              "type": "null"
            }
          ],
          "description": "Memory, as `512 MiB` or `4 GiB`, or a number of MiB. Default\n512 MiB, 16 MiB to 256 GiB."
        }
      },
      "type": "object"
    },
    "FileStop": {
      "additionalProperties": false,
      "description": "How a copy is stopped: the signal, then a kill after the grace period.",
      "properties": {
        "grace": {
          "description": "Seconds between the signal and the kill. Default 30, at most 300.",
          "format": "uint32",
          "maximum": 300,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "description": "The signal sent first. Default SIGTERM; one of SIGTERM, SIGINT,\nSIGQUIT, SIGUSR1, SIGUSR2 or SIGHUP.",
          "examples": [
            "SIGTERM",
            "SIGINT",
            "SIGQUIT",
            "SIGUSR1",
            "SIGUSR2",
            "SIGHUP"
          ],
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "FileVolume": {
      "additionalProperties": false,
      "description": "One volume mounted by this app. An omitted source uses an own-machine\nmanaged directory unless size_gib requests hosted block storage.",
      "properties": {
        "backup": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileBackup"
            },
            {
              "type": "null"
            }
          ],
          "description": "`daily` opts into daily backups (requires a configured destination).\nOmitted or `off` means no scheduled backups."
        },
        "path": {
          "description": "Absolute directory path in the container; paths must not overlap.",
          "maxLength": 4096,
          "minLength": 2,
          "pattern": "^/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+(?:/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+)*$",
          "type": "string"
        },
        "size_gib": {
          "description": "Hosted block volume capacity in GiB (1 to 4096). Leave out for an\nown-machine directory with no promised quota.",
          "format": "uint64",
          "maximum": 4096,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "description": "Existing absolute host directory on an own machine, allowed by its\nlocal policy. Leave out for a managed or hosted volume.",
          "maxLength": 4096,
          "pattern": "^/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+(?:/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+)*$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HardPlacement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileMachineKind"
            },
            {
              "type": "null"
            }
          ],
          "not": {
            "const": "hosted"
          }
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "maxProperties": 16,
          "type": "object"
        }
      },
      "type": "object"
    },
    "Memory": {
      "anyOf": [
        {
          "maximum": 262144,
          "minimum": 16,
          "type": "integer"
        },
        {
          "pattern": "^\\s*[0-9.]+\\s*(MiB|M|MB|GiB|G|GB)?\\s*$",
          "type": "string"
        }
      ]
    },
    "PublicTarget": {
      "additionalProperties": false,
      "description": "One selected service port exposed at the stack address.",
      "properties": {
        "port": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "required": [
        "service",
        "port"
      ],
      "type": "object"
    },
    "StackService": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "restart": {
                "const": "exclusive"
              }
            },
            "required": [
              "restart"
            ]
          },
          "then": {
            "properties": {
              "copies": {
                "const": 1
              },
              "release": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "max_surge"
                      ]
                    },
                    {
                      "required": [
                        "max_unavailable"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "release": {
              "properties": {
                "max_surge": {
                  "minimum": 1
                }
              }
            }
          }
        }
      ],
      "description": "One app: what each copy runs, and how many copies run where.",
      "oneOf": [
        {
          "not": {
            "required": [
              "template"
            ]
          },
          "properties": {
            "volumes": {
              "additionalProperties": {
                "required": [
                  "path"
                ]
              }
            }
          },
          "required": [
            "image"
          ]
        },
        {
          "not": {
            "required": [
              "image"
            ]
          },
          "properties": {
            "check": false,
            "command": false,
            "copies": {
              "const": 1
            },
            "env": false,
            "ports": false,
            "secrets": false,
            "volumes": {
              "additionalProperties": false,
              "properties": {
                "data": {
                  "additionalProperties": false,
                  "properties": {
                    "backup": {
                      "enum": [
                        "off",
                        "daily"
                      ],
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "template"
          ]
        }
      ],
      "properties": {
        "check": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileCheck"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ready check a new copy must pass before it takes traffic and\nbefore an older copy leaves. Leave it out to count a running copy as\nready."
        },
        "command": {
          "description": "Replaces the image's entrypoint and command, one argument per item.\nLeave it out to run what the image says.",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "copies": {
          "description": "How many copies run. Default 1, at most 20.",
          "format": "uint32",
          "maximum": 20,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 9,
          "type": "array",
          "uniqueItems": true
        },
        "env": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Environment variables, by name. A value is kept as written: `8080`,\n`1.50` and `true` are those strings. At most 128, 32 KiB in all.",
          "type": "object"
        },
        "image": {
          "description": "The container image, as `docker pull` takes it, for example\n`ghcr.io/acme/shop:2026-09-26.1` or `nginx:1.27`. grund resolves the\ntag to a digest once, at deploy, and every copy runs that digest.",
          "minLength": 1,
          "type": "string"
        },
        "ports": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "port": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "protocol": {
                "enum": [
                  "http",
                  "h2c",
                  "tcp"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "port"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "type": "array"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileRelease"
            },
            {
              "type": "null"
            }
          ],
          "description": "How a new release replaces the copies of the one before."
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileResources"
            },
            {
              "type": "null"
            }
          ],
          "description": "What each copy reserves on its machine. Default 512 MiB and 1 CPU."
        },
        "restart": {
          "enum": [
            "rolling",
            "exclusive"
          ],
          "type": "string"
        },
        "secrets": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables taken from the organisation's secrets: the\nvariable's name, then the secret's. The value never appears in the\nfile. At most 50.",
          "type": "object"
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileStop"
            },
            {
              "type": "null"
            }
          ],
          "description": "How a copy is stopped."
        },
        "template": {
          "minLength": 1,
          "type": "string"
        },
        "volumes": {
          "additionalProperties": {
            "additionalProperties": false,
            "description": "One volume mounted by this app. An omitted source uses an own-machine\nmanaged directory unless size_gib requests hosted block storage.",
            "properties": {
              "backup": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/FileBackup"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "`daily` opts into daily backups (requires a configured destination).\nOmitted or `off` means no scheduled backups."
              },
              "path": {
                "description": "Absolute directory path in the container; paths must not overlap.",
                "maxLength": 4096,
                "minLength": 2,
                "pattern": "^/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+(?:/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+)*$",
                "type": "string"
              },
              "size_gib": {
                "description": "Hosted block volume capacity in GiB (1 to 4096). Leave out for an\nown-machine directory with no promised quota.",
                "format": "uint64",
                "maximum": 4096,
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source": {
                "description": "Existing absolute host directory on an own machine, allowed by its\nlocal policy. Leave out for a managed or hosted volume.",
                "maxLength": 4096,
                "pattern": "^/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+(?:/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+)*$",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "propertyNames": {
            "maxLength": 32,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "description": "A grund.yaml declares either independently deployed apps or one stack.",
  "oneOf": [
    {
      "not": {
        "required": [
          "stack"
        ]
      },
      "required": [
        "apps"
      ]
    },
    {
