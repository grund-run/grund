# grund settings for `docker compose up`. Copy to .env and uncomment what you
# change; compose reads .env on its own. Nothing here is required: the
# defaults give a working instance at http://localhost:8080 with mail caught
# by Mailpit at http://localhost:8025.
#
# `grund serve --help` is the full reference; every flag has the variable
# named here. Secrets are generated on first start (the grund-data volume), so
# none needs to be typed in.

# ---------------------------------------------------------------- compose

# A published image instead of building this checkout, e.g.
# git.kjuulh.io/grund/grund:main-<commit>. There is no moving `latest` tag.
# Set both lines together: `build` (the default) rebuilds this checkout on
# every `up`, `missing` pulls the image named here.
# GRUND_IMAGE=git.kjuulh.io/grund/grund:main-<commit>
# GRUND_PULL_POLICY=missing

# Where the dashboard is published on this machine. 127.0.0.1 keeps it local;
# put a TLS-terminating proxy in front before exposing it (README, "Self-hosting").
# GRUND_BIND=127.0.0.1
# GRUND_PORT=8080
# GRUND_MAILPIT_PORT=8025

# ---------------------------------------------------------------- the instance

# The address people use to reach grund, exactly as they type it: links in
# mail point here and forms from anywhere else are refused. Plain http is
# accepted only for localhost (or with GRUND_DEV_MODE=true). Change it with
# GRUND_PORT, or when a proxy serves grund on its own name:
# GRUND_PUBLIC_URL=https://grund.example.com
# GRUND_PUBLIC_URL=http://localhost:8080

# One organisation for the whole instance (single, the default): the first
# account to sign up becomes its admin, and everyone after joins by
# invitation from the Members page. multi gives every sign-up its own
# organisation and lets anyone create more, as grund's hosted service does.
# GRUND_ORGANISATIONS=single

# Whether sign-up without an invitation is open at all. With single, it only
# ever admits the first account; set false to close even that.
# GRUND_SIGNUP_ENABLED=true

# Development only: allows plain http on a network address and a throwaway
# secret key. Never on an instance people depend on.
# GRUND_DEV_MODE=false

# Log format (compact or json) and filter.
# GRUND_LOG_FORMAT=json
# RUST_LOG=grund=info,grund_server=info,grund_store=info,notmad=info,warn

# ---------------------------------------------------------------- mail

# Where mail goes. The default delivers into Mailpit, which delivers nowhere:
# fine to try grund, not for real users. Examples:
#   smtp://user:password@smtp.example.com:587?tls=required   (STARTTLS)
#   smtps://user:password@smtp.example.com:465               (TLS)
# GRUND_SMTP_URL=smtp://mailpit:1025
# GRUND_MAIL_FROM=grund <grund@example.com>

# ---------------------------------------------------------------- limits

# How many reverse proxies in front of grund append X-Forwarded-For. Exactly
# the number you run; 0 uses the connecting address.
# GRUND_TRUSTED_PROXY_HOPS=0

# Failed sign-ins per account name per 15 minutes before a 15-minute lock.
# GRUND_LOGIN_FAILURES_PER_ACCOUNT=10
# Sign-in attempts per client address per 15 minutes (0 = no per-address limit).
# GRUND_LOGIN_ATTEMPTS_PER_ADDRESS=100
# Reset and verification mails per address per hour.
# GRUND_MAIL_REQUESTS_PER_EMAIL=3
# Sign-up, reset and resend requests per client address per hour (0 = off).
# GRUND_MAIL_REQUESTS_PER_ADDRESS=20

# Session lifetime, in hours: idle timeout and absolute maximum.
# GRUND_SESSION_IDLE_TIMEOUT=168
# GRUND_SESSION_MAX_AGE=720

# ---------------------------------------------------------------- license

# Commercial features (social sign-in) need a grund license key. Without one,
# grund runs every free feature and ignores the social settings below.
# GRUND_LICENSE_KEY=

# Social sign-in. Create the OAuth app at the provider with the callback
# <GRUND_PUBLIC_URL>/auth/<provider>/callback (github, google or oidc).
# GRUND_SOCIAL_LOGIN=false
# GRUND_GITHUB_CLIENT_ID=
# GRUND_GITHUB_CLIENT_SECRET=
# GRUND_GOOGLE_CLIENT_ID=
# GRUND_GOOGLE_CLIENT_SECRET=
# GRUND_OIDC_ISSUER=https://sso.example.com
# GRUND_OIDC_CLIENT_ID=
# GRUND_OIDC_CLIENT_SECRET=
# GRUND_OIDC_NAME=Single sign-on

# ---------------------------------------------------------------- tuning

# GRUND_DATABASE_MAX_CONNECTIONS=10
# GRUND_DATABASE_ACQUIRE_TIMEOUT=5
# GRUND_DATABASE_STATEMENT_TIMEOUT=10
# GRUND_WORK_POLL_INTERVAL=5
# GRUND_HEALTH_INTERVAL=5
# GRUND_REQUEST_TIMEOUT=15
# GRUND_SHUTDOWN_GRACE=10
# GRUND_NATS_SUBJECT_PREFIX=grund

# ---------------------------------------------------------------- reporting

# grund reports nothing about its accounts to anyone unless both of these are
# set. They are for operators who run grund insights (a separate service) to
# keep track of their own users, as the hosted grund does: once an account's
# address is confirmed, its username, address, sign-in method and the times it
# registered and confirmed are sent to <url>/v1/accounts. Leave them unset.
# GRUND_INSIGHTS_URL=
# GRUND_INSIGHTS_TOKEN=

# Billing (grund's hosted service only; see proto/grund/billing/v1). Without
# these, every organisation is free and nothing is sent anywhere.
# GRUND_BILLING_URL=http://billing:8080
# GRUND_BILLING_TOKEN=
