{#- ------------------------------------------------------------------
    The style guide's own parts: how /style-guide lays out each
    component beside the call that makes it. No product page uses these;
    their classes (.sg-*) are the catalogue's alone.
    ------------------------------------------------------------------ -#}
{% import "components/ui.html.jinja" as ui %}

{#- specimen(title, code, note="")
    One component or variant: a title, the {% call %} body rendered live,
    and code, the template call to copy, shown as text. note: one line
    on when to use it. -#}
{% macro specimen(title, code, note="") -%}
<div class="sg-specimen">
  <div class="sg-head"><p class="sg-title">{{ title }}</p>{% if note %}<p class="sg-note">{{ note }}</p>{% endif %}</div>
  <div class="sg-demo">{{ caller() }}</div>
  <pre class="sg-code"><code>{{ code }}</code></pre>
</div>
{%- endmacro %}

{#- demos(): several examples side by side in a specimen. -#}
{% macro demos() -%}
<div class="sg-row">{{ caller() }}</div>
{%- endmacro %}

{#- column(): examples stacked at a signed-out form's width. -#}
{% macro column() -%}
<div class="sg-column">{{ caller() }}</div>
{%- endmacro %}

{#- labelled(label): one example with a small label under it (a state). -#}
{% macro labelled(label) -%}
<div class="sg-labelled">{{ caller() }}<span class="sg-label">{{ label }}</span></div>
{%- endmacro %}

{#- swatches(swatches): the colour tokens, (name, use) pairs. -#}
{% macro swatches(swatches) -%}
<ul class="sg-swatches">
  {% for name, use in swatches %}<li class="sg-swatch"><span class="sg-chip sg-{{ name }}"></span><code>--{{ name }}</code><span class="sg-label">{{ use }}</span></li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- type_scale(steps): the type tokens, (name, size, use) triples. -#}
{% macro type_scale(steps) -%}
<ul class="sg-scale">
  {% for name, size, use in steps %}<li><span class="sg-sample sg-text-{{ name }}">Deploy any image</span><code>--text-{{ name }}</code><span class="sg-label">{{ size }} · {{ use }}</span></li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- space_scale(steps): the spacing tokens, (n, size) pairs, as bars. -#}
{% macro space_scale(steps) -%}
<ul class="sg-scale">
  {% for n, size in steps %}<li><span class="sg-bar sg-space-{{ n }}"></span><code>--space-{{ n }}</code><span class="sg-label">{{ size }}</span></li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- radii(): the radius tokens as boxes. -#}
{% macro radii() -%}
<ul class="sg-scale sg-scale-row">
  {% for name, size, use in [("radius-sm", "8 px", "buttons, inputs, menus"), ("radius", "12 px", "boxes, cards, callouts"), ("radius-lg", "16 px", "large panels")] %}<li><span class="sg-box sg-{{ name }}"></span><code>--{{ name }}</code><span class="sg-label">{{ size }} · {{ use }}</span></li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- borders(): the border strengths, each on a box. -#}
{% macro borders() -%}
<ul class="sg-scale sg-scale-row">
  <li><span class="sg-box sg-edge-control"></span><code>--border-control</code><span class="sg-label">the edge of what you operate: inputs, selects, the search, secondary buttons, the kebab, the switcher, the view toggle. 3:1 or more against what is around it (WCAG 1.4.11)</span></li>
  <li><span class="sg-box sg-edge-strong"></span><code>--border-strong</code><span class="sg-label">menus, tags, dashed empty states</span></li>
  <li><span class="sg-box sg-edge"></span><code>--border</code><span class="sg-label">dividers between rows, boxes of rows</span></li>
</ul>
{%- endmacro %}

{#- icon_grid(names): every icon in the sprite, by name. -#}
{% macro icon_grid(names) -%}
<ul class="sg-icons">
  {% for name in names %}<li>{{ ui.icon(name) }}<code>{{ name }}</code></li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- contents(parts): links to the catalogue's sections, (id, title). -#}
{% macro contents(parts) -%}
<nav class="sg-contents" aria-label="Catalogue">
  {% for id, title in parts %}<a href="#{{ id }}">{{ title }}</a>
  {% endfor %}
</nav>
{%- endmacro %}
