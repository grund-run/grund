{#- ------------------------------------------------------------------
    The catalogue's basics and page parts: icons, the brand, tags,
    statuses, buttons and links, page and section heads, callouts, empty
    states, notes and code. Forms are in forms.html.jinja, lists of things
    in lists.html.jinja, the signed-in shell in shell.html.jinja.

    The rule: a page under pages/ writes no class attribute and no raw
    <button>, <input>, <select>, <textarea>, <form>, <svg> or <details>.
    It calls these macros, and plain <p>, <a>, <code> and <strong> carry
    its words. templates.rs's tests fail the build otherwise. Every macro
    is rendered, with the call to copy, on /style-guide.
    ------------------------------------------------------------------ -#}

{#- icon(name, class="")
    One icon from the sprite (icons.html.jinja), drawn in currentColor.
    class: icon-sm (18 px) or icon-lg (36 px), and a tone-* colour. -#}
{% macro icon(name, class="") -%}
<svg class="icon {{ class }}" aria-hidden="true"><use href="#i-{{ name }}"/></svg>
{%- endmacro %}

{#- brand(href="/"): the wolf mark and "grund", linking home. -#}
{% macro brand(href="/") -%}
<a class="brand" href="{{ href }}"><img class="brand-mark" src="/static/mark.svg" alt="" width="40" height="40">grund</a>
{%- endmacro %}

{#- skip_link(): the first thing a keyboard reaches, to #main. -#}
{% macro skip_link() -%}
<a class="skip" href="#main">Skip to content</a>
{%- endmacro %}

{#- mark(name, size="")
    The letter standing for an organisation or a person.
    size: "" (28 px, rounded square) or "lg" (40 px, round, for rows) -#}
{% macro mark(name, size="") -%}
<span class="org-mark{% if size %} org-mark-{{ size }}{% endif %}" aria-hidden="true">{{ name[:1] }}</span>
{%- endmacro %}

{#- tag(text): a tiny rounded label: "You", "Runs VMs", "Needs storage". -#}
{% macro tag(text) -%}
<span class="tag">{{ text }}</span>
{%- endmacro %}

{#- pill(text, tone="", icon_name="")
    A rounded label saying what a thing is or how it is, larger than a
    tag: "Live" beside an app's name, "Public HTTP" under its address.
    tone:      a dot of that colour before the text (ok, blue, orange,
               danger, muted)
    icon_name: an icon before the text instead -#}
{% macro pill(text, tone="", icon_name="") -%}
<span class="pill">{% if icon_name %}{{ icon(icon_name, "icon-sm") }}{% elif tone %}<span class="dot tone-{{ tone }}" aria-hidden="true"></span>{% endif %}{{ text }}</span>
{%- endmacro %}

{#- image_icon(key, size="")
    An app's image icon; key from web::apps::image_icon. The page must
    carry images.sprite() with that key, except "image", the neutral box
    from the main sprite. size: "" (32 px) or "lg" (72 px, a page head) -#}
{% macro image_icon(key, size="") -%}
{% set class = "image-icon" ~ (" image-icon-" ~ size if size else "") %}
{% if key == "image" %}<span class="{{ class }} image-icon-neutral" aria-hidden="true">{{ icon("box") }}</span>
{%- else %}<svg class="{{ class }}" viewBox="0 0 32 32" aria-hidden="true"><use href="#img-{{ key }}"/></svg>{% endif %}
{%- endmacro %}

{#- status(text, tone="ok")
    A toned mark and a word: how a thing is ("Serving", "Offline"). The
    mark follows the tone, so it reads without colour: a check (ok,
    violet), an alert (orange, danger), a clock (blue, busy) or a dash
    (muted, idle or gone).
    tone: ok, blue, orange, violet, danger or muted -#}
{% macro status(text, tone="ok") -%}
<span class="row-status">{{ icon({"orange": "alert", "danger": "alert", "blue": "clock", "muted": "minus"}[tone] | default("ok"), "tone-" ~ tone) }}{{ text }}</span>
{%- endmacro %}

{#- button(label, href="", icon_name="", kind="primary", size="",
           type="submit", collapse=false, block=false, icon_size="sm",
           extra="", icon_end=false)
    A link when href is set, else a <button type=type>.
    kind:      primary (one per page), secondary, danger or ghost
    size:      "" or "sm"
    collapse:  below 520 px only the icon shows (the label stays for
               screen readers)
    block:     the full width of its column (signed-out forms)
    icon_size: "sm" (18 px) or "" (22 px, for brand logos)
    extra:     more classes, such as js-hide (or is-hover and is-focus,
               which pin a state on the style guide)
    icon_end:  the icon after the label ("Browse templates →")
    hidden:    not shown until the script shows it (a button only the
               script can work, such as "Add another")
    download:  the link saves its target as this filename -#}
{% macro button(label, href="", icon_name="", kind="primary", size="", type="submit", collapse=false, block=false, icon_size="sm", extra="", icon_end=false, hidden=false, download="") -%}
{% set class = "btn btn-" ~ kind ~ (" btn-" ~ size if size else "") ~ (" btn-block" if block else "") ~ (" " ~ extra if extra else "") %}
{% if href %}<a class="{{ class }}" href="{{ href }}"{% if download %} download="{{ download }}"{% endif %}>{% else %}<button class="{{ class }}" type="{{ type }}"{% if hidden %} hidden{% endif %}>{% endif -%}
{% if icon_name and not icon_end %}{{ icon(icon_name, "icon-" ~ icon_size if icon_size else "") }}{% endif %}<span{% if collapse %} class="btn-label"{% endif %}>{{ label }}</span>
{%- if icon_name and icon_end %}{{ icon(icon_name, "icon-" ~ icon_size if icon_size else "") }}{% endif %}
{%- if href %}</a>{% else %}</button>{% endif %}
{%- endmacro %}

{#- link_more(href, label): the onward link, accent text and an arrow
    ("View all →"). -#}
{% macro link_more(href, label) -%}
<a class="link-more" href="{{ href }}">{{ label }}{{ icon("arrow", "icon-sm") }}</a>
{%- endmacro %}

{#- external(href, label)
    A link that opens in a new tab, with the external icon, and says so
    to screen readers. -#}
{% macro external(href, label) -%}
<a class="address" href="{{ href }}" rel="noopener noreferrer" target="_blank"><span class="address-text">{{ label }}</span>{{ icon("external", "icon-sm") }}<span class="visually-hidden"> (opens in a new tab)</span></a>
{%- endmacro %}

{#- icon_link(href, icon_name, label, external=false)
    A square icon-only link; label is its accessible name. -#}
{% macro icon_link(href, icon_name, label, external=false) -%}
<a class="icon-btn" href="{{ href }}"{% if external %} rel="noopener noreferrer" target="_blank"{% endif %} aria-label="{{ label }}">{{ icon(icon_name, "icon-sm") }}</a>
{%- endmacro %}

{#- copy_button(text, label, labelled=false)
    Copies text. Hidden until the script shows it, so it never appears
    without a clipboard. label: what it copies, for its accessible name.
    labelled: a small secondary button saying "Copy" (beside Download)
    rather than an icon alone. -#}
{% macro copy_button(text, label, labelled=false) -%}
{% if labelled %}<button class="btn btn-secondary btn-sm copy" type="button" data-copy="{{ text }}" hidden>{{ icon("copy", "icon-sm") }}<span data-copy-label>Copy</span></button>
{%- else %}<button class="icon-btn copy" type="button" data-copy="{{ text }}" aria-label="Copy {{ label }}" title="Copy" hidden>{{ icon("copy", "icon-sm") }}</button>{% endif %}
{%- endmacro %}

{#- page_head(title, lede="", status="", back=none, image="", state=none)
    The page's title and one line under it. Every page starts with it.
    lede:   a plain line under the title (the Apps design)
    status: a larger, quieter line saying how things are
    back:   (href, label) for a link above the title, on detail pages
    image:  an image icon key, drawn large before the title (an app)
    state:  (text, tone) for a pill() beside the title ("Live")
    Called with {% call %}, the body goes at the right (list tools, or the
    page's primary button). -#}
{% macro page_head(title, lede="", status="", back=none, image="", state=none) -%}
{% if back %}<a class="back" href="{{ back.0 }}">{{ icon("arrow", "icon-sm back-icon") }}{{ back.1 }}</a>{% endif %}
<div class="page-head">
  <div class="page-id">
    {% if image %}{{ image_icon(image, "lg") }}{% endif %}
    <div>
      <h1 class="page-title">{{ title }}{% if state %} {{ pill(state.0, state.1) }}{% endif %}</h1>
      {% if lede %}<p class="page-lede">{{ lede }}</p>{% endif %}
      {% if status %}{{ status_line(status, plain=true) }}{% endif %}
    </div>
  </div>
  {% if caller is defined %}<div class="page-tools">{{ caller() }}</div>{% endif %}
</div>
{%- endmacro %}

{#- status_line(text, tone="ok", id="", plain=false)
    A sentence about how a thing is, with a toned check, under a page
    head ("All copies are ready."). plain: without the check, for a
    sentence of warning before a form. -#}
{% macro status_line(text, tone="ok", id="", plain=false) -%}
<p class="status-line"{% if id %} id="{{ id }}"{% endif %}>{% if plain %}{{ text }}{% else %}{{ status(text, tone) }}{% endif %}</p>
{%- endmacro %}

{#- section(id, title, count=none, more=none, first=false, stack=false)
    A titled part of a page; the {% call %} body is its content.
    id:    the heading's id, which the section is labelled by (and a
           link target, such as #versions)
    count: a muted number after the title
    more:  (href, label) for an onward link at the right
    first: right under the page head, without the gap above
    stack: its children are spaced by a gap (a block of instructions) -#}
{% macro section(id, title, count=none, more=none, first=false, stack=false) -%}
<section{% if not first or stack %} class="{% if not first %}section{% endif %}{% if stack %} section-stack{% endif %}"{% endif %} aria-labelledby="{{ id }}">
  <div class="section-head">
    <h2 class="section-title" id="{{ id }}">{{ title }}{% if count is not none %}<span class="count">{{ count }}</span>{% endif %}</h2>
    {% if more %}{{ link_more(more.0, more.1) }}{% endif %}
  </div>
  {{ caller() }}
</section>
{%- endmacro %}

{#- panel(id, title, lede="", action=none)
    A titled box holding one part of a page's work, such as a form; the
    {% call %} body is its content. id: the heading's id, which labels
    it (and a link target). What cannot be undone goes in an expander of
    kind "danger" instead.
    action: (href, label) for a secondary button at the right of the
            title ("All releases →") -#}
{% macro panel(id, title, lede="", action=none) -%}
<section class="panel" aria-labelledby="{{ id }}">
  <div class="panel-head">
    <div><h2 class="panel-title" id="{{ id }}">{{ title }}</h2>{% if lede %}<p class="panel-lede">{{ lede }}</p>{% endif %}</div>
    {% if action %}{{ button(action.1, href=action.0, icon_name="arrow", kind="secondary", size="sm", icon_end=true) }}{% endif %}
  </div>
  {{ caller() }}
</section>
{%- endmacro %}

{#- choice_links(label, choices, active)
    A choice between ways of doing a page's work, as large cards that are
    links (so it works without the script), the chosen one marked like a
    selected radio. label: the group's accessible name.
    choices: dicts of key, href, icon, title, text and sub (a quieter
             third line); active: the chosen key -#}
{% macro choice_links(label, choices, active) -%}
<nav class="choices choices-lg" aria-label="{{ label }}">
  {% for choice in choices %}<a class="choice{% if choice.key == active %} is-chosen{% endif %}" href="{{ choice.href }}"{% if choice.key == active %} aria-current="true"{% endif %}>
    <span class="icon-tile" aria-hidden="true">{{ icon(choice.icon) }}</span>
    <span class="choice-text"><span class="choice-title">{{ choice.title }}</span><span class="choice-line">{{ choice.text }}</span>{% if choice.sub | default("") %}<span class="choice-sub">{{ choice.sub }}</span>{% endif %}</span>
    <span class="choice-dot" aria-hidden="true"></span>
  </a>
  {% endfor %}
</nav>
{%- endmacro %}

{#- tabs(label, tabs, active)
    Splits one thing into pages, as links, so they work without the
    script: an organisation's settings, an app's Overview and Settings.
    label: the nav's accessible name
    tabs:  (key, href, text) triples, or (key, href, text, icon_name)
    active: the current key -#}
{% macro tabs(label, tabs, active) -%}
<nav class="tabs" aria-label="{{ label }}">
  {% for tab in tabs %}<a class="tab{% if active == tab[0] %} is-active{% endif %}" href="{{ tab[1] }}"{% if active == tab[0] %} aria-current="page"{% endif %}>{% if tab | length > 3 %}{{ icon(tab[3], "icon-sm") }}{% endif %}{{ tab[2] }}</a>
  {% endfor %}
</nav>
{%- endmacro %}

{#- facts(): a row of fact()s divided by lines, a column below 900 px;
    the {% call %} body is the facts. -#}
{% macro facts() -%}
<dl class="facts">{{ caller() }}</dl>
{%- endmacro %}

{#- fact(label, value="", icon_name="", tone="", lines=[], wide=false)
    One fact: a small label, the value large, and quieter lines under it.
    icon_name: an icon before the value
    tone:      a large dot of that colour before the value instead (a
               state)
    lines:     the lines under the value, the first brighter
    wide:      takes the room the others leave (an address)
    Called with {% call %}, the body replaces the value and its lines. -#}
{% macro fact(label, value="", icon_name="", tone="", lines=[], wide=false) -%}
<div class="fact{% if wide %} fact-wide{% endif %}">
  <dt class="fact-label">{{ label }}</dt>
  {% if caller is defined %}<dd class="fact-body">{{ caller() }}</dd>{% else %}
  <dd class="fact-value">{% if icon_name %}{{ icon(icon_name) }}{% elif tone %}<span class="dot dot-lg tone-{{ tone }}" aria-hidden="true"></span>{% endif %}<span>{{ value }}</span></dd>
  {% for line in lines %}<dd class="fact-line">{{ line }}</dd>{% endfor %}
  {% endif %}
</div>
{%- endmacro %}

{#- endpoint(text, href="")
    Where to reach a thing, large, on one line (cut with an ellipsis, the
    whole in its title and its copy button): a link when href is set (a
    public address, opening in a new tab), else code (an internal name). -#}
{% macro endpoint(text, href="") -%}
<p class="endpoint">{{ icon("link") }}{% if href %}<a class="endpoint-text" href="{{ href }}" title="{{ text }}" rel="noopener noreferrer" target="_blank">{{ text }}<span class="visually-hidden"> (opens in a new tab)</span></a>{% else %}<code class="endpoint-text" title="{{ text }}">{{ text }}</code>{% endif %}{{ copy_button(text, "the address") }}</p>
{%- endmacro %}

{#- dns_records(records, label)
    DNS records for someone to make at their DNS provider, one row each:
    its type, its name and its value, the name and value with copy
    buttons. A table, each row stacked below 900 px.
    records: dicts of type, name and value
    label:   the table's caption, for screen readers -#}
{% macro dns_records(records, label) -%}
<table class="dns-records">
  <caption class="visually-hidden">{{ label }}</caption>
  <thead><tr><th scope="col">Type</th><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
  <tbody>
    {% for record in records %}<tr>
      <td data-label="Type"><code>{{ record.type }}</code></td>
      <td data-label="Name"><span class="dns-cell"><code>{{ record.name }}</code>{{ copy_button(record.name, "the " ~ record.type ~ " record's name") }}</span></td>
      <td data-label="Value"><span class="dns-cell"><code>{{ record.value }}</code>{{ copy_button(record.value, "the " ~ record.type ~ " record's value") }}</span></td>
    </tr>{% endfor %}
  </tbody>
</table>
{%- endmacro %}

{#- callout(title, text, icon_name="", tone="", danger=false, boxed=false,
            action=none)
    Something happening now or needing attention.
    icon_name, tone: a large toned icon
    action: (href, label) for one onward button ("Browse templates →")
    boxed:  the icon in an accent tile, for an offer rather than a state
    danger: on the danger surface, for failures -#}
{% macro callout(title, text, icon_name="", tone="", danger=false, boxed=false, action=none) -%}
<div class="callout{% if danger %} callout-danger{% endif %}">
  {% if icon_name and boxed %}<span class="icon-tile" aria-hidden="true">{{ icon(icon_name) }}</span>{% elif icon_name %}{{ icon(icon_name, "icon-lg tone-" ~ tone) }}{% endif %}
  <div class="callout-body">
    <p class="callout-title">{{ title }}</p>
    <p class="callout-text">{{ text }}</p>
  </div>
  {% if action %}{{ button(action.1, href=action.0, icon_name="arrow", kind="secondary", icon_end=true) }}{% endif %}
</div>
{%- endmacro %}

{#- stats(facts): small print at the foot, (icon_name, text) pairs. -#}
{% macro stats(facts) -%}
<ul class="stats">
  {% for icon_name, text in facts %}<li>{{ icon(icon_name, "icon-sm") }}{{ text }}</li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- empty_state(title="", text="")
    A dashed box: what is missing, and one sentence on how it appears.
    Called with {% call %}, the body replaces text (for a link or code). -#}
{% macro empty_state(title="", text="") -%}
<div class="empty">{% if title %}<strong>{{ title }}</strong>{% endif %}{% if caller is defined %}{{ caller() }}{% else %}{{ text }}{% endif %}</div>
{%- endmacro %}

{#- add_card(href, title, text)
    The dashed card under a list that leads to making one more. -#}
{% macro add_card(href, title, text) -%}
<a class="empty empty-action" href="{{ href }}">
  <span class="icon-btn icon-btn-boxed" aria-hidden="true">{{ icon("plus", "icon-sm") }}</span>
  <strong>{{ title }}</strong>{{ text }}
</a>
{%- endmacro %}

{#- para(text="", kind="hint", hidden=false, filter_empty=false)
    A paragraph of quieter text. Called with {% call %}, the body
    replaces text (for a link or code).
    kind:         hint (small muted print: a caveat, a reference id), note
                  (a line about the list below it), aside (a second way
                  to do it) or auth-lede (under a signed-out page's title)
    hidden:       not shown until the script shows it
    filter_empty: the note the script shows when the search matches
                  nothing -#}
{% macro para(text="", kind="hint", hidden=false, filter_empty=false) -%}
<p class="{{ kind }}"{% if filter_empty %} data-filter-empty{% endif %}{% if hidden %} hidden{% endif %}>{% if caller is defined %}{{ caller() }}{% else %}{{ text }}{% endif %}</p>
{%- endmacro %}

{#- code(text, filename="", download="", id="", copy=true, wrap=false,
         what="the text")
    Text a person copies or saves, in the mono face, in a frame: a file
    (grund.yaml), a command, a token, a licence.
    filename: a head with the file's name, a Copy button and, with
              download (the file's URL), a Download link that saves it
              under that name; without one, the copy button sits in the
              corner
    copy:     false for text too long to copy usefully (a licence)
    wrap:     long lines wrap anywhere (a command, a token) instead of
              scrolling sideways (a file keeps its lines)
    what:     what the corner button copies, for its name ("the command") -#}
{% macro code(text, filename="", download="", id="", copy=true, wrap=false, what="the text") -%}
<div class="code{% if wrap %} code-wrap{% endif %}{% if copy and not filename %} code-corner{% endif %}"{% if id %} id="{{ id }}"{% endif %}>
  {% if filename %}<div class="code-head"><span class="code-name">{{ icon("file", "icon-sm") }}{{ filename }}</span><span class="code-tools">{% if copy %}{{ copy_button(text, filename, labelled=true) }}{% endif %}{% if download %}{{ button("Download", href=download, icon_name="download", kind="secondary", size="sm", download=filename) }}{% endif %}</span></div>
  {%- endif %}
  <pre class="code-body mono">{{ text }}</pre>
  {%- if copy and not filename %}{{ copy_button(text, what) }}{% endif %}
</div>
{%- endmacro %}

{#- expanders(): a box of expander()s, divided by lines; the {% call %}
    body is the expanders. -#}
{% macro expanders() -%}
<div class="expanders">{{ caller() }}</div>
{%- endmacro %}

{#- expander(title, summary="", icon_name="", tone="", state=none,
             meta=[], open=false, kind="", id="")
    One thing in one line that opens to show more, as a details element,
    so it opens without the script: a setting (its value in the summary,
    its form inside), a release (its outcome, its details inside), a
    form's optional part. The {% call %} body is what it opens to.
    summary: one line, cut with an ellipsis when it does not fit
    icon_name, tone: an icon before the title, toned
    state:   (text, tone) for a pill() after the title ("Live")
    meta:    short facts at the right ("2 hours ago"), hidden on a phone
    open:    open (the one a refused form is in, or a link's target)
    kind:    "add" (a thing not set yet: "Add a health check", in the
             accent with a plus) or "danger" (delete)
    id:      a link target; it must not be a field's name -#}
{% macro expander(title, summary="", icon_name="", tone="", state=none, meta=[], open=false, kind="", id="") -%}
<details class="expander{% if kind %} expander-{{ kind }}{% endif %}"{% if id %} id="{{ id }}"{% endif %}{% if open %} open{% endif %}>
  <summary class="expander-head">
    {% if kind == "add" %}{{ icon("plus", "icon-sm expander-icon") }}{% elif icon_name %}{{ icon(icon_name, "icon-sm expander-icon" ~ (" tone-" ~ tone if tone else "")) }}{% endif %}
    <span class="expander-text"><span class="expander-title">{{ title }}{% if state %} {{ pill(state.0, state.1) }}{% endif %}</span>{% if summary %}<span class="expander-summary">{{ summary }}</span>{% endif %}</span>
    {% if meta %}<span class="expander-meta">{% for fact in meta %}<span>{{ fact }}</span>{% endfor %}</span>{% endif %}
    {{ icon("down", "icon-sm expander-chevron") }}
  </summary>
  <div class="expander-body">{{ caller() }}</div>
</details>
{%- endmacro %}

{#- auth_head(title, lede="")
    A signed-out page's title and the line under it. -#}
{% macro auth_head(title, lede="") -%}
<h1 class="auth-title">{{ title }}</h1>
{% if lede %}{{ para(lede, "auth-lede") }}{% endif %}
{%- endmacro %}

{#- foot(): the small print under a form (secondary links); the
    {% call %} body is <p>s. -#}
{% macro foot() -%}
<div class="form-foot">{{ caller() }}</div>
{%- endmacro %}
