use crate::templates::compiled::components::{EmptyState, Tag, Actions, Button, Para, PostButton, Icon};

component TelemetryBar(bar: &crate::web::app_telemetry::Toolbar) {
  <form class="telemetry-bar" method="get" action={&bar.action} data-telemetry-bar>
    {if !bar.range.is_empty() { <input type="hidden" name="range" value={bar.range}> }}
    {if let Some(zoom) = &bar.zoom { <input type="hidden" name="since" value={&zoom.since}><input type="hidden" name="until" value={&zoom.until}> }}
    {if let Some(search) = &bar.search {
      <div class="search telemetry-search">
        <label class="visually-hidden" for="app-log-search">Search output</label>
        <Icon name="search" class="icon-sm search-icon" />
        <input id="app-log-search" name="search" type="search" placeholder="Search output…" autocomplete="off" maxlength="200" value={search}>
      </div>
    }}
    <nav class="segmented" aria-label="Time range">
      {for link in &bar.ranges { <a class={if link.live { "segment segment-live" } else { "segment" }} href={&link.href} aria-current={if link.current { Some("true") } else { None }}>{link.label}</a> }}
    </nav>
    {if !bar.instances.is_empty() {
      <label class="visually-hidden" for="telemetry-instance">Instance</label>
      <span class="select-wrap"><select class="control select" id="telemetry-instance" name="instance" data-autosubmit>{for (value, label) in &bar.instances { <option value={value} selected={bar.instance == *value}>{label}</option> }}</select><Icon name="down" class="icon-sm select-chevron" /></span>
    }}
    {if let Some(zoom) = &bar.zoom { <span class="telemetry-zoom">{zoom.label} UTC<a class="telemetry-unzoom" href={&zoom.reset} aria-label="Show the whole range">×</a></span> }}
    <span class="telemetry-status" role="status" data-telemetry-status></span>
    <button class="btn btn-secondary btn-sm js-hide" type="submit"><span>Apply</span></button>
  </form>
}

component ChartCard(id: &str, title: &str, children: Html) {
  <section class="chart-card" aria-labelledby="chart-{id}">
    <header class="chart-head">
      <h2 class="chart-name" id="chart-{id}">{title}</h2>
      <ul class="chart-keys" aria-label="Series" data-chart-keys></ul>
      <p class="chart-now" data-chart-now></p>
    </header>
    <div class="chart-canvas" data-chart={id}>{children}</div>
  </section>
}

component TimeSeries(chart: &crate::web::app_telemetry::TimeSeriesChart) {
  <figure class="chart">
    <figcaption class="chart-title">{chart.title}</figcaption>
    <p class="hint">{chart.summary}</p>
    <div class="chart-scale"><span>{chart.ceiling} {chart.unit}</span><span>0 {chart.unit} baseline</span></div>
    <svg class="chart-plot" viewBox="0 0 640 210" preserveAspectRatio="none" role="img" aria-label="{chart.title}: {chart.summary}">
      <path class="chart-axis" d="M 48 20 V 180 H 604" fill="none" />
      <path class="chart-grid" d="M 48 20 H 604 M 48 100 H 604" fill="none" />
      {for gap in &chart.gaps {
        <rect class={if gap.offline { "chart-offline" } else { "chart-unknown" }} x={gap.x} y="20" width={gap.width} height="160"><title>{gap.label}</title></rect>
      }}
      {for series in &chart.series {
        <g class="chart-series chart-{series.kind}">
          <path d={&series.path} fill="none" stroke-width="2" vector-effect="non-scaling-stroke" />
          {for dot in &series.dots { <circle cx={dot.x} cy={dot.y} r="2.5"><title>{dot.label}</title></circle> }}
        </g>
      }}
    </svg>
    <div class="chart-times"><span>{chart.start}</span><span>{chart.end}</span></div>
    <ul class="chart-legend" aria-label="Series">{for series in &chart.series { <li class="chart-key chart-{series.kind}"><span aria-hidden="true"></span>{series.label}</li> }}</ul>
    {if !chart.gaps.is_empty() {
      {if chart.gaps.iter().any(|gap| gap.offline) { <Para>not received (machine offline). The machine was disconnected from the instance; the app may still have been running. Received measurement coverage is excluded.</Para> }}
      {if chart.gaps.iter().any(|gap| !gap.offline) { <Para>Coverage unknown: received history was evicted. Earlier missing coverage cannot be attributed to offline delivery.</Para> }}
      <ul class="hint">{for gap in &chart.gaps { <li>{gap.label}</li> }}</ul>
    }}
  </figure>
}

component LogRow(line: &crate::web::app_telemetry::LogLine, instance: bool) {
  <div class={if line.stream == "stderr" { "log-line log-err" } else { "log-line" }} data-cursor={&line.cursor}>
    <time class="log-time" datetime={&line.iso} title={&line.title}>{line.clock}<span class="log-ms">{line.millis}</span></time>
    {if *instance { <span class="log-instance" title={&line.instance}>{line.short}</span> }}
    <pre class="log-body">{for span in &line.spans { <span class={&span.class}>{span.text}</span> }}{if line.truncated { <Tag text="Truncated" /> }}</pre>
  </div>
}

component LogStream(lines: &[crate::web::app_telemetry::LogLine], instance: bool, older: &str) {
  <section class="log-stream" aria-label="Output">
    <div class="log-lines" role="log" tabindex="0" data-log-lines>
      {if !older.is_empty() { <a class="log-older js-hide" href={older}>Older lines</a> }}
      {for line in lines.iter() { <LogRow line={line} instance={*instance} /> }}
      <p class="log-empty" data-log-empty hidden={!lines.is_empty()}>No output in this range.</p>
    </div>
    <button class="log-resume" type="button" data-log-resume hidden>Resume</button>
  </section>
}
