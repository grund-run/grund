{#- ------------------------------------------------------------------
    Forms: the form itself, its fields, its banner, its actions and
    one-button forms.

    One shape for every field: the label (and "Optional" when it may be
    left empty), the control, then one line under it: the hint, or the
    error in its place (aria-invalid, aria-describedby). A refused form
    says so once, in a banner above its fields, and marks the field.
    Fields stack in a column, or sit side by side in grid(); a short value
    (a port, a number) takes width="sm" so its box fits what it holds.
    A form ends in actions(): the note on the left says what saving does
    ("Makes a new release"), the buttons are on the right, the primary
    last. A form of one field and its button (add a domain, make a token)
    is layout="row". Every form that changes something posts with the
    CSRF field, and the handler checks it.
    ------------------------------------------------------------------ -#}
{% import "components/ui.html.jinja" as ui %}

{#- form(action, csrf, layout="stack", method="post", autocomplete="")
    The {% call %} body is the fields and the actions.
    layout:       stack (a column), row (the fields side by side and the
                  button after them, wrapping on a phone) or "" (no
                  layout, for a sentence and one button)
    csrf:         the token; none for a GET form
    autocomplete: "off" for a form whose values the browser must not
                  remember -#}
{% macro form(action, csrf, layout="stack", method="post", autocomplete="") -%}
<form{% if layout %} class="form{% if layout == 'row' %} form-row{% endif %}"{% endif %} method="{{ method }}" action="{{ action }}" novalidate{% if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}>
  {% if csrf %}{{ csrf_field(csrf) }}{% endif %}
  {{ caller() }}
</form>
{%- endmacro %}

{#- post_button(action, csrf, label, kind="secondary", size="",
                block=false, layout="", hidden={})
    A form that is only a button: remove, stop, sign out, run again.
    Destructive ones are kind="danger" and say what they do.
    layout: as for form() ("stack" on a signed-out page, for its gap);
    hidden: more fields it sends, name: value -#}
{% macro post_button(action, csrf, label, kind="secondary", size="", block=false, layout="", hidden={}) -%}
{% call form(action, csrf, layout=layout) %}
  {% for name, value in hidden | items %}{{ hidden_field(name, value) }}{% endfor %}
  {{ ui.button(label, kind=kind, size=size, block=block) }}
{% endcall %}
{%- endmacro %}

{#- csrf_field(token): the hidden CSRF field. -#}
{% macro csrf_field(token) -%}
<input type="hidden" name="csrf" value="{{ token }}">
{%- endmacro %}

{#- hidden_field(name, value): a value the form carries unseen. -#}
{% macro hidden_field(name, value) -%}
<input type="hidden" name="{{ name }}" value="{{ value }}">
{%- endmacro %}

{#- describe(id, error, hint): the attributes tying a control to its
    error or hint. -#}
{% macro describe(id, error, hint) -%}
{% if error %} aria-invalid="true" aria-describedby="{{ id }}-error"{% elif hint %} aria-describedby="{{ id }}-hint"{% endif %}
{%- endmacro %}

{#- message(id, error, hint): the error, else the hint, under a control. -#}
{% macro message(id, error, hint) -%}
{%- if error %}
  <p class="field-error" id="{{ id }}-error">{{ ui.icon("alert", "icon-sm") }}<span>{{ error }}</span></p>
{%- elif hint %}
  <p class="hint" id="{{ id }}-hint">{{ hint }}</p>
{%- endif %}
{%- endmacro %}

{#- label_of(id, text, optional=false): a field's label; optional adds a
    quiet "Optional". -#}
{% macro label_of(id, text, optional=false) -%}
<label class="field-label" for="{{ id }}">{{ text }}{% if optional %} <span class="field-optional">Optional</span>{% endif %}</label>
{%- endmacro %}

{#- field(name, label, type="text", value="", autocomplete="", error="",
          hint="", required=true, autofocus=false, disabled=false, id="",
          state="", width="", placeholder="", mono=false)
    A labelled input.
    error:    replaces the hint and marks the input invalid
    required: false marks the label Optional
    disabled: shown, not editable and not sent (a known value)
    id:       defaults to name
    state:    "focus" pins the focus look (the style guide only)
    width:    "sm" (a port, a number) or "md" (a name); "" fills its column
    mono:     the value in the mono face (a variable, a path) -#}
{% macro field(name, label, type="text", value="", autocomplete="", error="", hint="", required=true, autofocus=false, disabled=false, id="", state="", width="", placeholder="", mono=false) -%}
{% set id = id or name %}
<div class="field{% if width %} field-{{ width }}{% endif %}">
  {{ label_of(id, label, not required and not disabled) }}
  <input class="control{% if mono %} mono{% endif %}{% if state %} is-{{ state }}{% endif %}" id="{{ id }}" name="{{ name }}" type="{{ type }}"{% if value %} value="{{ value }}"{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}{% if required and not disabled %} required{% endif %}{% if autofocus %} autofocus{% endif %}{% if disabled %} disabled{% endif %}{% if type == "number" %} inputmode="numeric"{% endif %}{{ describe(id, error, hint) }}>
  {{- message(id, error, hint) }}
</div>
{%- endmacro %}

{#- select_field(name, label, options, selected="", hint="", error="",
                 id="", state="", width="")
    A labelled select. options: (value, label) pairs. state, width: as
    for field(). -#}
{% macro select_field(name, label, options, selected="", hint="", error="", id="", state="", width="") -%}
{% set id = id or name %}
<div class="field{% if width %} field-{{ width }}{% endif %}">
  {{ label_of(id, label) }}
  {{ select(name, id, options, selected, state=state, describe_by=describe(id, error, hint)) }}
  {{- message(id, error, hint) }}
</div>
{%- endmacro %}

{#- select(name, id, options, selected, state="", describe_by="",
           autosubmit=false)
    The select control alone, with its chevron. autosubmit: the script
    submits its form on change (a sort, a member's role). -#}
{% macro select(name, id, options, selected, state="", describe_by="", autosubmit=false) -%}
<span class="select-wrap">
  <select class="control select{% if state %} is-{{ state }}{% endif %}" id="{{ id }}" name="{{ name }}"{% if autosubmit %} data-autosubmit{% endif %}{{ describe_by }}>
    {{ options_of(options, selected) }}
  </select>
  {{ ui.icon("down", "icon-sm select-chevron") }}
</span>
{%- endmacro %}

{#- options_of(options, selected): a select's (value, label) options. -#}
{% macro options_of(options, selected) -%}
{% for value, text in options %}<option value="{{ value }}"{% if value == selected %} selected{% endif %}>{{ text }}</option>{% endfor %}
{%- endmacro %}

{#- textarea_field(name, label, value="", rows=4, hint="", error="")
    A labelled box for several lines of prose. -#}
{% macro textarea_field(name, label, value="", rows=4, hint="", error="") -%}
<div class="field">
  {{ label_of(name, label) }}
  <textarea class="control" id="{{ name }}" name="{{ name }}" rows="{{ rows }}"{{ describe(name, error, hint) }}>{{ value }}</textarea>
  {{- message(name, error, hint) }}
</div>
{%- endmacro %}

{#- code_field(name, label, value="", filename="", rows=6, hint="",
               error="", required=false, download="")
    Lines a machine reads, edited as code: a file (grund.toml), a
    command one argument per line. In the mono face, in the same frame
    as ui.code() with the filename in its head, unchecked for spelling.
    download: the saved file's URL; the head then offers Copy (what was
              saved) and Download, as ui.code() does -#}
{% macro code_field(name, label, value="", filename="", rows=6, hint="", error="", required=false, download="") -%}
<div class="field">
  {{ label_of(name, label, not required) }}
  <div class="code{% if error %} is-invalid{% endif %}">
    {% if filename %}<div class="code-head"><span class="code-name">{{ ui.icon("file", "icon-sm") }}{{ filename }}</span>{% if download %}<span class="code-tools">{{ ui.copy_button(value, filename, labelled=true) }}{{ ui.button("Download", href=download, icon_name="download", kind="secondary", size="sm", download=filename) }}</span>{% endif %}</div>{% endif %}
    <textarea class="code-input mono" id="{{ name }}" name="{{ name }}" rows="{{ rows }}" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off"{{ describe(name, error, hint) }}>{{ value }}</textarea>
  </div>
  {{- message(name, error, hint) }}
</div>
{%- endmacro %}

{#- pairs_field(name, label, pairs=[], hint="", error="", secret=false,
                blank=2, key_label="Name", value_label="Value")
    Name and value rows (environment variables, secrets): a row for each
    pair and blank rows to add more; a row left empty is dropped. The
    rows post as <name>_key and <name>_value, in order. With the script,
    "Add another" adds a row and each row can be removed.
    pairs:  (name, value) pairs; secret: the values are passwords, never
            written back
    blank:  how many empty rows follow the pairs -#}
{% macro pairs_field(name, label, pairs=[], hint="", error="", secret=false, blank=2, key_label="Name", value_label="Value") -%}
<fieldset class="field"{% if error %} aria-describedby="{{ name }}-error"{% elif hint %} aria-describedby="{{ name }}-hint"{% endif %}>
  <legend class="field-label">{{ label }} <span class="field-optional">Optional</span></legend>
  <div class="pairs" data-pairs>
    {% for key, value in pairs + [("", "")] * blank %}<div class="pair">
      <input class="control mono" name="{{ name }}_key" value="{{ key }}" placeholder="NAME" aria-label="{{ key_label }} {{ loop.index }}" autocomplete="off" spellcheck="false"{% if error %} aria-invalid="true"{% endif %}>
      <input class="control mono" name="{{ name }}_value"{% if secret %} type="password" autocomplete="new-password"{% else %} value="{{ value }}" autocomplete="off"{% endif %} placeholder="{{ 'value, stored sealed' if secret else 'value' }}" aria-label="{{ value_label }} {{ loop.index }}" spellcheck="false">
      <button class="icon-btn" type="button" data-remove-pair aria-label="Remove row {{ loop.index }}" hidden>{{ ui.icon("trash", "icon-sm") }}</button>
    </div>
    {% endfor %}
  </div>
  {{ ui.button("Add another", icon_name="plus", kind="ghost", size="sm", type="button", extra="pairs-add", hidden=true) }}
  {{- message(name, error, hint) }}
</fieldset>
{%- endmacro %}

{#- toggle_field(name, label, checked=false, hint="", state="")
    One yes or no, as a switch: a checkbox, so it works without the
    script. It sends name=on when on and nothing when off.
    state: "focus" pins the focus look (the style guide only) -#}
{% macro toggle_field(name, label, checked=false, hint="", state="") -%}
<label class="toggle{% if state %} is-{{ state }}{% endif %}">
  <input class="toggle-input" type="checkbox" role="switch" id="{{ name }}" name="{{ name }}" value="on"{% if checked %} checked{% endif %}{% if hint %} aria-describedby="{{ name }}-hint"{% endif %}>
  <span class="toggle-track" aria-hidden="true"></span>
  <span class="toggle-text"><span class="field-label">{{ label }}</span>{% if hint %}<span class="hint" id="{{ name }}-hint">{{ hint }}</span>{% endif %}</span>
</label>
{%- endmacro %}

{#- grid(): fields in two columns, one below 900 px; the {% call %} body
    is fields, or another grid() to split a column in two. -#}
{% macro grid() -%}
<div class="form-grid">{{ caller() }}</div>
{%- endmacro %}

{#- choice_field(name, label, options, selected="", error="", hint="",
                 large=false, fill="")
    A labelled choice of one, as cards: radio buttons, so it works without
    the script.
    options: dicts of value, title, text, and icon (a sprite icon) or
             image (an image icon key, with its sprite on the page);
             disabled and tag ("Needs storage") for one not offered yet;
             state pins "hover" or "focus" (the style guide only)
    large:   wider cards, for a choice that is the form's subject
    fill:    the id of a field that takes the chosen value while it is
             empty or still holds the last one (the script) -#}
{% macro choice_field(name, label, options, selected="", error="", hint="", large=false, fill="") -%}
<fieldset class="field"{% if error %} aria-describedby="{{ name }}-error"{% elif hint %} aria-describedby="{{ name }}-hint"{% endif %}>
  <legend class="field-label">{{ label }}</legend>
  <div class="choices{% if large %} choices-wide{% endif %}">
    {% for option in options %}{% set disabled = option.disabled | default(false) %}<label class="choice{% if disabled %} is-disabled{% endif %}{% if option.state | default("") %} is-{{ option.state }}{% endif %}">
      <input class="choice-input" type="radio" name="{{ name }}" value="{{ option.value }}"{% if option.value == selected %} checked{% endif %}{% if disabled %} disabled{% endif %}{% if fill %} data-fill="{{ fill }}"{% endif %}>
      {% if option.image | default("") %}{{ ui.image_icon(option.image) }}{% elif option.icon | default("") %}{{ ui.icon(option.icon, "choice-icon") }}{% endif %}
      <span class="choice-text"><span class="choice-title">{{ option.title }}{% if option.tag | default("") %} {{ ui.tag(option.tag) }}{% endif %}</span>{% if option.text | default("") %}<span class="choice-sub">{{ option.text }}</span>{% endif %}</span>
    </label>
    {% endfor %}
  </div>
  {{- message(name, error, hint) }}
</fieldset>
{%- endmacro %}

{#- stepper_field(name, label, value, min=1, max=99, hint="", error="")
    A labelled whole number with − and + beside it. The buttons show only
    with the script; without it the number is typed. -#}
{% macro stepper_field(name, label, value, min=1, max=99, hint="", error="") -%}
<div class="field field-sm">
  {{ label_of(name, label) }}
  <div class="stepper">
    <button class="stepper-btn" type="button" data-step="-1" data-for="{{ name }}" aria-label="One fewer" hidden>{{ ui.icon("minus", "icon-sm") }}</button>
    <input class="control" id="{{ name }}" name="{{ name }}" type="number" inputmode="numeric" min="{{ min }}" max="{{ max }}" value="{{ value }}"{{ describe(name, error, hint) }}>
    <button class="stepper-btn" type="button" data-step="1" data-for="{{ name }}" aria-label="One more" hidden>{{ ui.icon("plus", "icon-sm") }}</button>
  </div>
  {{- message(name, error, hint) }}
</div>
{%- endmacro %}

{#- actions(note="", note_icon="")
    A form's end: what saving does on the left (note, with an icon such
    as "layers" for "Makes a new release"), the buttons on the right, the
    primary last. The {% call %} body is the buttons. On a phone the
    note goes above the buttons. -#}
{% macro actions(note="", note_icon="") -%}
<div class="form-actions">{% if note %}<p class="form-note">{% if note_icon %}{{ ui.icon(note_icon, "icon-sm") }}{% endif %}<span>{{ note }}</span></p>{% endif %}{{ caller() }}</div>
{%- endmacro %}

{#- select_form(action, csrf, name, id, label, options, selected, button)
    A select posting one choice (a member's role): it applies on change
    with the script, and with a small button without it. label: the
    select's accessible name (not shown). -#}
{% macro select_form(action, csrf, name, id, label, options, selected, button) -%}
<form class="row-form" method="post" action="{{ action }}">
  {{ csrf_field(csrf) }}
  <label class="visually-hidden" for="{{ id }}">{{ label }}</label>
  {{ select(name, id, options, selected, autosubmit=true) }}
  {{ ui.button(button, kind="secondary", size="sm", extra="js-hide") }}
</form>
{%- endmacro %}

{#- banner(error="", ok="", fields=[])
    A form's or a page's banner: ok says it worked, error what went
    wrong, each only when it is not empty (ok first). A page passes the
    notice and error its handler gives it: banner(error, ok=notice).
    fields: the form's field errors; when one is set and error is empty,
            the banner says nothing was saved and to look below, so a
            refused form always says so at its top -#}
{% macro banner(error="", ok="", fields=[]) -%}
{% set error = error or ("Nothing was saved. Check the field marked below." if fields | select | list else "") %}
{% if ok %}<div class="form-ok" role="status">{{ ui.icon("ok", "icon-sm") }}<span>{{ ok }}</span></div>{% endif %}
{%- if error %}<div class="form-error" role="alert">{{ ui.icon("alert", "icon-sm") }}<span>{{ error }}</span></div>{% endif %}
{%- endmacro %}

{#- field_error(text): an error on its own line, outside a field. -#}
{% macro field_error(text) -%}
<span class="field-error">{{ text }}</span>
{%- endmacro %}

{#- or_divider(): the "or" line between a form and the other ways in. -#}
{% macro or_divider() -%}
<p class="or">or</p>
{%- endmacro %}

{#- providers(providers)
    The other ways to sign in, one full-width button each.
    providers: (id, name, icon) for each -#}
{% macro providers(providers) -%}
<div class="providers">
  {% for provider in providers %}
  {{ ui.button("Continue with " ~ provider.name, href="/auth/" ~ provider.id ~ "/start", icon_name=provider.icon, kind="secondary", block=true, icon_size="") }}
  {% endfor %}
</div>
{%- endmacro %}
