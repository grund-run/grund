{#- ------------------------------------------------------------------
    Lists of things. Two shapes:
    - rows(): an open list of resources divided by lines, no box (copies,
      versions, machines, members, sessions);
    - items(): one bordered box of rows, or a grid of cards, for the
      things a page is about (apps). A new kind gets its own *_row macro
      on the same classes, as app_row does.
    Menus (the kebab) and the sort and view tools live here too.
    ------------------------------------------------------------------ -#}
{% import "components/ui.html.jinja" as ui %}
{% import "components/forms.html.jinja" as forms %}

{#- rows(): the open list; the {% call %} body is row()s. -#}
{% macro rows() -%}
<ul class="rows">{{ caller() }}</ul>
{%- endmacro %}

{#- row(name, sub="", icon_name="", tone="ok", letter="", href="",
        tags=[], detail="", status=none, status_tone="ok", plain=false)
    One resource: an icon, its name over a mono sub-line, how it is, and
    an action at the end.
    icon_name, tone: a large toned icon; letter: a round letter instead
                     (people)
    href:   the name links there
    tags:   tags after the name ("You", "Runs VMs")
    detail: a second sub-line (why a version failed)
    status: status(status, status_tone) in the third column
    plain:  no icon and no status: a name over a value, and the end
    Called with {% call(slot) %}, the body is asked for slot "end" (the
    last column: a post_button, a link, a hint) and, when status is none,
    for slot "status" (a control in place of the status, such as a
    select_form). An empty slot leaves its column empty. -#}
{% macro row(name, sub="", icon_name="", tone="ok", letter="", href="", tags=[], detail="", status=none, status_tone="ok", plain=false) -%}
<li class="row{% if plain %} row-plain{% endif %}">
  {% if not plain %}<span class="row-icon">{% if letter %}{{ ui.mark(letter, "lg") }}{% else %}{{ ui.icon(icon_name, "icon-lg tone-" ~ tone) }}{% endif %}</span>{% endif %}
  <div><p class="row-name">{% if href %}<a href="{{ href }}">{{ name }}</a>{% else %}{{ name }}{% endif %}{% for text in tags %} <span class="tag">{{ text }}</span>{% endfor %}</p><p class="row-sub">{{ sub }}{% if detail %}<br>{{ detail }}{% endif %}</p></div>
  {% if not plain %}{% if status is not none %}{{ ui.status(status, status_tone) }}{% else %}{% set slot = caller("status") if caller is defined else "" %}{% if slot | trim %}{{ slot }}{% else %}<span></span>{% endif %}{% endif %}{% endif %}
  {% set end = caller("end") if caller is defined else "" %}{% if end | trim %}<div class="row-end">{{ end }}</div>{% else %}<span></span>{% endif %}
</li>
{%- endmacro %}

{#- items(view="list"): the box of rows (list) or the grid of cards around
    app_row()s; the {% call %} body is the rows. The script's search
    filters it. -#}
{% macro items(view="list") -%}
<ul class="items items-{{ view }}" data-filterable>{{ caller() }}</ul>
{%- endmacro %}

{#- app_address(app)
    app.address: its public name, shown as an https link opening in a new
    tab; else app.internal (<app>.grund.internal:<port>) with a copy
    button; else nothing. -#}
{% macro app_address(app) -%}
{% if app.address %}{{ ui.external("https://" ~ app.address, "https://" ~ app.address) }}
{%- elif app.internal %}<span class="address"><code class="address-text">{{ app.internal }}</code>{{ ui.copy_button(app.internal, app.internal) }}</span>
{%- endif %}
{%- endmacro %}

{#- app_row(org, app)
    One app in a list (or, inside .items-grid, a card): its image icon,
    its name over its image, its address and its menu.
    org: the current organisation (slug, manages)
    app: web::apps::listing_context (name, image, icon, address, internal) -#}
{% macro app_row(org, app) -%}
{% set base = "/" ~ org.slug ~ "/apps/" ~ app.name %}
<li class="item" data-name="{{ app.name }}" data-image="{{ app.image }}">
  {{ ui.image_icon(app.icon) }}
  <div class="item-text">
    <a class="item-name" href="{{ base }}">{{ app.name }}</a>
    <p class="item-sub"{% if app.image %} title="{{ app.image }}"{% endif %}>{{ (app.image | short_image) if app.image else "No version yet" }}</p>
  </div>
  <div class="item-meta">{{ app_address(app) }}</div>
  {{ app_menu(org, app) }}
</li>
{%- endmacro %}

{#- app_menu(org, app)
    An app's kebab: open it, its pages, and for owners and admins Update
    image, Scale and Delete. org, app: as for app_row. -#}
{% macro app_menu(org, app) -%}
{% set base = "/" ~ org.slug ~ "/apps/" ~ app.name %}
{% call menu("Actions for " ~ app.name) %}
  {% if app.address %}{{ menu_item("https://" ~ app.address, "external", "Open", external=true) }}{% endif %}
  {{ menu_item(base, "home", "Overview") }}
  {{ menu_item(base ~ "/deployments", "layers", "Deployments") }}
  {% if org.manages %}
  {{ menu_item(base ~ "/settings?edit=image", "layers", "Update image") }}
  {{ menu_item(base ~ "/settings?edit=copies", "bars", "Scale") }}
  {{ menu_item(base ~ "/settings?edit=delete", "trash", "Delete…", danger=true) }}
  {% endif %}
{% endcall %}
{%- endmacro %}

{#- template_row(template, href="")
    One premade app in a list or grid: its image icon, its title over
    what it is, and a Deploy button, or a tag when it is not offered yet.
    template: web::apps::template_context (key, title, summary, icon,
              soon); href: where Deploy leads (none: no button) -#}
{% macro template_row(template, href="") -%}
<li class="item" data-name="{{ template.key }}">
  {{ ui.image_icon(template.icon) }}
  <div class="item-text">
    <p class="item-name">{{ template.title }}</p>
    <p class="item-sub item-sub-wrap">{{ template.summary }}</p>
  </div>
  <div class="item-meta">{% if template.soon %}{{ ui.tag(template.soon) }}{% elif href %}{{ ui.button("Deploy", href=href, kind="secondary", size="sm") }}{% endif %}</div>
  <span></span>
</li>
{%- endmacro %}

{#- links(): a box of link()s divided by lines; the {% call %} body is
    the links. -#}
{% macro links() -%}
<ul class="links">{{ caller() }}</ul>
{%- endmacro %}

{#- link(href, title, value="", icon_name="", action="", danger=false,
         state="")
    One thing that opens on a page of its own, the whole line a link: an
    icon, its name, its value on one line (cut with an ellipsis), an
    action word and a chevron. An app's setting; Delete. On a phone the
    value goes under the name and the action word is left out.
    action: a word before the chevron ("Edit")
    danger: in the danger colour
    state:  "hover" or "focus" pins that look (the style guide only) -#}
{% macro link(href, title, value="", icon_name="", action="", danger=false, state="") -%}
<li><a class="link{% if danger %} link-danger{% endif %}{% if state %} is-{{ state }}{% endif %}" href="{{ href }}">
  {%- if icon_name %}{{ ui.icon(icon_name, "link-icon") }}{% endif %}<span class="link-title">{{ title }}</span><span class="link-value">{{ value }}</span>
  {%- if action %}<span class="link-action">{{ action }}</span>{% endif %}{{ ui.icon("chevron", "icon-sm link-chevron") }}</a></li>
{%- endmacro %}

{#- tiles(): a grid of tile()s, three across, one on a phone. -#}
{% macro tiles() -%}
<ul class="tiles">{{ caller() }}</ul>
{%- endmacro %}

{#- tile(href, title, state=""): something to add, as a link with a plus.
    state: "hover" or "focus" pins that look (the style guide only) -#}
{% macro tile(href, title, state="") -%}
<li><a class="tile{% if state %} is-{{ state }}{% endif %}" href="{{ href }}"><span class="tile-plus" aria-hidden="true">{{ ui.icon("plus", "icon-sm") }}</span>{{ title }}</a></li>
{%- endmacro %}

{#- timeline(): what happened, newest first, as event()s on a line. -#}
{% macro timeline() -%}
<ol class="timeline">{{ caller() }}</ol>
{%- endmacro %}

{#- event(title, when="", at="", iso="", meta="", state="")
    One thing that happened, on the timeline: a marker, a title over the
    {% call %} body (who and how, with <strong> for a name), and at the
    right when it was and one more fact (a version).
    when:  how long ago ("2 hours ago"); at: the exact time, as its title;
           iso: the same as an ISO 8601 datetime
    state: the marker. "ok" a check (what runs now), "failed" an alert,
           "busy" a ring in blue (rolling out), "" a quiet ring -#}
{% macro event(title, when="", at="", iso="", meta="", state="") -%}
<li class="event{% if state %} event-{{ state }}{% endif %}">
  <span class="event-mark" aria-hidden="true">{% if state == "ok" %}{{ ui.icon("ok", "icon-sm") }}{% elif state == "failed" %}{{ ui.icon("alert", "icon-sm") }}{% endif %}</span>
  <div class="event-text"><p class="event-title">{{ title }}</p><p class="event-sub">{{ caller() }}</p></div>
  <p class="event-meta">{% if when %}<time datetime="{{ iso }}" title="{{ at }}">{{ when }}</time>{% endif %}{% if meta %}<span>{{ meta }}</span>{% endif %}</p>
</li>
{%- endmacro %}

{#- menu(label, icon_name="more", open=false)
    A kebab (or other icon) button opening a list, as a <details>, so it
    opens without script; the script closes it on Escape or a click
    elsewhere. label: the button's accessible name; open: shown open (the
    style guide). The {% call %} body is menu_item()s. -#}
{% macro menu(label, icon_name="more", open=false) -%}
<details class="menu"{% if open %} open{% endif %}>
  <summary class="icon-btn icon-btn-boxed" aria-label="{{ label }}">{{ ui.icon(icon_name, "icon-sm") }}</summary>
  <ul class="menu-list">{{ caller() }}</ul>
</details>
{%- endmacro %}

{#- menu_item(href, icon_name, label, danger=false, external=false,
              state="")
    One entry of a menu. A destructive one is danger and ends in "…"
    when it leads to a confirmation; external opens in a new tab.
    state: "hover" pins the hover look (the style guide only). -#}
{% macro menu_item(href, icon_name, label, danger=false, external=false, state="") -%}
<li><a class="menu-item{% if danger %} menu-item-danger{% endif %}{% if state %} is-{{ state }}{% endif %}" href="{{ href }}"{% if external %} rel="noopener noreferrer" target="_blank"{% endif %}>{{ ui.icon(icon_name, "icon-sm") }}{{ label }}</a></li>
{%- endmacro %}

{#- list_tools(sorts, sort, list_href, grid_href, view, hidden={})
    Sort and the grid/list toggle above a list.
    sorts:     (value, label) pairs; sort: the chosen value
    list_href, grid_href: the same page in either view; view: the current
    hidden:    other query values the sort form keeps (q, view)
    Sort is a GET form; the script submits it on change and hides its
    button. -#}
{% macro list_tools(sorts, sort, list_href, grid_href, view, hidden={}) -%}
<div class="list-tools">
  <form class="sort" method="get">
    {% for name, value in hidden | items %}{% if value %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endif %}{% endfor %}
    <label for="sort">Sort by</label>
    {{ forms.select("sort", "sort", sorts, sort, autosubmit=true) }}
    {{ ui.button("Sort", kind="secondary", size="sm", extra="js-hide") }}
  </form>
  <div class="view-toggle" role="group" aria-label="View">
    <a class="icon-btn{% if view == 'grid' %} is-active{% endif %}" href="{{ grid_href }}" aria-label="Grid view"{% if view == 'grid' %} aria-current="true"{% endif %}>{{ ui.icon("grid", "icon-sm") }}</a>
    <a class="icon-btn{% if view == 'list' %} is-active{% endif %}" href="{{ list_href }}" aria-label="List view"{% if view == 'list' %} aria-current="true"{% endif %}>{{ ui.icon("list", "icon-sm") }}</a>
  </div>
</div>
{%- endmacro %}
