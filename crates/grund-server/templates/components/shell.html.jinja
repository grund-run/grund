{#- The signed-in app shell's parts. layout-app.html.jinja puts them
    together; a page never calls them itself. Classes are grund.css's shell
    vocabulary (.sidebar, .nav, .nav-item, .org-switch, .topbar). -#}
{% import "components/ui.html.jinja" as ui %}
{% import "components/forms.html.jinja" as forms %}
{% import "components/lists.html.jinja" as lists %}

{#- nav_item(href, icon_name, label, active=false, state="")
    One sidebar link; active marks it as the current page. state:
    "hover" pins the hover look (the style guide only). -#}
{% macro nav_item(href, icon_name, label, active=false, state="") -%}
<li><a class="nav-item{% if active %} is-active{% endif %}{% if state %} is-{{ state }}{% endif %}" href="{{ href }}"{% if active %} aria-current="page"{% endif %}>{{ ui.icon(icon_name) }}{{ label }}</a></li>
{%- endmacro %}

{#- sidebar(viewer, section, csrf)
    viewer:  viewer_context (username, email, initials, orgs, current,
             can_create)
    section: the current page's section, which marks its nav item
    csrf:    the token for the sign-out form in the account menu -#}
{% macro sidebar(viewer, section, csrf) -%}
{% set org = viewer.current %}
<nav class="sidebar" aria-label="Main">
  {{ ui.brand() }}
  {% if org %}
  {{ org_switcher(org, viewer.orgs, viewer.can_create) }}
  <ul class="nav">
    {{ nav_item("/" ~ org.slug, "home", "Overview", section == "overview") }}
    {{ nav_item("/" ~ org.slug ~ "/apps", "grid", "Apps", section in ["apps", "deploy"]) }}
    {{ nav_item("/" ~ org.slug ~ "/machines", "server", "Machines", section in ["machines", "machine-add", "pool"]) }}
    {{ nav_item("/" ~ org.slug ~ "/domains", "globe", "Domains", section == "domains") }}
    {{ nav_item("/" ~ org.slug ~ "/templates", "template", "Templates", section == "templates") }}
    {{ nav_item("/" ~ org.slug ~ "/settings", "users", "Organisation", section in ["org-settings", "members"]) }}
  </ul>
  {% else %}
  <ul class="nav">
    {% if viewer.can_create %}{{ nav_item("/orgs/new", "plus", "New organisation", section == "new-organisation") }}{% endif %}
  </ul>
  {% endif %}
  <ul class="nav nav-foot">
    {{ nav_item("https://git.kjuulh.io/grund/grund", "book", "Docs & community") }}
    {{ nav_item("/settings/sessions", "user", "Account", section == "settings") }}
  </ul>
  {{ account_menu(viewer, csrf) }}
</nav>
{%- endmacro %}

{#- nav(): a list of nav_item()s outside the sidebar (the style guide). -#}
{% macro nav() -%}
<ul class="nav">{{ caller() }}</ul>
{%- endmacro %}

{#- org_switcher(org, orgs, can_create)
    org:        the current organisation (slug, role)
    orgs:       every organisation of the viewer (slug, current)
    can_create: whether to offer "New organisation"
    A <details>, so it opens without script. -#}
{% macro org_switcher(org, orgs, can_create) -%}
<details class="org-switch menu">
  <summary class="org-switch-current">
    {{ ui.mark(org.slug) }}
    <span class="org-switch-text"><span class="org-switch-name">{{ org.slug }}</span><span class="org-switch-role">{{ org.role | capitalize }}</span></span>
    {{ ui.icon("down", "icon-sm org-switch-chevron") }}
  </summary>
  <ul class="menu-list menu-list-full">
    {% for other in orgs %}
    <li><a class="menu-item{% if other.current %} is-current{% endif %}" href="/{{ other.slug }}"{% if other.current %} aria-current="true"{% endif %}>{{ ui.mark(other.slug) }}{{ other.slug }}</a></li>
    {% endfor %}
    {% if can_create %}{{ lists.menu_item("/orgs/new", "plus", "New organisation") }}{% endif %}
  </ul>
</details>
{%- endmacro %}

{#- account_menu(viewer, csrf)
    The avatar (initials) opening a menu with the username, the email and
    Sign out. -#}
{% macro account_menu(viewer, csrf) -%}
<details class="account menu">
  <summary class="avatar" aria-label="{{ viewer.username }}: account menu">{{ viewer.initials }}</summary>
  <ul class="menu-list menu-list-up">
    <li><p class="menu-title">{{ viewer.username }}</p></li>
    {% if viewer.email %}<li><p class="menu-text">{{ viewer.email }}</p></li>{% endif %}
    {{ lists.menu_post("/logout", csrf, "logout", "Sign out") }}
  </ul>
</details>
{%- endmacro %}

{#- topbar(viewer, section, list=none)
    On organisation pages: the app search, except on a section with a
    search of its own (Machines) or none to make (Add machine, the
    management pool), and the
    section's action (topbar_action).
    list:   the Apps page's query (q, sort, view), so the search keeps the
            order and the view and filters the list as you type; none
            elsewhere. -#}
{% macro topbar(viewer, section, list=none) -%}
{% set org = viewer.current %}
<header class="topbar">
  {% if org %}
  {% if section not in ["machines", "machine-add", "pool"] %}{{ forms.search("/" ~ org.slug ~ "/apps", "Search apps", q=list.q if list else "", hidden={"sort": list.sort, "view": list.view} if list else {}, filter=list is not none) }}{% endif %}
  {{ topbar_action(org, section) }}
  {% else %}
  <p class="topbar-title">{{ viewer.username }}</p>
  {% endif %}
</header>
{%- endmacro %}

{#- topbar_action(org, section, state="")
    The screen's one primary button, for owners and admins, following
    the section: Add machine on Machines, Deploy app everywhere else.
    None on the page the action opens (Deploy app, Add machine), where
    that page's form has the primary button, and on the management pool,
    whose own form adds a machine from the provider.
    state: "hover" or "focus" pins that look (the style guide only) -#}
{% macro topbar_action(org, section, state="") -%}
{% set actions = {"machines": ("Add machine", "/machines/add"), "deploy": none, "machine-add": none, "pool": none} %}
{% set action = actions[section] if section in actions else ("Deploy app", "/deploy") %}
{% if org.manages and action %}<span class="topbar-end">{{ ui.button(action.0, href="/" ~ org.slug ~ action.1, icon_name="plus", collapse=true, extra="is-" ~ state if state else "") }}</span>{% endif %}
{%- endmacro %}
