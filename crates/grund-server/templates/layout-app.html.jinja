{#- The signed-in layout: the sidebar, the top bar and the page. A page
    extends it, sets title (the window's title before the organisation's
    name) and fills block content; org is the organisation it is about. -#}
{% extends "base.html.jinja" %}
{% import "components/ui.html.jinja" as ui %}
{% import "components/forms.html.jinja" as forms %}
{% import "components/lists.html.jinja" as lists %}
{% import "components/shell.html.jinja" as shell %}
{% set org = viewer.current %}
{% block title %}{% if title is defined %}{{ title }} · {% endif %}{% if org %}{{ org.slug }} · {% endif %}grund{% endblock %}
{% block scripts %}<script src="{{ js_href }}" defer></script>{% endblock %}
{% block body %}
<div class="shell">
  {{ shell.sidebar(viewer, section, csrf) }}
  <div class="main">
    {{ shell.topbar(viewer, section, list if list is defined else none, topbar_action if topbar_action is defined else none) }}
    <main class="content" id="main">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
{% endblock %}
