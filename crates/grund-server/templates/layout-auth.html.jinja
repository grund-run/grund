{#- The signed-out layout: the brand over one card. A page extends it,
    sets title and fills block card. -#}
{% extends "base.html.jinja" %}
{% import "components/ui.html.jinja" as ui %}
{% import "components/forms.html.jinja" as forms %}
{% import "components/lists.html.jinja" as lists %}
{% block title %}{{ title }} · grund{% endblock %}
{% block body %}
<main class="auth" id="main">
  <div class="auth-card">
    {{ ui.brand() }}
    {% block card %}{% endblock %}
  </div>
</main>
{% endblock %}
