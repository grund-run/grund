use crate::templates::compiled::components::{PageHead, Banner, Panel, Section, Button, EmptyState, DomainName, DomainSetup, DomainActions, Para, Field, Form, HiddenField, Select, Rows, Row, External};

component DomainPanel(domain: &crate::web::domains::DomainItem<'_>, csrf: &str, slug: &str, manages: bool, apps: &[(&str, &str)], namespace_name: &str, namespace_error: &str) {
  <Panel id={domain.id.as_str()} title={domain.name}>
    <:title_content><DomainName name={domain.name} /></:title_content>
    <:end>{if *manages { <DomainActions domain={domain} slug={slug} csrf={csrf} apps={apps} /> }}</:end>
    <DomainSetup domain={domain} slug={slug} csrf={csrf} manages={*manages} />
    {if *namespace_name == domain.name { <Banner text={namespace_error} /> }}
    {if *manages && domain.state == "verified" && !domain.is_app_domain && domain.parent_domain.is_none() {
      {if !apps.is_empty() {
        <Form action="/{slug}/domains/bind" csrf={csrf} layout={Some("row")}>
          <HiddenField name="name" value={domain.name} />
          <Select name="app" id="bind-{domain.name}" label="Serve an app" options={apps} required />
          <Button label="Bind" kind="secondary" />
        </Form>
      } else { <Para kind="hint">Deploy an app to bind this domain to.</Para> }}
    }}
  </Panel>
}
props crate::web::domains::DomainsPage<'_> { csrf, slug, manages, addresses, bindable_apps, custom_only, domains, notice, error, form_error, name_error, name, namespace_name, namespace_error };

<PageHead title="Domains" />
{if !notice.is_empty() { <Banner text={notice} tone="ok" /> }}
{if !error.is_empty() { <Banner text={error} /> }}
<Section id="custom" title="Your own domains" first={Some(true)}>
  {if !domains.iter().any(|domain| !domain.is_app_domain && domain.parent_domain.is_none()) { <EmptyState title="No domains of your own yet" /> }}
  {for domain in domains.iter().filter(|domain| !domain.is_app_domain && domain.parent_domain.is_none()) {
    <DomainPanel domain={domain} csrf={csrf} slug={slug} manages={*manages} apps={bindable_apps} namespace_name={namespace_name} namespace_error={namespace_error} />
  }}
</Section>
{if domains.iter().any(|domain| domain.is_app_domain || domain.parent_domain.is_some()) {
  <Section id="app-domains" title="Organisation app domains">
    {for domain in domains.iter().filter(|domain| domain.is_app_domain || domain.parent_domain.is_some()) {
      <DomainPanel domain={domain} csrf={csrf} slug={slug} manages={*manages} apps={bindable_apps} namespace_name={namespace_name} namespace_error={namespace_error} />
    }}
  </Section>
}}
{if *manages {
  <Panel id="add" title="Add a domain">
    <Form action="/{slug}/domains" csrf={csrf} layout={Some("row")} autocomplete={Some("off")}>
      <Banner text={form_error.as_str()} fields={Some(&[name_error.as_str()])} />
      <Field name="name" label="Domain" value={name.as_str()} autocomplete="off" error={name_error.as_str()} hint="Such as shop.example.com, or example.com for app subdomains. Omit *." required mono />
      <Button label="Add domain" kind="primary" />
    </Form>
  </Panel>
}}
<Section id="addresses" title="Default app addresses">
  {if *custom_only { <EmptyState title="No default app addresses">Public apps require a verified custom domain bound to them.</EmptyState> } else if !addresses.is_empty() {
    <Rows>{for app in addresses {
      <Row name={app.name} href="/{slug}/apps/{app.name}" sub="https://{app.address}" icon_name="globe" tone="ok" status_active={Some(false)}>
        <:end><External href="https://{app.address}" label="Open https://{app.address}" /></:end>
      </Row>
    }}</Rows>
  } else { <EmptyState title="No default app addresses" /> }}
</Section>
