use crate::templates::compiled::components::{PageHead, Banner, Panel, Button, Icon, EmptyState, DomainSetup, DomainRecords, Para, Field, PostButton};
props crate::web::domains::DomainsPage<'_> { csrf, slug, manages, addresses, bindable_apps, custom_only, domains, notice, error, form_error, name_error, name, namespace_name, namespace_error };

<PageHead title="Domains" />
{if !notice.is_empty() { <Banner text={notice} tone="ok" /> }}
{if !error.is_empty() { <Banner text={error} /> }}
<section aria-labelledby="addresses"><div class="section-head"><h2 class="section-title" id="addresses">App addresses<span class="count">{addresses.len()}</span></h2></div>
  {if *custom_only {
    <EmptyState title="No default app addresses">Public apps require a verified custom domain bound to them.</EmptyState>
  } else if addresses.is_empty() {
    <EmptyState title="No app has an address yet">An app gets <code>&lt;app&gt;-{slug}.&lt;domain&gt;</code> when it publishes an HTTP port.</EmptyState>
  } else {
    <ul class="rows">{for app in addresses {
      <li class="row"><span class="row-icon"><Icon name="globe" class="icon-lg tone-ok" /></span><div><p class="row-name"><a href="/{slug}/apps/{app.name}">{app.name}</a></p><p class="row-sub">https://{app.address}</p></div><span></span><div class="row-end"><a class="icon-btn" href="https://{app.address}" rel="noopener noreferrer" target="_blank" aria-label="Open https://{app.address} in a new tab"><Icon name="external" class="icon-sm" /></a></div></li>
    }}</ul>
  }}
</section>
<section class="section" aria-labelledby="custom"><div class="section-head"><h2 class="section-title" id="custom">Your own domains<span class="count">{domains.len()}</span></h2></div>
  {if domains.is_empty() { <EmptyState title="No domains of your own yet" /> }}
</section>
{for domain in domains {
  <Panel id={domain.id.as_str()} title={domain.name}>
    <DomainSetup domain={domain} slug={slug} />
    <DomainRecords domain={domain} />
    {if namespace_name == domain.name { <Banner text={namespace_error.as_str()} /> }}
    {if *manages {
      {if (domain.state == "verified" || domain.state == "bound") && domain.parent_domain.is_none() {
        {if !bindable_apps.is_empty() {
          <form class="form form-row" method="post" action="/{slug}/domains/bind" novalidate><input type="hidden" name="csrf" value={csrf}><input type="hidden" name="name" value={domain.name}>
            <fieldset class="field"><legend class="field-label">{if domain.state == "verified" { Serve this app on it } else { Move it to another app }}</legend><input class="control chips-search" type="search" placeholder="Search apps" aria-label="Search apps" autocomplete="off" data-chip-search hidden><div class="chips">
              {for app in bindable_apps { <label class="chip"><input class="chip-input" type="radio" name="app" value={app} checked={if domain.app.is_empty() { bindable_apps.first().is_some_and(|first| first == app) } else { domain.app == *app }}><span>{app}</span></label> }}
            </div></fieldset><Button label={if domain.state == "verified" { "Bind" } else { "Move" }} kind="secondary" />
          </form>
        } else { <Para kind="hint">Deploy an app to bind this domain to.</Para> }}
      }}
      <div class="form-actions">
        {if (domain.state == "verified" || domain.state == "bound") && !domain.is_app_domain && domain.parent_domain.is_none() {
          <PostButton action="/{slug}/domains/app-domain" csrf={csrf} label="Use for app addresses" kind="secondary" hidden={&[("name", domain.name)]} />
        }}
        {if domain.state == "pending" { <form method="post" action="/{slug}/domains/verify" novalidate><input type="hidden" name="csrf" value={csrf}><input type="hidden" name="name" value={domain.name}><Button label="Check DNS now" kind="secondary" /></form> }}
        {if domain.state == "bound" { <form method="post" action="/{slug}/domains/check" novalidate><input type="hidden" name="csrf" value={csrf}><input type="hidden" name="name" value={domain.name}><Button label="Check now" kind="secondary" /></form> }}
        {if domain.state == "bound" { <form method="post" action="/{slug}/domains/unbind" novalidate><input type="hidden" name="csrf" value={csrf}><input type="hidden" name="name" value={domain.name}><Button label="Unbind" kind="secondary" /></form> }}
        <form method="post" action="/{slug}/domains/remove" novalidate><input type="hidden" name="csrf" value={csrf}><input type="hidden" name="name" value={domain.name}><button class="btn btn-danger" type="submit" aria-label="Remove {domain.name}"><span>Remove</span></button></form>
      </div>
    }}
  </Panel>
}}
{if *manages {
  <Panel id="add" title="Add a domain">
    <form class="form form-row" method="post" action="/{slug}/domains" novalidate autocomplete="off"><input type="hidden" name="csrf" value={csrf}>
      <Banner text={form_error.as_str()} fields={Some(&[name_error.as_str()])} />
      <Field name="name" label="Domain" value={name.as_str()} autocomplete="off" error={name_error.as_str()} hint="Such as shop.example.com, or example.com for app subdomains. Omit *." required mono />
      <Button label="Add domain" kind="primary" />
    </form>
  </Panel>
}}
