use crate::templates::compiled::components::{PageHead, Panel, Banner, Button, Code, Para, Field, Tiles, Tile, ChipsField};
props crate::web::machines::MachineAddPage<'_> { slug, csrf, setup, add_error, name, minutes, mode, hosted_enabled, offers, selected_offer, retry_key, regions_multiple };
{let back = format!("/{slug}/machines");}

<PageHead title="Add machine" back={Some((back.as_str(), "Machines"))} />
{if let Some(setup) = setup {
  <Panel id="setup" title="Run this on the machine">
    <Code text={setup.install.as_deref().unwrap_or(&setup.command)} id="setup-command" copy wrap what="the command" />
    <p>Expires in {setup.minutes} minutes. The code works once and is not shown again.</p>
    {if setup.install.is_some() {
      <Para kind="aside">With grund installed: <code>{setup.command}</code>, then keep <code>grund agent</code> running.</Para>
    } else {
      <Para kind="aside">Then keep <code>grund agent</code> running.</Para>
    }}
  </Panel>
} else if *mode == "" {
  <Panel id="choose" title="Choose a machine">
    <Tiles>
      <Tile href="/{slug}/machines/add?mode=own" title="Your machine" state="" />
      {if *hosted_enabled {
        <Tile href="/{slug}/machines/add?mode=hosted" title="Hosted" state="" />
      }}
    </Tiles>
  </Panel>
} else if *mode == "hosted" {
  <Panel id="hosted" title="Hosted machine">
    {if !add_error.is_empty() { <Banner text={add_error.as_str()} /> }}
    {if offers.is_empty() {
      <Para kind="aside">No hosted sizes are available.</Para>
    } else {
      {let options = offers.iter().filter(|offer| offer.available).map(|offer| (offer.id.as_str(), offer.detail.as_str())).collect::<Vec<_>>();}
      <form class="form" method="post" action="/{slug}/machines/hosted" novalidate><input type="hidden" name="csrf" value={csrf}><input type="hidden" name="idempotency_key" value={retry_key}>
        <Field name="name" label="Name" value={name} autocomplete="off" required error={add_error.as_str()} />
        <ChipsField name="offer" label="Size" options={options.as_slice()} selected={selected_offer} selected_many={&[]} multiple={false} hint="" error="" optional={false} search="" empty="No capacity in this size." />
        {for offer in offers.iter().filter(|offer| !offer.available) {
          <Para kind="aside">{offer.title}{if *regions_multiple { {" · "}{offer.id.split_once('|').map(|(_, region)| region).unwrap_or("")} }}: No capacity in this size.</Para>
        }}
        {if !options.is_empty() {
          <div class="form-actions"><Button label="Create" kind="primary" /></div>
        }}
      </form>
    }}
  </Panel>
} else {
  <Panel id="add" title="Your machine">
    <form class="form" method="post" action="/{slug}/machines/add" novalidate><input type="hidden" name="csrf" value={csrf}>
      {if !add_error.is_empty() { <Banner text="Nothing was saved. Check the field marked below." /> }}
      <Field name="name" label="Name" value={name} autocomplete="off" error={add_error} hint="Empty: its hostname." />
      <div class="form-actions"><p class="form-note"><span>Makes a setup code that works once, for {minutes} minutes.</span></p><Button label="Get a setup code" kind="primary" /></div>
    </form>
  </Panel>
}}
