{% extends "layout-app.html.jinja" %}
{% block title %}Sessions · grund{% endblock %}
{% block content %}
{% call ui.page_head("Sessions") %}
{% if sessions | length > 1 %}{{ forms.post_button("/settings/sessions/revoke-others", csrf, "Sign out everywhere else") }}{% endif %}
{% endcall %}
{{ forms.banner(ok=notice) }}
{% call lists.rows() %}
  {% for session in sessions %}
  {% call(slot) lists.row(session.device, (session.address ~ " · " if session.address else "") ~ "signed in " ~ session.created ~ ", last seen " ~ session.last_seen, icon_name="monitor", tone="violet") %}
    {%- if slot == "status" and session.current %}{{ ui.status("This device") }}{% endif -%}
    {%- if slot == "end" and not session.current %}{{ forms.post_button("/settings/sessions/" ~ session.id ~ "/revoke", csrf, "Sign out", kind="danger", size="sm") }}{% endif -%}
  {% endcall %}
  {% endfor %}
{% endcall %}
{% endblock %}
