use crate::templates::FormState;
use crate::templates::compiled::components::{PageHead, Panel, Tabs, Select, ChoiceField, ChoiceCard, Form, HiddenField, Banner, Grid, Field, FieldError, StepperField, PairsField, ChipsField, Expanders, Expander, CodeField, ToggleField, Actions, Button, Para, EmptyState};
props crate::web::apps::DeployPage<'_> { slug, manages, mode, source_tabs, new, new_error, errors, restore_href, advanced, secrets_dropped, exposures, public_hint, templates, signals, memory_steps, cpu_steps, checks, action, csrf };
{let form_state = FormState { csrf, errors, banners: &std::collections::BTreeMap::new() };}

<PageHead title="Deploy app" />
{if *manages {
  <Panel>
    <Form action={action} form={Some(&form_state)} autocomplete={Some("off")} refused={!new_error.is_empty()}>
      <HiddenField name="mode" value={mode} />
      <Banner text={new_error} />
      <Tabs label="App source" tabs={source_tabs} active={mode} />
      {if *mode == "premade" {
        <Select name="template" label="Template" selected={&new.template} required fill="name" error={form_state.error("template").unwrap_or("")}>
          <option value="" selected={new.template.is_empty()}>Choose a template</option>
          {for template in templates {
            <option value={template.value} selected={new.template == template.value} disabled={template.disabled}>{template.title}{if let Some(tag) = template.tag { {" — "}{tag} }}</option>
          }}
        </Select>
      } else {
        <Field name="image" label="Image" value={&new.image} form={Some(&form_state)} placeholder={Some("nginx:stable")} required />
      }}
      <Field name="name" label="Name" value={&new.name} form={Some(&form_state)} required />
      {if let Some(href) = restore_href { <Button label="Restore" href={href} kind="secondary" /> }}
      <Expanders><Expander id="deploy-options" title="Advanced" summary={&advanced.summary} open={advanced.open()}>
        <Expanders>
          <Expander id="deploy-access" title={if *mode == "premade" { "Access" } else { "Access and port" }} open={advanced.access}>
            <ChoiceField name="exposure" label="Who reaches it" error={form_state.error("exposure").unwrap_or("")} hint={public_hint}>
              {for choice in exposures { <ChoiceCard name="exposure" value={choice.value} title={choice.title} text={&choice.text} icon={choice.icon} tag={choice.tag.unwrap_or("")} disabled={choice.disabled} selected={new.exposure == choice.value || (new.exposure.is_empty() && choice.value == "private")} /> }}
            </ChoiceField>
            {if *mode != "premade" {
              <Field name="port" label="Port" kind="number" value={&new.port} form={Some(&form_state)} hint="Empty: from the image." min={Some("1")} max={Some("65535")} />
            }}
          </Expander>
          {if *mode != "premade" {
            <Expander id="deploy-environment" title="Environment and secrets" open={advanced.environment}>
              <PairsField name="env" label="Environment variables" pairs_owned={&new.env} blank={1} error={form_state.error("env").unwrap_or("")} hint="Shown in the clear." key_label="Name" value_label="Value" />
              <PairsField name="secrets" label="Secrets" blank={1} secret error={form_state.error("secrets").unwrap_or("")} hint={if *secrets_dropped { "Enter them again: a refused form never shows a secret. Never shown again." } else { "Never shown again." }} key_label="Name" value_label="Value" />
            </Expander>
            <Expander id="deploy-storage" title="Storage" open={advanced.storage}>
              {if let Some(problem) = form_state.error("volumes").filter(|problem| !problem.is_empty()) { <FieldError text={problem} /> }}
              <Grid>
                <Field name="volume_name" label="Volume name" value={&new.volume_name} hint="Optional app-owned managed directory; use with Container path. One volume on this form; use grund.yaml for more." autocomplete="off" form={Some(&form_state)} />
                <Field name="volume_path" label="Container path" value={&new.volume_path} hint="Absolute path inside the container, such as /data." autocomplete="off" mono form={Some(&form_state)} />
                <Field name="volume_source" label="Existing host directory" value={&new.volume_source} hint="Optional absolute path on an own machine. Its owner must explicitly allow the containing root in /etc/grund/policy.yaml; grund never deletes its files." autocomplete="off" mono form={Some(&form_state)} />
                <Field name="volume_size_gib" label="Hosted capacity" kind="number" value={&new.volume_size_gib} hint="Optional, 1 to 4096 GiB. Leave empty for an own-machine directory; cannot combine with an existing host directory." unit={Some("GiB")} min={Some("1")} max={Some("4096")} step={Some("1")} form={Some(&form_state)} />
              </Grid>
              <ToggleField name="volume_backup" label="Request daily encrypted S3 backup" checked={new.volume_backup == "on"} hint="Configure your bucket after deploy. No data is protected until a recovery point is verified." />
              <Para kind="hint">Own-machine directories have no enforced size quota or default at-rest encryption. A hosted block volume has the requested capacity and is not mounted until its backend is ready. Backup is off by default; losing an unbacked-up disk loses its data. An app with storage runs one copy.</Para>
            </Expander>
          }}
          <Expander id="deploy-resources" title="Resources" open={advanced.resources}>
            <StepperField name="copies" label="Copies" value={if new.copies.is_empty() { "1" } else { &new.copies }} min="1" max="20" error={form_state.error("copies").unwrap_or("")} />
            {if *mode != "premade" {
              <Grid>
                <Field name="memory" label="Memory" kind="number" value={&new.memory} form={Some(&form_state)} hint="Per copy. Empty: 512." unit={Some("MiB")} min={Some("16")} max={Some("262144")} suggestions_numbers={Some(memory_steps)} />
                <Field name="cpu" label="CPU" kind="number" value={&new.cpu} form={Some(&form_state)} hint="Per copy. Empty: 1." unit={Some("vCPU")} min={Some("0.01")} max={Some("64")} step={Some("any")} suggestions_strings={Some(cpu_steps)} />
              </Grid>
            }}
          </Expander>
          {if *mode != "premade" {
            <Expander id="deploy-runtime" title="Runtime" open={advanced.runtime}>
              <Grid>
                <ChipsField name="check" label="Ready check" options={checks} selected={&new.check} />
                <Field name="check_path" label="Check path" value={&new.check_path} error={form_state.error("check").unwrap_or("")} hint="For an HTTP check. Empty: /." mono />
              </Grid>
              <CodeField name="command" label="Command" value={&new.command} error={form_state.error("command").unwrap_or("")} hint="One argument per line. Empty: the image's own." rows={3} />
              <Grid>
                <ChipsField name="stop_signal" label="Stop signal" options={signals} selected={if new.stop_signal.is_empty() { "SIGTERM" } else { &new.stop_signal }} />
                <Field name="stop_grace" label="Grace (seconds)" kind="number" value={&new.stop_grace} error={form_state.error("stop").unwrap_or("")} hint="From the signal to a kill. Empty: 30." width={Some("sm")} />
              </Grid>
            </Expander>
          }}
        </Expanders>
      </Expander></Expanders>
      <Actions note="Deploying makes the app and its first release." note_icon="layers">
        <Button label="Cancel" href="/{slug}/apps" kind="secondary" />
        <Button label="Deploy app" kind="primary" />
      </Actions>
    </Form>
  </Panel>
} else {
  <EmptyState title="Your role does not deploy apps" text="Owners and admins deploy them." />
}}
