{% extends "layout-auth.html.jinja" %}
{% block title %}Choose a new password · grund{% endblock %}
{% block card %}
{% if valid %}
{{ ui.auth_head("Choose a new password", "Every device signed in to your account is signed out.") }}
{% call forms.form("/reset/confirm", csrf) %}
  {{ forms.hidden_field("token", token) }}
  {{ forms.form_error(error) }}
  {{ forms.field("password", "New password", type="password", autocomplete="new-password", error=password_error, hint="At least 12 characters.", autofocus=true) }}
  {{ ui.button("Set password", block=true) }}
{% endcall %}
{% else %}
{{ ui.auth_head("This link has expired", "Reset links work once, for 30 minutes.") }}
{% call ui.foot() %}<p>{{ ui.link_more("/reset", "Send a new link") }}</p>{% endcall %}
{% endif %}
{% endblock %}
