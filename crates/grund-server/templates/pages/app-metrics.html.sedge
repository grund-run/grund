use crate::templates::compiled::components::{TelemetryBar, ChartCard, Banner};
props crate::web::app_telemetry::MetricsPage { bar, error, organisation, name };

<div class="telemetry" data-telemetry="metrics" data-telemetry-organisation={organisation} data-telemetry-name={name} data-telemetry-range={bar.range} data-telemetry-instance={&bar.instance} data-telemetry-scripts={crate::templates::compiled_telemetry_scripts()}>
  <TelemetryBar bar={bar} />
  <Banner text={error} />
  <ChartCard id="cpu" title="CPU"><p class="chart-empty js-hide">Charts need JavaScript.</p></ChartCard>
  <ChartCard id="memory" title="Memory"><p class="chart-empty js-hide">Charts need JavaScript.</p></ChartCard>
  <p class="telemetry-foot">CPU in millicores (1000 m = 1 vCPU). Memory includes file cache.</p>
</div>
