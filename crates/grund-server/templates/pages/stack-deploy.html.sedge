use crate::templates::FormState;
use crate::templates::compiled::components::{PageHead, Panel, Form, HiddenField, CodeField, Code, Field, PairsField, Actions, Button, ButtonAdvanced, Para, Facts, Fact, Rows, Row, EmptyState, FieldError, Select, Expander};
props crate::web::stacks::DeployPage<'_> { slug, manages, csrf, form, preview, errors, starters, secret_names };
{let state = FormState { csrf, errors, banners: &std::collections::BTreeMap::new() };}
{let cancel = if form.stack.is_empty() { format!("/{slug}/stacks") } else { format!("/{slug}/stacks/{}", form.stack) };}

<PageHead title={form.title()} back={Some((&cancel, "Stacks"))} />
{if *manages {
  {if let Some(plan) = preview {
    <Panel id="stack-preview" title="Preview">
      <Facts>
        <Fact label="Name" value={&plan.name} />
        <Fact label="Memory" value={&format!("{} MiB", plan.memory_mib)} />
        <Fact label="CPU" value={&format!("{}m", plan.cpu_millis)} />
        <Fact label="Peak memory during update" value={&format!("{} MiB", plan.peak_memory_mib)} />
        <Fact label="Peak CPU during update" value={&format!("{}m", plan.peak_cpu_millis)} />
        <Fact label="Selected machine" value={&plan.selected_machine.map(|id| id.to_string()).unwrap_or_else(|| "Not selected".into())} />
      </Facts>
      {if let Some(waiting) = &plan.waiting { <Para>{waiting}</Para> }}
      <Rows>{for service in &plan.services {
        <Row name={&service.name} sub={&crate::web::stacks::service_source(service)} icon_name="box" status_text={Some(&service.status)} detail={&format!("{} copies", service.copies)} />
      }}</Rows>
      {for service in plan.services.iter().filter(|service| service.exclusive && (form.service.is_empty() || form.service == service.name)) {
        <Para>{service.name}: restarting briefly interrupts this service.</Para>
      }}
      {if !plan.removed_services.is_empty() {
        <Para>Services to remove: {plan.removed_services.join(", ")}. Their retained data remains recoverable until retention expires.</Para>
      }}
    </Panel>
    {if plan.services.iter().any(|service| !service.volume_intents.is_empty()) {
      <Panel id="stack-preview-storage" title="Requested storage">
        <Rows>{for service in &plan.services {
          {for volume in &service.volume_intents {
            <Row name={&format!("{}/{}", service.name, volume.name)} sub={&volume.path} detail={&crate::web::stacks::storage_policy(volume)} icon_name="disk" />
          }}
        }}</Rows>
      </Panel>
    }}
  }}
  <Panel>
    {if preview.is_none() && form.stack.is_empty() {
      <Form action="/{slug}/stacks/deploy" method={Some("get")} layout={Some("row")}>
        <Select name="starter" label="Start from" options={starters} selected={&form.starter} required />
        <Button label="Load example" kind="secondary" />
      </Form>
      <Para>Loading an example replaces the file. PostgreSQL and Redis use generated credentials from the templates catalogue.</Para>
    }}
    <Form action={if preview.is_some() { format!("/{slug}/stacks/deploy") } else { format!("/{slug}/stacks/deploy/preview") }} form={Some(&state)} autocomplete={Some("off")} refused={!errors.is_empty()}>
      <HiddenField name="stack" value={&form.stack} />
      <HiddenField name="starter" value={&form.starter} />
      <HiddenField name="expected_version" value={&form.expected_version} />
      <HiddenField name="key" value={&form.key} />
      <HiddenField name="service" value={&form.service} />
      {for field in ["expected_version", "key", "operation"] { {if let Some(message) = errors.get(field) { <FieldError text={message} /> }} }}
      {if preview.is_some() {
        <HiddenField name="file" value={&form.file} />
        <Code text={&form.file} filename="grund.yaml" />
      } else {
        <CodeField name="file" label="Stack file" filename="grund.yaml" value={&form.file} rows={18} required error={state.error("file").unwrap_or("")} hint="Maximum 1 MiB. Secret values belong in Launch secrets, not in this file." />
      }}
      {if !form.service.is_empty() {
        <Para>Only {form.service} is updated. Keep every other service unchanged in the complete file.</Para>
      }}
      {if !form.stack.is_empty() && preview.is_none() {
        <Expander title="Template update" open={state.error("refresh_template").is_some()}>
          <Field name="refresh_template" label="Update template" value={&form.refresh_template} hint="Optional service name. Refreshes its pinned template definition." form={Some(&state)} />
        </Expander>
      } else {
        <HiddenField name="refresh_template" value={&form.refresh_template} />
      }}
      {if preview.is_some_and(|plan| !plan.removed_services.is_empty()) {
        <Field name="confirmed_removals" label="Confirm service removals" value={&form.confirmed_removals} required hint="Type every listed service name separated by commas. Retained data is not purged." form={Some(&state)} />
      } else {
        <HiddenField name="confirmed_removals" value={&form.confirmed_removals} />
        {if let Some(message) = state.error("confirmed_removals") { <FieldError text={message} /> }}
      }}
      {if preview.is_some() || !secret_names.is_empty() || state.error("secrets").is_some() {
        <PairsField name="secrets" label="Launch secrets" secret pairs_owned={secret_names} blank={1} key_label="service.NAME" value_label="Secret value" error={state.error("secrets").unwrap_or("")} hint={if errors.is_empty() { "Use service.NAME for each binding. Values are stored separately from the file and never shown again." } else { "Enter secret values again after previewing. A refused form never shows them." }} />
      }}
      <Actions>
        <Button label="Cancel" href={&cancel} kind="secondary" />
        {if preview.is_some() {
          <ButtonAdvanced label="Edit file" kind="secondary" name="intent" value="edit" form_action="/{slug}/stacks/deploy/preview" />
        }}
        <Button label={if preview.is_some() { if form.stack.is_empty() { "Create stack" } else { "Deploy change" } } else { "Preview" }} />
      </Actions>
    </Form>
  </Panel>
} else {
  <EmptyState title="Your role does not deploy stacks" text="Owners and admins deploy them." />
}}
