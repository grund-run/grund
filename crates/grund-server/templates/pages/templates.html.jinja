{% extends "layout-app.html.jinja" %}
{% import "components/images.html.jinja" as images %}
{% set org = viewer.current %}
{% block title %}Templates · {{ org.slug }} · grund{% endblock %}
{% block content %}
{{ images.sprite(image_keys) }}
{{ ui.page_head("Templates", "Ready-made apps you can deploy in one step, each pinned to one version.") }}
{% call ui.note() %}PostgreSQL, Redis and MinIO keep their data on disk, so they come when grund has volumes. Until then, any other image deploys by its name{% if org.manages %} from <a href="/{{ org.slug }}/deploy">Deploy app</a>{% endif %}.{% endcall %}
{% call lists.items("grid") %}
{% for template in templates %}{{ lists.template_row(template, ("/" ~ org.slug ~ "/deploy?template=" ~ template.key) if org.manages else "") }}{% endfor %}
{% endcall %}
{% endblock %}
