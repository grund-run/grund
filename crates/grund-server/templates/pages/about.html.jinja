{% extends "pages/organisation.html.jinja" %}
{% set title = "About" %}
{% set tab = "about" %}
{% block tab %}
{% call lists.rows() %}
  {{ lists.row("Version", revision, plain=true) }}
  {{ lists.row("Address", address, plain=true) }}
  {{ lists.row("App addresses", "<app>-" ~ org.slug ~ "." ~ app_domain if app_domain else "None: apps answer only inside grund", plain=true) }}
  {{ lists.row("Organisations", "One, which everyone joins by invitation" if single else "One per account, and more on request", plain=true) }}
{% endcall %}
{% call ui.para() %}grund is free software under the AGPL-3.0. The fonts' licenses are on <a href="/licenses">Licenses</a>.{% endcall %}
{% endblock %}
