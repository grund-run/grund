{% extends "layout-app.html.jinja" %}
{% set title = "Management pool" %}
{% block content %}
{{ ui.page_head("Management pool", back=("/" ~ org.slug ~ "/machines", "Machines")) }}
{{ forms.banner(error, ok=notice) }}

{% call lists.rows() %}
  {% for machine in machines %}
  {% call(slot) lists.row(machine.name, machine.sub, icon_name="server", tone=machine.tone, tags=(["From the provider"] if machine.from_provider else []), status=machine.status, status_tone=machine.tone) %}
    {%- if slot == "end" and org.manages -%}
    {%- if machine.state == "leased" %}{{ forms.post_button("/" ~ org.slug ~ "/pool/" ~ machine.id ~ "/end", csrf, "End lease", size="sm") }}{% endif -%}
    {%- if machine.state == "returning" and machine.from_provider %}{{ forms.post_button("/" ~ org.slug ~ "/pool/" ~ machine.id ~ "/rebuild", csrf, "Wipe again", size="sm") }}{% endif -%}
    {{ forms.post_button("/" ~ org.slug ~ "/pool/" ~ machine.id ~ "/revoke", csrf, "Revoke", kind="danger", size="sm") }}
    {%- endif -%}
  {% endcall %}
  {% endfor %}
{% endcall %}
{% if not machines %}{{ ui.empty_state(text="No machines in the pool.") }}{% endif %}

{% if org.manages %}
{% set available = machines | selectattr("state", "equalto", "available") | list %}
{% if available %}
{% call ui.section("lease", "Lease a machine") %}
  {% call ui.expanders() %}
  {% for machine in available %}
  {% call ui.expander(machine.name, summary="Available", icon_name="server") %}
    {% call forms.form("/" ~ org.slug ~ "/pool/" ~ machine.id ~ "/lease", csrf) %}
      {% call forms.grid() %}
      {{ forms.field("organisation", "Organisation", autocomplete="off", hint="Its name, as in its address.") }}
      {{ forms.field("name", "Name there", autocomplete="off", required=false, hint="Empty: " ~ machine.name ~ ".") }}
      {% endcall %}
      {% call forms.actions("The organisation can place apps on it at once.") %}{{ ui.button("Lease it") }}{% endcall %}
    {% endcall %}
  {% endcall %}
  {% endfor %}
  {% endcall %}
{% endcall %}
{% endif %}

{% if provider %}
{% call ui.panel("provision", "Add a machine") %}
  {% call forms.form("/" ~ org.slug ~ "/pool/provision", csrf, layout="row") %}
    {{ forms.field("name", "Name", autocomplete="off", required=false, hint="Empty: the provider's.") }}
    {{ ui.button("Add from the provider") }}
  {% endcall %}
{% endcall %}
{% endif %}
{% endif %}
{% endblock %}
