use crate::templates::compiled::components::{TelemetryBar, ChartCard, Banner, LogStream, PostButton};
props crate::web::app_telemetry::LogsPage { bar, error, organisation, name, lines, instances, since, until, forward, older, older_href, foot, restart };

<div class="telemetry" data-telemetry="logs" data-telemetry-organisation={organisation} data-telemetry-name={name} data-telemetry-range={bar.range} data-telemetry-instance={&bar.instance} data-telemetry-search={bar.search.as_deref().unwrap_or("")} data-telemetry-since={since} data-telemetry-until={until} data-telemetry-forward={forward} data-telemetry-older={older} data-telemetry-instances={if *instances { Some("on") } else { None }} data-telemetry-scripts={crate::templates::compiled_telemetry_scripts()}>
  <TelemetryBar bar={bar} />
  <Banner text={error} />
  {if restart.required(lines) {
    <div class="telemetry-notice">
      <span>{if restart.single_copy { "Older output mixes stdout and stderr. A restart separates them; with one copy, requests can be interrupted." } else { "Older output mixes stdout and stderr. A restart, one copy at a time, separates them." }}</span>
      <PostButton action={&restart.action} csrf={&restart.csrf} label="Restart to enable" kind="secondary" />
    </div>
  }}
  <ChartCard id="volume" title="Log volume"><p class="chart-empty js-hide">Charts need JavaScript.</p></ChartCard>
  <LogStream lines={lines} instance={*instances} older={older_href} />
  <p class="telemetry-foot">{foot}</p>
</div>
