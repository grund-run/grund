use crate::templates::compiled::components::{OrganisationTabs, Banner, Rows, Row, Section, Form, ChoiceField, ChoiceCard, Button, PostButton, Actions, Para, HiddenField};
props crate::web::billing::BillingPage<'_> { viewer, csrf, account, notice, error, choice_key, portal_key, cancel_key };

{if let Some(org) = &viewer.current {
  <OrganisationTabs slug={&org.slug} active="billing" billing />
  <Banner text={error} ok={Some(notice)} />
  {if let Some(account) = &account {
    <Section id="billing-account" title="Account"><Rows>
      <Row name="Plan" sub={&account.details.plan} plain />
      {if !account.details.pending_plan.is_empty() { <Row name="Next plan" sub={&account.details.pending_plan} plain /> }}
      {if account.details.past_due { <Row name="Payment" sub="Past due" plain /> }}
      {if account.details.complimentary_scheduled {
        {if let Some(date) = &account.details.complimentary_effective_at {
          <Row name="Complimentary from" sub={date} plain />
        }}
        {if !account.details.complimentary_scheduled_plan.is_empty() {
          <Row name="Complimentary plan" sub={&account.details.complimentary_scheduled_plan} plain />
        }}
      }}
      {if account.details.complimentary {
        <Row name="Complimentary" sub="Active" plain />
        {if !account.details.complimentary_reason.is_empty() { <Row name="Reason" sub={&account.details.complimentary_reason} plain /> }}
        {if let Some(expires) = &account.details.complimentary_expires_at { <Row name="Until" sub={expires} plain /> }}
        <Row name="Total" sub="€0" plain />
      }}
    </Rows></Section>
    {if account.details.complimentary_scheduled {
      <Para kind="hint">The current billing cycle is charged normally until the complimentary discount takes effect.</Para>
    }}
    {if account.details.past_due { <Para kind="hint">Update the payment details in the portal.</Para> }}
    {if !account.details.complimentary && !account.details.complimentary_scheduled { <Section id="plans" title="Choose plan">
      <Form action="/{org.slug}/settings/billing/choose" csrf={csrf}>
        <HiddenField name="idempotency_key" value={choice_key} />
        <ChoiceField name="plan" label="Plan" large>
          <ChoiceCard name="plan" value="Homelab" title="Homelab" text="First own machine free, then €3 per machine-month" selected={account.details.plan == "Homelab"} />
          <ChoiceCard name="plan" value="Pro" title="Pro" text="€10 per own machine-month" tag="Recommended" selected={account.details.plan == "Pro"} />
          <ChoiceCard name="plan" value="Business" title="Business" text="€49 per month + €10 per own machine-month" selected={account.details.plan == "Business"} />
        </ChoiceField>
        <Actions><Button label={if account.details.plan == "Free" { "Continue to checkout" } else { "Change plan" }} /></Actions>
      </Form>
    </Section> }}
    {if account.details.plan != "Free" && !account.details.complimentary {
      <Section id="payment" title="Payment">
        <Actions>
          <PostButton action="/{org.slug}/settings/billing/portal" csrf={csrf} label="Payment methods and invoices" kind="secondary" hidden={&[("idempotency_key", portal_key)]} />
          <PostButton action="/{org.slug}/settings/billing/cancel" csrf={csrf} label="Cancel at period end" kind="secondary" hidden={&[("idempotency_key", cancel_key)]} />
        </Actions>
      </Section>
    }}
  } else {
    <Banner text="Billing is unavailable. Try again later." />
  }}
}}
