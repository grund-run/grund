{% extends "pages/app.html.jinja" %}
{% block tab %}
{% call ui.panel("status", "Application status") %}
  {% call ui.facts() %}
    {% call ui.fact("Reachable at", wide=true) %}
      {% if app.address %}{{ ui.endpoint("https://" ~ app.address, href="https://" ~ app.address) }}
      {% for domain in app.domains %}{% if domain.serving %}{{ ui.endpoint("https://" ~ domain.name, href="https://" ~ domain.name) }}{% endif %}{% endfor %}
      {% elif app.internal %}{{ ui.endpoint(app.internal) }}
      {% else %}{{ ui.para("Nowhere: it has no port.") }}{% endif %}
    {% endcall %}
    {{ ui.fact("Status", app.word, tone=app.tone) }}
    {% if running %}{{ ui.fact("Running", running.version, icon_name="layers", lines=[(running.line, running.reference)]) }}
    {% else %}{{ ui.fact("Running", "Nothing", icon_name="layers") }}{% endif %}
    {{ ui.fact("Last change", latest.ago if latest else "None", icon_name="clock", after=("· " ~ latest.by) if latest else "") }}
  {% endcall %}
{% endcall %}

{% call ui.panel("activity", "Latest activity", action=(app.base ~ "/deployments", "All releases")) %}
  {% if activity %}
  {% call lists.timeline() %}
    {% for release in activity %}
    {% call lists.event(release.event, release.ago, release.at, release.iso, release.outcome, release.state) %}by <strong>{{ release.by }}</strong> {{ release.source }}{% if release.reason %} · {{ release.reason }}{% endif %}{% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No deployments yet.") }}
  {% endif %}
{% endcall %}
{% endblock %}
