{% extends "pages/app.html.jinja" %}
{% block tab %}
{% call ui.panel("status", "Application status", app.lede) %}
  {% call ui.facts() %}
    {% call ui.fact("Reachable at", wide=true) %}
      {% if app.address %}{{ ui.endpoint("https://" ~ app.address, href="https://" ~ app.address) }}{{ ui.pill("Public HTTP", icon_name="globe") }}
      {% for domain in app.domains %}{% if domain.serving %}{{ ui.endpoint("https://" ~ domain.name, href="https://" ~ domain.name) }}{% else %}{{ ui.para(domain.line) }}{% endif %}{% endfor %}
      {% elif app.internal %}{{ ui.endpoint(app.internal) }}{{ ui.pill("Private", icon_name="lock") }}
      {% else %}{{ ui.para("Nowhere: it has no port, so nothing reaches it.") }}{% endif %}
    {% endcall %}
    {{ ui.fact("Status", app.word, tone=app.tone, lines=[app.line]) }}
    {% if running %}{{ ui.fact("Running", running.version, icon_name="layers", lines=[running.image, running.digest]) }}
    {% else %}{{ ui.fact("Running", "Nothing", icon_name="layers", lines=["No release is live"]) }}{% endif %}
    {% if latest %}{{ ui.fact("Last change", latest.ago, icon_name="clock", lines=["by " ~ latest.by, latest.event]) }}
    {% else %}{{ ui.fact("Last change", "None", icon_name="clock") }}{% endif %}
  {% endcall %}
{% endcall %}

{% call ui.panel("activity", "Latest activity", "The newest releases and what became of them.", action=(app.base ~ "/deployments", "All releases")) %}
  {% if activity %}
  {% call lists.timeline() %}
    {% for release in activity %}
    {% call lists.event(release.event, release.ago, release.at, release.iso, release.outcome, release.state) %}by <strong>{{ release.by }}</strong> {{ release.source }}{% if release.reason %} · {{ release.reason }}{% endif %}{% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No deployments yet.") }}
  {% endif %}
{% endcall %}
{% endblock %}
