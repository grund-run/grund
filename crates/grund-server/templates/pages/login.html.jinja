{% extends "layout-auth.html.jinja" %}
{% set title = "Sign in" %}
{% block card %}
{{ ui.auth_head("Sign in") }}
{% call forms.form("/login", csrf) %}
  {% if return_to %}{{ forms.hidden_field("return_to", return_to) }}{% endif %}
  {{ forms.banner(error, ok=notice) }}
  {{ forms.field("login", "Email or username", value=login, autocomplete="username", autofocus=not login) }}
  {{ forms.field("password", "Password", type="password", autocomplete="current-password", autofocus=login) }}
  {{ ui.button("Sign in", block=true) }}
{% endcall %}
{% if providers %}
{{ forms.or_divider() }}
{{ forms.providers(providers) }}
{% endif %}
{% call ui.foot() %}
  <p><a href="/reset">Forgot your password?</a></p>
  {% if signup_enabled %}<p>New to grund? <a href="/signup">Create an account</a></p>{% endif %}
{% endcall %}
{% endblock %}
