{% extends "layout-app.html.jinja" %}
{% set title = "Sign in the grund CLI" %}
{% block content %}
{{ ui.page_head("Sign in the grund CLI") }}
{{ forms.banner(error, ok=notice) }}
{% if login %}
{% call ui.panel("login", "Is this you?") %}
  {{ ui.para("Approve only a login you started yourself. The CLI acts as " ~ username ~ " in every organisation you are in, until you sign it out on Sessions.", "note") }}
  {% call ui.facts() %}
    {{ ui.fact("Code", login.code, icon_name="key") }}
    {{ ui.fact("Client", login.client) }}
    {{ ui.fact("Computer", login.host) }}
    {{ ui.fact("From", login.address if login.address else "Unknown") }}
    {{ ui.fact("Started", login.created) }}
  {% endcall %}
  {% call forms.form("/device", csrf) %}
    {{ forms.hidden_field("login", login.id) }}
    {{ forms.hidden_field("decision", "approve") }}
    {% call forms.actions("The terminal signs in at its next check, within seconds.") %}{{ ui.button("Approve") }}{% endcall %}
  {% endcall %}
  {{ forms.post_button("/device", csrf, "Deny", kind="danger", hidden={"login": login.id, "decision": "deny"}) }}
{% endcall %}
{% elif not done %}
{% call ui.panel("code", "Enter the code your terminal shows") %}
  {% call forms.form("/device", "", method="get", autocomplete="off") %}
    {{ forms.field("code", "Code", value=code, error=code_error, hint="Eight letters, such as BCDF-GHJK.", autofocus=true, mono=true) }}
    {% call forms.actions() %}{{ ui.button("Continue") }}{% endcall %}
  {% endcall %}
{% endcall %}
{% endif %}
{% endblock %}
