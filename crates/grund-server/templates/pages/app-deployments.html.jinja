{% extends "pages/app.html.jinja" %}
{% block tab %}
{% call ui.section("copies", "Copies", count=replicas | length, first=true) %}
  {% if replicas %}
  {% call lists.rows() %}
    {% for replica in replicas %}
    {{ lists.row("Copy " ~ replica.slot ~ " of " ~ replica.of ~ " · v" ~ replica.release, "on " ~ replica.machine ~ " · since " ~ replica.placed, icon_name="server", tone=replica.tone, status=replica.words, status_tone=replica.tone) }}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No copies run yet.") }}
  {% endif %}
  {% if crowded %}{{ ui.para("All copies run on " ~ crowded ~ "; add a machine to spread them.") }}{% endif %}
{% endcall %}

{% call ui.section("versions", "Releases", count=releases | length) %}
  {% if releases %}
  {% call ui.expanders() %}
    {% for release in releases %}
    {% call ui.expander("v" ~ release.number, release.verb ~ " by " ~ release.by ~ (" " ~ release.source if release.source else "") ~ (" · " ~ release.note if release.note else ""), icon_name="layers", tone=release.tone, state=(release.outcome, release.tone), meta=[release.short_digest, release.ago], id="v" ~ release.number) %}
      {% call lists.rows() %}
        {{ lists.row("Image", release.image | short_image, plain=true) }}
        {% call(slot) lists.row("Digest", release.digest, plain=true) %}{% if slot == "end" %}{{ ui.copy_button(release.digest, "the digest") }}{% endif %}{% endcall %}
        {{ lists.row("Made", release.at ~ " · " ~ release.verb ~ " by " ~ release.by ~ (" " ~ release.source if release.source else ""), plain=true) }}
        {% if release.note %}{{ lists.row("Note", release.note, plain=true) }}{% endif %}
        {% if release.reason %}{{ lists.row("What happened", release.reason, plain=true) }}{% endif %}
      {% endcall %}
      {% if org.manages and not release.live %}
      {% call forms.actions("Makes a new release with v" ~ release.number ~ "'s image and settings, and the secrets' newest values.") %}{{ forms.post_button(app.base ~ "/releases/" ~ release.number ~ "/rollback", csrf, release.again, size="sm") }}{% endcall %}
      {% endif %}
    {% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No releases yet.") }}
  {% endif %}
{% endcall %}
{% endblock %}
