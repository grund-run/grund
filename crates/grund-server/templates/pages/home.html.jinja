{% extends "layout-app.html.jinja" %}
{% set org = viewer.current %}
{% block title %}{{ org.slug }} · grund{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1 class="page-title">Overview</h1>
    <p class="status-line">{{ ui.icon("ok", "tone-ok") }}Signed in as {{ viewer.username }}, {{ org.role }} of {{ org.slug }}.</p>
  </div>
  <span class="btn btn-primary" aria-disabled="true">{{ ui.icon("plus") }}Deploy application</span>
</div>
<div class="callout">
  {{ ui.icon("box", "icon-lg tone-orange") }}
  <div class="callout-body">
    <p class="callout-title">Deploying applications is in development</p>
    <p class="callout-text">{{ org.slug }} is ready. Its applications, machines and domains arrive here next, and everything it runs is billed to it, not to a person.</p>
  </div>
</div>
<section class="section" aria-labelledby="org">
  <div class="section-head">
    <h2 class="section-title" id="org">Organisation</h2>
    <a class="link-more" href="/{{ org.slug }}/settings/members">Members {{ ui.icon("arrow", "icon-sm") }}</a>
  </div>
  <ul class="rows">
    <li class="row">
      <span class="row-icon">{{ ui.icon("users", "icon-lg tone-blue") }}</span>
      <div><p class="row-name">{{ members }} member{% if members != 1 %}s{% endif %}</p><p class="row-sub">/{{ org.slug }}/settings/members</p></div>
      {{ ui.status(org.role | capitalize) }}
      <span></span>
    </li>
  </ul>
</section>
<ul class="stats">
  <li>{{ ui.icon("mail", "icon-sm") }}{{ viewer.email }}</li>
  <li>{{ ui.icon("clock", "icon-sm") }}Member since {{ viewer.registered_on }}</li>
</ul>
{% endblock %}
