{% extends "layout-app.html.jinja" %}
{% import "components/images.html.jinja" as images %}
{% block content %}
{{ images.sprite(icons) }}
{{ ui.page_head("Overview", "Signed in as " ~ viewer.username ~ ", " ~ org.role ~ " of " ~ org.slug ~ ".") }}
{% call ui.section("apps", "Apps", count=app_count, more=("/" ~ org.slug ~ "/apps", "View all") if app_count else none, first=true) %}
  {% if apps %}
  {% call lists.items() %}{% for app in apps %}{{ lists.app_row(org, app) }}{% endfor %}{% endcall %}
  {% elif org.manages %}
  {{ ui.add_card("/" ~ org.slug ~ "/deploy", "Deploy your first app", "Deploy any container image by its name, such as nginx:1.27.") }}
  {% else %}
  {{ ui.empty_state("No apps yet", "An owner or admin of " ~ org.slug ~ " deploys them, and they show up here.") }}
  {% endif %}
{% endcall %}
{% call ui.section("org", "Organisation", more=("/" ~ org.slug ~ "/settings/members", "Members")) %}
  {% call lists.rows() %}
    {{ lists.row(members ~ " member" ~ ("" if members == 1 else "s"), "/" ~ org.slug ~ "/settings/members", icon_name="users", tone="blue", status=org.role | capitalize) }}
  {% endcall %}
{% endcall %}
{{ ui.stats([("mail", viewer.email), ("clock", "Member since " ~ viewer.registered_on)]) }}
{% endblock %}
