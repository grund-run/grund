use crate::templates::compiled::components::{PageHead, Banner, Rows, Row, Panel, Button, Field, EmptyState, Menu, MenuPost, Expanders, Expander, Form, Grid, Actions};
props crate::web::pool::PoolPage<'_> { csrf, slug, manages, machines, notice, error, provider };
{let back = format!("/{slug}/admin?tab=pool");}

<PageHead title="Management pool" back={Some((back.as_str(), "Admin"))} />
{if !notice.is_empty() { <Banner text={notice} tone="ok" /> }}
{if !error.is_empty() { <Banner text={error} /> }}
<Rows>{for machine in machines {
  <Row name={&machine.name} sub={&machine.sub} icon_name="server" tone={machine.tone} tags={if machine.from_provider { &["From the provider"][..] } else { &[][..] }} status_text={Some(machine.status)} status_tone={machine.tone} end_active={Some(*manages)}>
    <:end>{if *manages {
      <Menu label={format!("Actions for {}", machine.name)} icon_name="more">
        {if machine.state == "leased" { <MenuPost action="/{slug}/pool/{machine.id}/end" csrf={csrf} icon_name="minus" label="End lease" /> }}
        {if machine.state == "returning" && machine.from_provider { <MenuPost action="/{slug}/pool/{machine.id}/rebuild" csrf={csrf} icon_name="clock" label="Wipe again" /> }}
        <MenuPost action="/{slug}/pool/{machine.id}/revoke" csrf={csrf} icon_name="trash" label="Revoke" danger />
      </Menu>
    }}</:end>
  </Row>
}}</Rows>
{if machines.is_empty() { <EmptyState text="No machines in the pool." /> }}
{if *manages {
  {if machines.iter().any(|m| m.state == "available") {
    <Panel id="lease" title="Lease a machine">
      <Expanders>{for machine in machines.iter().filter(|m| m.state == "available") {
        <Expander title={&machine.name} summary="Available" icon_name="server">
          <Form action="/{slug}/pool/{machine.id}/lease" csrf={csrf}>
            <Grid>
              <Field name="organisation" label="Organisation" autocomplete="off" required />
              <Field name="name" label="Name there" autocomplete="off" hint="Empty: {machine.name}." />
            </Grid>
            <Actions note="The organisation can place apps on it at once."><Button label="Lease it" kind="secondary" /></Actions>
          </Form>
        </Expander>
      }}</Expanders>
    </Panel>
  }}
  {if *provider {
    <Panel id="provision" title="Add a machine">
      <Form action="/{slug}/pool/provision" csrf={csrf} layout={Some("row")}>
        <Field name="name" label="Name" autocomplete="off" hint="Empty: the provider's." />
        <Button label="Add from the provider" />
      </Form>
    </Panel>
  }}
}}
