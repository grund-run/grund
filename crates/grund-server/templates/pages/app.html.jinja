{#- An app's page: its head and tabs. Each tab extends this and fills
    block tab (app-overview, app-deployments, app-soon, app-settings). -#}
{% extends "layout-app.html.jinja" %}
{% import "components/images.html.jinja" as images %}
{% set title = app.name ~ " · Apps" %}
{% block head %}{% if refresh %}<meta http-equiv="refresh" content="5">{% endif %}{% endblock %}
{% block content %}
{{ images.sprite([app.icon]) }}
{% call ui.page_head(app.name, reference=app.image, back=("/" ~ org.slug ~ "/apps", "Back to apps"), image=app.icon, state=(app.word, app.tone)) %}
  {% if org.manages %}{{ ui.button("Deploy change", href=app.base ~ "/deploy") }}{% endif %}
  {{ lists.app_menu(org, app) }}
{% endcall %}
{{ ui.tabs(app.name, tabs, tab) }}
{{ forms.banner(error, ok=notice) }}
{% for message in waiting %}{{ forms.banner(message) }}{% endfor %}
{% block tab %}{% endblock %}
{% endblock %}
