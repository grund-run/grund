use crate::templates::compiled::components::{PageHead, Panel, Para, Code, Button};
props crate::web::apps::CredentialPage { title, value, message, back };

<PageHead title={title} />
<Panel title="Generated credential">
  <Para>{message}</Para>
  {if let Some(value) = value {
    <Code text={value} what="generated credential" wrap />
  }}
  <Button label="Back to app" href={back} kind="secondary" />
</Panel>
