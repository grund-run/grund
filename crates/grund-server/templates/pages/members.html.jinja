{% extends "pages/organisation.html.jinja" %}
{% set title = "Members" %}
{% set tab = "members" %}
{% set lede = "Everyone here can use what " ~ viewer.current.slug ~ " owns. Owners and admins manage who is in it; only owners manage billing." %}
{% block tab %}
{% call lists.rows() %}
  {% for member in members %}
  {% set remove = "/" ~ org.slug ~ "/settings/members/" ~ member.id ~ "/remove" %}
  {% call(slot) lists.row(member.username, member.email ~ (" · joined " ~ member.joined if member.joined else ""), letter=member.username, tags=["You"] if member.is_self else []) %}
    {%- if slot == "status" %}
      {%- if member.manageable %}{{ forms.select_form("/" ~ org.slug ~ "/settings/members/" ~ member.id ~ "/role", csrf, "role", "role-" ~ member.id, "Role of " ~ member.username, roles, member.role, "Change") }}
      {%- else %}{{ ui.status(member.role | capitalize) }}{% endif %}
    {%- elif slot == "end" %}
      {%- if member.manageable %}{{ forms.post_button(remove, csrf, "Remove", kind="danger", size="sm") }}
      {%- elif member.is_self %}{{ forms.post_button(remove, csrf, "Leave", kind="ghost", size="sm") }}{% endif %}
    {%- endif -%}
  {% endcall %}
  {% endfor %}
{% endcall %}

{% if org.manages %}
{% call ui.section("invite", "Invite someone") %}
  {% call forms.form("/" ~ org.slug ~ "/settings/members/invite", csrf, layout="row") %}
    {{ forms.banner(invite_error) }}
    {{ forms.field("email", "Email", type="email", value=email, autocomplete="off", hint="We mail them a link that works for 7 days.") }}
    {{ forms.select_field("role", "Role", [("member", "Member"), ("admin", "Admin")], role, id="invite-role") }}
    {{ ui.button("Send invitation", icon_name="mail") }}
  {% endcall %}
{% endcall %}
{% endif %}

{% call ui.section("pending", "Pending invitations", count=pending | length) %}
  {% if pending %}
  {% call lists.rows() %}
    {% for invitation in pending %}
    {% call(slot) lists.row(invitation.email, "invited by " ~ invitation.invited_by ~ " · expires " ~ invitation.expires, icon_name="mail", tone="violet", status=invitation.role | capitalize, status_tone="muted") %}
      {%- if slot == "end" and org.manages %}{{ forms.post_button("/" ~ org.slug ~ "/settings/invitations/" ~ invitation.id ~ "/revoke", csrf, "Withdraw", kind="danger", size="sm") }}{% endif -%}
    {% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No invitations are waiting.") }}
  {% endif %}
{% endcall %}
{% endblock %}
