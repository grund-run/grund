{% extends "layout-app.html.jinja" %}
{% set title = "Add machine" %}
{% block content %}
{{ ui.page_head("Add machine", back=("/" ~ org.slug ~ "/machines", "Machines")) }}

{% if setup %}
{% call ui.panel("setup", "Run this on the machine") %}
  {{ ui.code(setup.install or setup.command, id="setup-command", wrap=true, what="the command") }}
  <p>Expires in {{ setup.minutes }} minutes. The code works once and is not shown again.</p>
  {% if setup.install %}
  {% call ui.para(kind="aside") %}With grund installed: <code>{{ setup.command }}</code>, then keep <code>grund agent</code> running.{% endcall %}
  {% else %}
  {% call ui.para(kind="aside") %}Then keep <code>grund agent</code> running.{% endcall %}
  {% endif %}
{% endcall %}
{% else %}
{% call ui.panel("add", "New machine") %}
  {% call forms.form("/" ~ org.slug ~ "/machines/add", csrf) %}
    {{ forms.banner(fields=[add_error]) }}
    {{ forms.field("name", "Name", value=name, autocomplete="off", required=false, hint="Empty: its hostname.", error=add_error) }}
    {% call forms.actions("Makes a setup code that works once, for " ~ minutes ~ " minutes.") %}{{ ui.button("Get a setup code") }}{% endcall %}
  {% endcall %}
{% endcall %}
{% endif %}
{% endblock %}
