{#- An app's Settings: what is set (Configured), what can be added (Add
    more) and Delete, each a link to its own form at ?edit=<key>
    (web::apps::setting_items, SETTING_KEYS). A setting that changes what
    runs makes a new release of the image the newest release runs; Copies
    and Delete do not. -#}
{% extends "pages/app.html.jinja" %}
{% block tab %}
{% set here = app.base ~ "/settings" %}
{% set release_note = "Saving makes release v" ~ next ~ "." %}
{% set cancel = ui.button("Cancel", href=here, kind="secondary") %}
{% set readonly = ui.para("Owners and admins change this.") %}
{% call ui.section("settings", "Settings", first=true) %}
{% if not items %}
{{ ui.empty_state("No release yet", "Deploy one to set anything.") }}

{% elif edit == "exposure" %}
{% call ui.panel("exposure", "Exposure") %}
  {% if org.manages %}
  {% call forms.form(here ~ "/release", csrf, autocomplete="off") %}
    {{ forms.hidden_field("part", "exposure") }}
    {{ forms.banner(banners.exposure) }}
    {{ forms.choice_field("exposure", "Who reaches it", exposures, form.exposure, error=errors.exposure, hint=public_hint) }}
    {{ forms.field("port", "Port", type="number", value=form.port, required=false, error=errors.port, hint="Empty: no port.", width="sm") }}
    {% call forms.actions(release_note, "layers") %}{{ cancel }}{{ ui.button("Save and release") }}{% endcall %}
  {% endcall %}
  {% else %}{{ readonly }}{% endif %}
{% endcall %}

{% elif edit == "copies" %}
{% call ui.panel("scale", "Copies") %}
  {% if org.manages %}
  {% call forms.form(here ~ "/copies", csrf) %}
    {{ forms.banner(banners.copies) }}
    {{ forms.stepper_field("copies", "Copies", settings.copies, max=20, error=errors.copies) }}
    {{ forms.toggle_field("auto_rollback", "Roll back a failed release on its own", checked=settings.auto_rollback == "on", hint="Off: a failed release stays in place.") }}
    {% call forms.actions("Saving applies at once, without a release.") %}{{ cancel }}{{ ui.button("Save") }}{% endcall %}
  {% endcall %}
  {% else %}{{ readonly }}{% endif %}
{% endcall %}

{% elif edit == "placement" %}
{% call ui.panel("placement", "Placement") %}
  {% if org.manages %}
  {% call forms.form(here ~ "/placement", csrf) %}
    {{ forms.banner(banners.placement) }}
    {% if errors.placement %}{{ forms.field_error(errors.placement) }}{% endif %}
    {{ forms.field("machines", "Machines", value=settings.machines, required=false, autocomplete="off", hint="Names, comma-separated. Empty: any.") }}
    {{ forms.pairs_field("labels", "Labels a machine must carry", pairs=settings.labels, blank=1, key_label="Key", value_label="Value") }}
    {% call forms.grid() %}
    {{ forms.select_field("kind", "Kind", [("", "Any"), ("own", "Your own"), ("hosted", "Hosted by grund")], selected=settings.kind) }}
    {{ forms.field("spread_by", "Spread over label", value=settings.spread_by, required=false, autocomplete="off", mono=true, hint="A label key, such as zone. Empty: machines.") }}
    {% endcall %}
    {% call forms.grid() %}
    {{ forms.field("near", "Near apps", value=settings.near, required=false, autocomplete="off", hint="Names, comma-separated.") }}
    {{ forms.field("apart", "Apart from apps", value=settings.apart, required=false, autocomplete="off", hint="Names, comma-separated.") }}
    {% endcall %}
    {{ forms.field("reschedule_after", "Replace after (seconds unreachable)", type="number", value=settings.reschedule_after, width="sm") }}
    {% call forms.actions("Saving applies at once, without a release. Copies that no longer match move one at a time.") %}{{ cancel }}{{ ui.button("Save") }}{% endcall %}
  {% endcall %}
  {% else %}{{ readonly }}{% endif %}
{% endcall %}

{% elif edit == "check" %}
{% call ui.panel("health", "Health check") %}
  {% if org.manages %}
  {% call forms.form(here ~ "/release", csrf, autocomplete="off") %}
    {{ forms.hidden_field("part", "check") }}
    {{ forms.banner(banners.check) }}
    {% call forms.grid() %}
      {{ forms.select_field("check", "Ready check", checks, form.check) }}
      {{ forms.field("check_path", "Path", value=form.check_path, required=false, error=errors.check, hint="For an HTTP check. Empty: /.", mono=true) }}
    {% endcall %}
    {% call forms.actions(release_note, "layers") %}{{ cancel }}{{ ui.button("Save and release") }}{% endcall %}
  {% endcall %}
  {% else %}{{ readonly }}{% endif %}
{% endcall %}

{% elif edit == "resources" %}
{% call ui.panel("resources", "Resources") %}
  {% if org.manages %}
  {% call forms.form(here ~ "/release", csrf, autocomplete="off") %}
    {{ forms.hidden_field("part", "resources") }}
    {{ forms.banner(banners.resources) }}
    {% call forms.grid() %}
      {{ forms.field("memory", "Memory (MiB)", type="number", value=form.memory, required=false, error=errors.memory, hint="Per copy. Empty: 512.", width="sm") }}
      {{ forms.field("cpu", "CPU (thousandths)", type="number", value=form.cpu, required=false, error=errors.cpu, hint="Per copy; 1000 is one CPU. Empty: 1000.", width="sm") }}
    {% endcall %}
    {% call forms.actions(release_note, "layers") %}{{ cancel }}{{ ui.button("Save and release") }}{% endcall %}
  {% endcall %}
  {% else %}{{ readonly }}{% endif %}
{% endcall %}

{% elif edit == "env" %}
{% call ui.panel("variables", "Environment variables") %}
  {% if org.manages %}
  {% call forms.form(here ~ "/release", csrf, autocomplete="off") %}
    {{ forms.hidden_field("part", "env") }}
    {{ forms.banner(banners.env) }}
    {{ forms.pairs_field("env", "Environment variables", form.env, error=errors.env, hint="Shown in the clear.") }}
    {% call forms.actions(release_note, "layers") %}{{ cancel }}{{ ui.button("Save and release") }}{% endcall %}
  {% endcall %}
  {% else %}{{ readonly }}{% endif %}
{% endcall %}

{% elif edit == "secrets" %}
{% call ui.panel("secrets", "Secrets") %}
  {% if secrets %}
  {% call lists.rows() %}
    {% for secret in secrets %}
    {% call(slot) lists.row(secret.variable or secret.name, secret.sub, icon_name="key", tone="muted") %}
      {%- if slot == "end" and org.manages and secret.variable %}{{ forms.post_button(app.base ~ "/secrets/remove", csrf, "Remove", kind="danger", size="sm", hidden={"variable": secret.variable}) }}{% endif -%}
    {% endcall %}
    {% endfor %}
  {% endcall %}
  {% endif %}
  {% if org.manages %}
  {% call forms.form(app.base ~ "/secrets", csrf, autocomplete="off") %}
    {{ forms.banner(banners.secrets, fields=[errors.variable, errors.value]) }}
    {% call forms.grid() %}
      {{ forms.field("variable", "Variable", value=variable, error=errors.variable, autocomplete="off", hint="An existing one gets the new value.", mono=true) }}
      {{ forms.field("value", "Value", type="password", autocomplete="new-password", error=errors.value, hint="Never shown again.") }}
    {% endcall %}
    {% call forms.actions("Saving or removing one makes release v" ~ next ~ ".", "layers") %}{{ cancel }}{{ ui.button("Save and release") }}{% endcall %}
  {% endcall %}
  {% else %}{{ readonly }}{% endif %}
{% endcall %}

{% elif edit == "domains" %}
{% call ui.panel("domains", "Custom domain") %}
  {% if app.domains %}
  {% call lists.rows() %}
    {% for domain in app.domains %}{{ lists.row(domain.name, domain.state_words, plain=true) }}{% endfor %}
  {% endcall %}
  {% endif %}
  {% if app.address %}
  {% call ui.para() %}Domains are added and bound on <a href="{{ app.domains_href }}">Domains</a>.{% endcall %}
  {% else %}
  {{ ui.para("Only an app with Public HTTP exposure can have one.") }}
  {% endif %}
{% endcall %}

{% elif edit == "volumes" %}
{% call ui.panel("volumes", "Volumes / storage") %}
  {{ ui.para("Volumes are not available yet.") }}
{% endcall %}

{% elif edit == "command" %}
{% call ui.panel("command-and-stop", "Command override") %}
  {% if org.manages %}
  {% call forms.form(here ~ "/release", csrf, autocomplete="off") %}
    {{ forms.hidden_field("part", "command") }}
    {{ forms.banner(banners.command) }}
    {{ forms.code_field("command", "Command", value=form.command, error=errors.command, rows=3, hint="One argument per line. Empty: the image's own.") }}
    {% call forms.grid() %}
      {{ forms.select_field("stop_signal", "Stop signal", signals, form.stop_signal or "SIGTERM", width="sm") }}
      {{ forms.field("stop_grace", "Grace (seconds)", type="number", value=form.stop_grace, required=false, error=errors.stop, hint="From the signal to a kill. Empty: 30.", width="sm") }}
    {% endcall %}
    {% call forms.actions(release_note, "layers") %}{{ cancel }}{{ ui.button("Save and release") }}{% endcall %}
  {% endcall %}
  {% else %}{{ readonly }}{% endif %}
{% endcall %}

{% elif edit == "file" %}
{% call ui.panel("as-file", file_name) %}
  {% if org.manages %}
  {% call forms.form(here ~ "/file", csrf, autocomplete="off") %}
    {{ forms.banner(banners.file) }}
    {{ forms.code_field("file", file_name, value=file, filename=file_name, rows=file_rows, error=errors.file, required=true, download=file_href, hint="Secret values are not in the file.") }}
    {% call forms.actions("Applying makes release v" ~ next ~ ".", "layers") %}{{ cancel }}{{ ui.button("Apply") }}{% endcall %}
  {% endcall %}
  {% else %}
  {{ ui.code(file, filename=file_name, download=file_href) }}
  {% endif %}
{% endcall %}

{% elif edit == "delete" and org.manages %}
{% call ui.panel("danger", "Delete " ~ app.name) %}
  {% call forms.form(app.base ~ "/delete", csrf, autocomplete="off") %}
    {{ forms.banner(banners.delete) }}
    {{ forms.field("confirm", "Type " ~ app.name ~ " to confirm", error=errors.confirm, autocomplete="off", width="md") }}
    {% call forms.actions("Cannot be undone.") %}{{ cancel }}{{ ui.button("Delete " ~ app.name, kind="danger") }}{% endcall %}
  {% endcall %}
{% endcall %}

{% else %}
{% call ui.panel("configured", "Configured") %}
  {% call lists.links() %}
    {% for item in items.configured %}{{ lists.link(here ~ "?edit=" ~ item.key, item.title, item.value, item.icon, "Edit" if org.manages else "View") }}{% endfor %}
  {% endcall %}
{% endcall %}
{% call ui.panel("more", "Add more") %}
  {% call lists.tiles() %}
    {% for item in items.more %}{{ lists.tile(here ~ "?edit=" ~ item.key, item.title) }}{% endfor %}
  {% endcall %}
{% endcall %}
{% if org.manages %}
{% call lists.links() %}{{ lists.link(here ~ "?edit=delete", "Delete " ~ app.name, icon_name="trash", danger=true) }}{% endcall %}
{% endif %}
{% endif %}
{% endcall %}
{% endblock %}
