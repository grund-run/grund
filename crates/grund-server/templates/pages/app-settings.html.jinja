{% extends "pages/app.html.jinja" %}
{% block tab %}
{% if org.manages %}
{% call ui.panel("scale", "Copies and rollback", "How many copies run, and what grund does when a release fails. Saved at once; no new release.") %}
  {% call forms.form(app.base ~ "/settings/copies", csrf, layout="") %}
    {{ forms.form_error(banners.copies) }}
    {% call forms.grid() %}
      {{ forms.stepper_field("copies", "Copies", settings.copies, max=20, error=errors.copies, hint="Number of app instances.") }}
      {{ forms.choice_field("auto_rollback", "When a release fails", rollback_choices, settings.auto_rollback) }}
    {% endcall %}
    {% call forms.actions() %}{{ ui.button("Save", kind="secondary") }}{% endcall %}
  {% endcall %}
{% endcall %}

{% call ui.panel("release", "Exposure, port and checks", "Saving makes a new release of the image v" ~ settings.number ~ " runs (" ~ settings.digest ~ "), so nothing else changes.") %}
  {% call forms.form(app.base ~ "/settings/release", csrf, layout="", autocomplete="off") %}
    {{ forms.form_error(banners.release) }}
    {% call forms.grid() %}
      {{ forms.choice_field("exposure", "Exposure", exposures, form.exposure, error=errors.exposure, hint=public_hint) }}
      {% call forms.grid() %}
        {{ forms.field("port", "Port", type="number", value=form.port, required=false, error=errors.port, hint="The port it listens on. Empty: none, for an app nothing calls.") }}
        {{ forms.select_field("check", "Ready check", checks, form.check) }}
        {{ forms.field("check_path", "Check path", value=form.check_path, required=false, error=errors.check, hint="For an HTTP check. Empty: /.") }}
      {% endcall %}
      {{ forms.textarea_field("env", "Environment variables", value=form.env, error=errors.env, hint="NAME=value, one per line. Put passwords in a secret.", mono=true) }}
    {% endcall %}
    {% call forms.actions() %}{{ ui.button("Save and release") }}{% endcall %}
  {% endcall %}
{% endcall %}
{% endif %}

{% call ui.panel("secrets", "Secrets", "Values the app reads as variables. Stored sealed and never shown again.") %}
  {% if secrets %}
  {% call lists.rows() %}
    {% for secret in secrets %}
    {% call(slot) lists.row(secret.variable or secret.name, secret.sub, icon_name="key", tone="muted") %}
      {%- if slot == "end" and org.manages and secret.variable %}{{ forms.post_button(app.base ~ "/secrets/remove", csrf, "Remove", kind="danger", size="sm", hidden={"variable": secret.variable}) }}{% endif -%}
    {% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No secrets.") }}
  {% endif %}
  {% if org.manages %}
  {% call forms.form(app.base ~ "/secrets", csrf, layout="row", autocomplete="off") %}
    {{ forms.form_error(banners.secrets) }}
    {{ forms.field("variable", "Variable", value=form.variable, error=errors.variable, autocomplete="off", hint="Such as API_KEY. An existing one gets a new value.") }}
    {{ forms.field("value", "Value", type="password", autocomplete="new-password", error=errors.value, hint="Never shown again, and never in a release or a log.") }}
    {{ ui.button("Store and release", kind="secondary") }}
  {% endcall %}
  {{ ui.hint("Storing or removing one makes a new release of the same image, so the copies get it.") }}
  {% endif %}
{% endcall %}

{% if file %}
{% call ui.panel("file", "As a file", "The newest release as grund.toml, for your repository. Deploying the file through the API makes the same app.") %}
  {{ ui.code_block(file, id="grund-toml") }}
{% endcall %}
{% endif %}

{% if org.manages %}
{% call ui.panel("danger", "Delete " ~ app.name, "Its copies stop and its name is free again. Its releases stay in the history. This cannot be undone.", danger=true) %}
  {% call forms.form(app.base ~ "/delete", csrf, layout="row", autocomplete="off") %}
    {{ forms.form_error(banners.delete) }}
    {{ forms.field("confirm", "Type " ~ app.name ~ " to confirm", error=errors.confirm, autocomplete="off") }}
    {{ ui.button("Delete " ~ app.name, kind="danger") }}
  {% endcall %}
{% endcall %}
{% endif %}
{% endblock %}
