{% extends "layout-app.html.jinja" %}
{% set title = "Machines" %}
{% block content %}
{{ ui.page_head("Machines") }}
{{ forms.banner(error, ok=notice) }}

{% if setup %}
{% call ui.section("setup", "Set up your machine", stack=true) %}
  {% if setup.install %}
  <p>On the machine, run this within {{ setup.minutes }} minutes. The code works once and is not shown again.</p>
  {{ ui.code(setup.install, id="setup-install", wrap=true, what="the command") }}
  {% call ui.para(kind="aside") %}With grund installed: <code>{{ setup.command }}</code>, then keep <code>grund agent</code> running.{% endcall %}
  {% else %}
  <p>On the machine, run this within {{ setup.minutes }} minutes, then keep <code>grund agent</code> running. The code works once and is not shown again.</p>
  {{ ui.code(setup.command, id="setup-command", wrap=true, what="the command") }}
  {% endif %}
{% endcall %}
{% endif %}

{% call lists.rows() %}
  {% for machine in machines %}
  {% set tags = (["grund machine"] if machine.leased else []) + (["Runs VMs"] if machine.kvm else []) %}
  {% set seen = "Connected" if machine.connected else ("Last seen " ~ machine.last_seen if machine.last_seen else "Not connected yet") %}
  {% call(slot) lists.row(machine.name, (machine.hostname or "") if machine.connected else seen ~ (" · " ~ machine.hostname if machine.hostname else ""), icon_name="server", tone="ok" if machine.connected else "muted", tags=tags, status="Connected" if machine.connected else "Offline", status_tone="ok" if machine.connected else "muted") %}
    {%- if slot == "end" and org.manages and not machine.leased %}{{ forms.post_button("/" ~ org.slug ~ "/machines/" ~ machine.id ~ "/remove", csrf, "Remove", kind="danger", size="sm") }}{% endif -%}
  {% endcall %}
  {% endfor %}
{% endcall %}
{% if not machines %}{{ ui.empty_state(text="No machines yet.") }}{% endif %}

{% if org.manages %}
{% call ui.panel("add", "Add a machine") %}
  {% call forms.form("/" ~ org.slug ~ "/machines/add", csrf, layout="row") %}
    {{ forms.banner(add_error) }}
    {{ forms.field("name", "Name", value=name, autocomplete="off", required=false, hint="Empty: its hostname.") }}
    {{ ui.button("Get a setup code") }}
  {% endcall %}
{% endcall %}
{% endif %}

{% call ui.section("vms", "Virtual machines", count=vms | length) %}
  {% if vms %}
  {% call lists.rows() %}
    {% for vm in vms %}
    {% call(slot) lists.row(vm.name, "on " ~ vm.host ~ " · " ~ vm.vcpus ~ " vCPU, " ~ vm.memory_mib ~ " MiB, " ~ vm.disk_gib ~ " GiB" ~ (" · " ~ vm.reason if vm.reason else ""), icon_name="grid", tone="violet", status=vm.observed, status_tone=vm.tone) %}
      {%- if slot == "end" and org.manages and vm.running %}{{ forms.post_button("/" ~ org.slug ~ "/machines/vms/" ~ vm.id ~ "/stop", csrf, "Stop", size="sm") }}{% endif -%}
    {% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No virtual machines yet.") }}
  {% endif %}
{% endcall %}

{% if org.manages %}
{% if hosts %}
{% call ui.panel("run", "Run a virtual machine") %}
  {% call forms.form("/" ~ org.slug ~ "/machines/vms", csrf) %}
    {{ forms.banner(run_error) }}
    {% call forms.grid() %}
    {{ forms.select_field("host", "On", hosts) }}
    {{ forms.field("vm_name", "Name", value=run.vm_name, autocomplete="off") }}
    {% endcall %}
    {% call forms.grid() %}
    {% call forms.grid() %}
    {{ forms.field("vcpus", "vCPUs", type="number", value=run.vcpus or "1") }}
    {{ forms.field("memory_mib", "Memory (MiB)", type="number", value=run.memory_mib or "1024") }}
    {% endcall %}
    {{ forms.field("disk_gib", "Disk (GiB)", type="number", value=run.disk_gib or "4", width="sm") }}
    {{ forms.field("kernel_url", "Kernel URL", value=run.kernel_url, autocomplete="off", mono=true) }}
    {{ forms.field("kernel_sha256", "Kernel SHA-256", value=run.kernel_sha256, autocomplete="off", mono=true) }}
    {{ forms.field("rootfs_url", "Root filesystem URL", value=run.rootfs_url, autocomplete="off", mono=true) }}
    {{ forms.field("rootfs_sha256", "Root filesystem SHA-256", value=run.rootfs_sha256, autocomplete="off", mono=true) }}
    {% endcall %}
    {% call forms.actions("grund fetches both files and checks them against their SHA-256.") %}{{ ui.button("Run it") }}{% endcall %}
  {% endcall %}
{% endcall %}
{% else %}
{% call ui.section("run", "Run a virtual machine") %}
  {{ ui.empty_state(text="That needs a connected machine with KVM.") }}
{% endcall %}
{% endif %}
{% endif %}
{% endblock %}
