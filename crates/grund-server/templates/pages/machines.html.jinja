{% extends "layout-app.html.jinja" %}
{% set title = "Machines" %}
{% block content %}
{% set base = "/" ~ org.slug ~ "/machines" %}
{{ ui.page_head("Machines") }}
{{ forms.banner(error, ok=notice) }}

{% if editing and org.manages %}
{% call ui.panel("labels", "Labels of " ~ editing.name) %}
  {% call forms.form(base ~ "/" ~ editing.id ~ "/labels", csrf) %}
    {{ forms.pairs_field("labels", "Labels", pairs=editing.pairs, blank=1, key_label="Key", value_label="Value", key_suggestions=label_keys, value_suggestions=label_values) }}
    {% call forms.actions("Copies on a machine that no longer matches their app move to one that does.") %}{{ ui.button("Save labels") }}{{ ui.button("Cancel", href=base, kind="secondary") }}{% endcall %}
  {% endcall %}
{% endcall %}
{% endif %}

{% if run_open and org.manages %}
{% call ui.panel("run", "Run a virtual machine") %}
  {% call forms.form(base ~ "/vms", csrf) %}
    {{ forms.banner(run_error) }}
    {% call forms.grid() %}
    {{ forms.chips_field("host", "On", hosts, run.host, multiple=false, search="Search machines") }}
    {{ forms.field("vm_name", "Name", value=run.vm_name, autocomplete="off") }}
    {% endcall %}
    {% call forms.grid() %}
    {% call forms.grid() %}
    {{ forms.field("vcpus", "vCPUs", type="number", value=run.vcpus or "1") }}
    {{ forms.field("memory_mib", "Memory (MiB)", type="number", value=run.memory_mib or "1024") }}
    {% endcall %}
    {{ forms.field("disk_gib", "Disk (GiB)", type="number", value=run.disk_gib or "4", width="sm") }}
    {{ forms.field("kernel_url", "Kernel URL", value=run.kernel_url, autocomplete="off", mono=true) }}
    {{ forms.field("kernel_sha256", "Kernel SHA-256", value=run.kernel_sha256, autocomplete="off", mono=true) }}
    {{ forms.field("rootfs_url", "Root filesystem URL", value=run.rootfs_url, autocomplete="off", mono=true) }}
    {{ forms.field("rootfs_sha256", "Root filesystem SHA-256", value=run.rootfs_sha256, autocomplete="off", mono=true) }}
    {% endcall %}
    {% call forms.actions("grund fetches both files and checks them against their SHA-256.") %}{{ ui.button("Run it") }}{{ ui.button("Cancel", href=base, kind="secondary") }}{% endcall %}
  {% endcall %}
{% endcall %}
{% endif %}

{% if machines or operator %}
{% call ui.tabs("Machines", tabs, tab, counts={"disconnected": disconnected}, filter=true) %}{{ forms.search(base, "Search machines", q=q, id="machine-search", hidden={"tab": tab}, filter=true) }}{% endcall %}
{% endif %}
{% if machines %}
{% call lists.items() %}{% for machine in machines %}{{ lists.machine_row(org, machine, csrf) }}{% endfor %}{% endcall %}
{{ ui.empty_state("No machines match", icon_name="search", filter_empty="match", hidden=shown or not q) }}
{{ ui.empty_state("No disconnected machines", icon_name="server", filter_empty="tab", hidden=shown or q or not tab) }}
{% else %}
{% call ui.empty_state("Add your first machine", icon_name="server") %}
  {% if org.manages %}{{ ui.button("Add machine", href=base ~ "/add", icon_name="plus", kind="secondary") }}{% endif %}
  {{ ui.external("https://git.kjuulh.io/grund/grund#self-hosting", "Learn more") }}
{% endcall %}
{% endif %}

{% if vms %}
{% call ui.section("vms", "Virtual machines", count=vms | length) %}
  {% call lists.rows() %}
    {% for vm in vms %}
    {% call(slot) lists.row(vm.name, "on " ~ vm.host ~ " · " ~ vm.vcpus ~ " vCPU, " ~ vm.memory_mib ~ " MiB, " ~ vm.disk_gib ~ " GiB" ~ (" · " ~ vm.reason if vm.reason else ""), icon_name="grid", tone="violet", status=vm.observed, status_tone=vm.tone) %}
      {%- if slot == "end" and org.manages and vm.running %}{{ forms.post_button(base ~ "/vms/" ~ vm.id ~ "/stop", csrf, "Stop", size="sm") }}{% endif -%}
    {% endcall %}
    {% endfor %}
  {% endcall %}
{% endcall %}
{% endif %}
{% endblock %}
