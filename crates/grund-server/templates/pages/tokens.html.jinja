{% extends "layout-app.html.jinja" %}
{% set org = viewer.current %}
{% block title %}API tokens · {{ org.slug }} · grund{% endblock %}
{% block content %}
{{ ui.page_head("Organisation", status="Tokens let CI and scripts call grund's API as you, in " ~ org.slug ~ " only. A token can do what your role here allows, except delete apps and change the organisation.") }}
{{ ui.org_tabs(org, "tokens") }}
{{ forms.form_ok(notice) }}
{{ forms.form_error(error) }}

{% if minted %}
{% call ui.section("new-token", "Your new token: " ~ minted.name, stack=true) %}
  <p>Copy it now and keep it in your CI's secrets. grund keeps only a digest of it and cannot show it again. It works until {{ minted.expires }}, or until it is revoked.</p>
  {{ ui.command(minted.token, id="new-token-value", copy=true) }}
  <p>To deploy from CI, with the token in <code>GRUND_TOKEN</code>:</p>
  {{ ui.command(minted.example, id="new-token-example", copy=true) }}
{% endcall %}
{% endif %}

{% call ui.section("tokens", "Live tokens" if org.manages else "Your live tokens", count=tokens | length) %}
  {% if tokens %}
  {% call lists.rows() %}
    {% for token in tokens %}
    {% call(slot) lists.row(token.name, "by " ~ token.by ~ " · made " ~ token.created ~ " · expires " ~ token.expires ~ " · " ~ token.used, icon_name="key", tone="violet", tags=["Yours"] if token.mine and org.manages else []) %}
      {%- if slot == "end" %}{{ forms.post_button("/" ~ org.slug ~ "/settings/tokens/" ~ token.id ~ "/revoke", csrf, "Revoke", kind="danger", size="sm") }}{% endif -%}
    {% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No live tokens.") }}
  {% endif %}
{% endcall %}

{% call ui.section("create", "Make a token") %}
  {% call forms.form("/" ~ org.slug ~ "/settings/tokens", csrf, layout="row", autocomplete="off") %}
    {{ forms.form_error(create_error) }}
    {{ forms.field("name", "Name", value=name, autocomplete="off", hint="What uses it, such as the repository or CI job. Up to 64 characters.") }}
    {{ forms.select_field("days", "Expires after", lifetimes, days, id="token-days") }}
    {{ ui.button("Make a token", icon_name="key") }}
  {% endcall %}
  {{ ui.hint("An organisation holds at most " ~ max_live ~ " live tokens.") }}
{% endcall %}
{% endblock %}
