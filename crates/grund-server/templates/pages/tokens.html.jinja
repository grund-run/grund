{% extends "pages/organisation.html.jinja" %}
{% set title = "API tokens" %}
{% set tab = "tokens" %}
{% block tab %}
{% if minted %}
{% call ui.section("new-token", "Your new token: " ~ minted.name, stack=true) %}
  <p>Copy it now: it is not shown again. It works until {{ minted.expires }}.</p>
  {{ ui.code(minted.token, id="new-token-value", wrap=true, what="the token") }}
  <p>To deploy from CI, with the token in <code>GRUND_TOKEN</code>:</p>
  {{ ui.code(minted.example, id="new-token-example", wrap=true, what="the command") }}
{% endcall %}
{% endif %}

{% call ui.section("tokens", "Live tokens" if org.manages else "Your live tokens", count=tokens | length) %}
  {% if tokens %}
  {% call lists.rows() %}
    {% for token in tokens %}
    {% call(slot) lists.row(token.name, "by " ~ token.by ~ " · made " ~ token.created ~ " · expires " ~ token.expires ~ " · " ~ token.used, icon_name="key", tone="violet", tags=["Yours"] if token.mine and org.manages else []) %}
      {%- if slot == "end" %}{{ forms.post_button("/" ~ org.slug ~ "/settings/tokens/" ~ token.id ~ "/revoke", csrf, "Revoke", kind="danger", size="sm") }}{% endif -%}
    {% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No live tokens.") }}
  {% endif %}
{% endcall %}

{% call ui.panel("create", "Make a token") %}
  {% call forms.form("/" ~ org.slug ~ "/settings/tokens", csrf, layout="row", autocomplete="off") %}
    {{ forms.banner(create_error) }}
    {{ forms.field("name", "Name", value=name, autocomplete="off", hint="Up to 64 characters.") }}
    {{ forms.chips_field("days", "Expires after", lifetimes, days, multiple=false) }}
    {{ ui.button("Make a token") }}
  {% endcall %}
{% endcall %}
{% endblock %}
