{% extends "layout-app.html.jinja" %}
{% set org = viewer.current %}
{% block title %}Organisation · {{ org.slug }} · grund{% endblock %}
{% block head %}{% if deleting %}<meta http-equiv="refresh" content="3">{% endif %}{% endblock %}
{% block content %}
{{ ui.page_head("Organisation", status="What " ~ org.slug ~ " is, who is in it, and who pays for what it runs.") }}
{{ ui.org_tabs(org, "general") }}
{{ forms.form_ok(notice) }}
{% call lists.rows() %}
  {% call(slot) lists.row("Name", org.slug, plain=true) %}{% if slot == "end" %}{{ ui.hint("Owners can rename it below." if org.owner else "Owners can rename it.") }}{% endif %}{% endcall %}
  {{ lists.row("Created", org.since, plain=true) }}
  {{ lists.row("Your role", org.role, plain=true) }}
{% endcall %}

{% call ui.section("billing", "Billing") %}
  {% call lists.rows() %}
    {% if billing.state == "unavailable" %}
    {% call(slot) lists.row("Plan", "Billing is unavailable right now", plain=true) %}{% if slot == "end" %}{{ ui.hint("Nothing else is affected. Try again in a few minutes.") }}{% endif %}{% endcall %}
    {% else %}
    {% call(slot) lists.row("Plan", billing.plan, plain=true) %}
      {%- if slot == "end" %}
        {%- if billing.state == "free" %}{{ ui.hint("Nothing is charged. Billing belongs to " ~ org.slug ~ ", never to a person.") }}
        {%- elif billing.past_due %}{{ forms.field_error("A payment failed. " ~ ("Update the payment details." if org.owner else "An owner needs to update the payment details.")) }}{% endif %}
      {%- endif -%}
    {% endcall %}
    {% endif %}
    {% call(slot) lists.row("Managed by", owners | join(", "), plain=true) %}
      {%- if slot == "end" %}
        {%- if org.owner and billing.manage_url %}{{ ui.link_more(billing.manage_url, "Manage billing") }}
        {%- else %}{{ ui.hint("Owners manage billing.") }}{% endif %}
      {%- endif -%}
    {% endcall %}
  {% endcall %}
{% endcall %}

{% if org.owner %}
{% call ui.section("rename", "Rename") %}
  {% call forms.form("/" ~ org.slug ~ "/settings/rename", csrf, layout="narrow") %}
    {{ forms.field("slug", "New name", value=rename_value, autocomplete="off", error=rename_error, hint="3 to 32 letters, digits and single hyphens. The old name stays reserved for this organisation and redirects its members.") }}
    {{ ui.button("Rename", kind="secondary") }}
  {% endcall %}
{% endcall %}

{% call ui.section("delete", "Delete") %}
  {% if deleting %}
  {{ ui.callout("Deleting " ~ org.slug, "Waiting for billing to agree. If billing cannot be reached, grund keeps asking; nothing is deleted until it answers. This page refreshes itself.", icon_name="clock", tone="orange") }}
  {{ forms.post_button("/" ~ org.slug ~ "/settings/cancel-deletion", csrf, "Cancel the deletion", layout="narrow") }}
  {% else %}
  {{ forms.form_error(refusal) }}
  {{ ui.status_line("Deleting ends every membership and invitation, and cannot be undone. The name stays reserved.", plain=true) }}
  {% call forms.form("/" ~ org.slug ~ "/settings/delete", csrf, layout="narrow") %}
    {{ forms.field("confirm", "Type " ~ org.slug ~ " to confirm", autocomplete="off", error=delete_error) }}
    {{ ui.button("Delete " ~ org.slug, kind="danger") }}
  {% endcall %}
  {% endif %}
{% endcall %}
{% endif %}
{% endblock %}
