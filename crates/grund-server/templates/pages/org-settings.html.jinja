{% extends "pages/organisation.html.jinja" %}
{% set title = "Organisation" %}
{% set tab = "general" %}
{% block head %}{% if deleting %}<meta http-equiv="refresh" content="3">{% endif %}{% endblock %}
{% block tab %}
{% call lists.rows() %}
  {% call(slot) lists.row("Name", org.slug, plain=true) %}{% if slot == "end" and not org.owner %}{{ ui.para("Owners can rename it.") }}{% endif %}{% endcall %}
  {{ lists.row("Created", org.since, plain=true) }}
  {{ lists.row("Your role", org.role, plain=true) }}
{% endcall %}

{% call ui.section("billing", "Billing") %}
  {% call lists.rows() %}
    {% if billing.state == "unavailable" %}
    {% call(slot) lists.row("Plan", "Billing is unavailable right now", plain=true) %}{% if slot == "end" %}{{ ui.para("Try again in a few minutes.") }}{% endif %}{% endcall %}
    {% else %}
    {% call(slot) lists.row("Plan", billing.plan, plain=true) %}
      {%- if slot == "end" %}
        {%- if billing.state == "free" %}{{ ui.para("Nothing is charged.") }}
        {%- elif billing.past_due %}{{ forms.field_error("A payment failed. " ~ ("Update the payment details." if org.owner else "An owner needs to update the payment details.")) }}{% endif %}
      {%- endif -%}
    {% endcall %}
    {% endif %}
    {% call(slot) lists.row("Managed by", owners | join(", "), plain=true) %}
      {%- if slot == "end" %}
        {%- if org.owner and billing.manage_url %}{{ ui.link_more(billing.manage_url, "Manage billing") }}
        {%- else %}{{ ui.para("Owners manage billing.") }}{% endif %}
      {%- endif -%}
    {% endcall %}
  {% endcall %}
{% endcall %}

{% if org.owner %}
{% call ui.section("change", "Change") %}
{% call ui.expanders() %}
  {% call ui.expander("Name", org.slug, icon_name="gear", open=rename_error != "", id="rename") %}
    {% call forms.form("/" ~ org.slug ~ "/settings/rename", csrf) %}
      {{ forms.field("slug", "New name", value=rename_value, autocomplete="off", error=rename_error, hint="3 to 32 letters, digits and single hyphens.", width="md") }}
      {% call forms.actions("The old name stays reserved and redirects to the new one.") %}{{ ui.button("Rename") }}{% endcall %}
    {% endcall %}
  {% endcall %}
  {% call ui.expander("Delete " ~ org.slug, "Cannot be undone.", icon_name="trash", kind="danger", open=deleting or refusal != "" or delete_error != "", id="delete") %}
    {% if deleting %}
    {{ ui.callout("Deleting " ~ org.slug, "Waiting for billing. Nothing is deleted until it answers.", icon_name="clock", tone="orange") }}
    {% call forms.actions() %}{{ forms.post_button("/" ~ org.slug ~ "/settings/cancel-deletion", csrf, "Cancel the deletion") }}{% endcall %}
    {% else %}
    {% call forms.form("/" ~ org.slug ~ "/settings/delete", csrf) %}
      {{ forms.banner(refusal) }}
      {{ forms.field("confirm", "Type " ~ org.slug ~ " to confirm", autocomplete="off", error=delete_error, width="md") }}
      {% call forms.actions("The name stays reserved.") %}{{ ui.button("Delete " ~ org.slug, kind="danger") }}{% endcall %}
    {% endcall %}
    {% endif %}
  {% endcall %}
{% endcall %}
{% endcall %}
{% endif %}
{% endblock %}
