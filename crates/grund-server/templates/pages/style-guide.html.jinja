{% extends "layout-app.html.jinja" %}
{% import "components/images.html.jinja" as images %}
{% block title %}Style guide · grund{% endblock %}
{% block content %}
{{ images.sprite(icons) }}
<div class="page-head">
  <div>
    <h1 class="page-title">Style guide</h1>
    <p class="status-line">{{ ui.icon("ok", "tone-ok") }}Every component, as the product renders it. Names and figures are examples.</p>
  </div>
  <span class="btn btn-primary">{{ ui.icon("plus") }}Primary action</span>
</div>

<section class="section" aria-labelledby="sg-colour">
  <div class="section-head"><h2 class="section-title" id="sg-colour">Colour</h2></div>
  <ul class="sg-swatches">
    {% for swatch in swatches %}
    <li class="sg-swatch"><div class="sg-chip sg-{{ swatch.0 }}"></div><code>--{{ swatch.0 }}</code><br><span class="hint">{{ swatch.1 }}</span></li>
    {% endfor %}
  </ul>
</section>

<section class="section" aria-labelledby="sg-buttons">
  <div class="section-head"><h2 class="section-title" id="sg-buttons">Buttons and links</h2></div>
  <div class="sg-row">
    <span class="btn btn-primary">{{ ui.icon("plus") }}Deploy application</span>
    <span class="btn btn-secondary">Secondary</span>
    <span class="btn btn-danger btn-sm">Sign out</span>
    <a class="link-more" href="#sg-buttons">View all{{ ui.icon("arrow", "icon-sm") }}</a>
  </div>
</section>

<section class="section" aria-labelledby="sg-callout">
  <div class="section-head"><h2 class="section-title" id="sg-callout">Callout</h2></div>
  <div class="callout">
    <span class="spinner" aria-hidden="true"></span>
    <div class="callout-body">
      <p class="callout-title">Storefront is updating</p>
      <p class="callout-text">Checking the new release. Current version is serving traffic.</p>
    </div>
    <a class="link-more" href="#sg-callout">View rollout{{ ui.icon("arrow", "icon-sm") }}</a>
  </div>
</section>

<section class="section" aria-labelledby="sg-rows">
  <div class="section-head">
    <h2 class="section-title" id="sg-rows">Applications<span class="count">3</span></h2>
    <a class="link-more" href="#sg-rows">View all{{ ui.icon("arrow", "icon-sm") }}</a>
  </div>
  <ul class="rows">
    <li class="row"><span class="row-icon">{{ ui.icon("box", "icon-lg tone-orange") }}</span><div><p class="row-name">Storefront</p><p class="row-sub">shop.nord.example</p></div>{{ ui.status("Serving") }}<span class="row-end">{{ ui.icon("chevron") }}</span></li>
    <li class="row"><span class="row-icon">{{ ui.icon("bars", "icon-lg tone-blue") }}</span><div><p class="row-name">Plausible</p><p class="row-sub">stats.nord.example</p></div>{{ ui.status("Serving") }}<span class="row-end">{{ ui.icon("chevron") }}</span></li>
    <li class="row"><span class="row-icon">{{ ui.icon("code", "icon-lg tone-violet") }}</span><div><p class="row-name">Customer API</p><p class="row-sub">api.nord.example</p></div>{{ ui.status("Serving") }}<span class="row-end">{{ ui.icon("chevron") }}</span></li>
  </ul>
  <p class="notice">{{ ui.icon("box", "tone-orange") }}An update is available for Plausible.<a class="link-more" href="#sg-rows">Review update{{ ui.icon("arrow", "icon-sm") }}</a></p>
  <ul class="stats">
    <li>{{ ui.icon("server", "icon-sm") }}3 servers online</li>
    <li>{{ ui.icon("globe", "icon-sm") }}4 domains connected</li>
  </ul>
</section>

<section class="section" aria-labelledby="sg-apps">
  <div class="section-head"><h2 class="section-title" id="sg-apps">Lists of things</h2></div>
  <p class="sg-caption">Macros in <code>components/ui.html.jinja</code>, each with its parameters documented there. <code>page_head</code> with a <code>{% raw %}{% call %}{% endraw %}</code> body for its tools, <code>list_tools</code> (sort as a GET form the script submits on change; the grid/list toggle as two links), <code>items</code> around <code>app_row</code>s, <code>add_card</code> under them. The top bar's search filters the list as you type. A new page is these plus <code>empty_state</code> and <code>button</code>, with no CSS of its own.</p>
  {% call ui.page_head("Apps", "Run and manage your applications. Simple, powerful, yours.") %}
  {{ ui.list_tools([("name", "Name"), ("deployed", "Last deployed"), ("created", "Newest")], "name", "#sg-apps", "#sg-apps", "list") }}
  {% endcall %}
  {% call ui.items() %}{% for app in apps %}{{ ui.app_row(viewer.current, app) }}{% endfor %}{% endcall %}
  <p class="sg-caption">Each row: the image's icon, the name over the image, then the address. A public app shows its HTTPS address, which opens in a new tab; any other app with a port shows <code>&lt;app&gt;.grund.internal:&lt;port&gt;</code> with <code>copy_button</code> (shown only when the script runs; the text selects with one click without it). <code>menu</code> and <code>menu_item</code> make the kebab: open, details, releases, and for owners and admins deploy, scale and delete, which lead to the app's page.</p>
  {% call ui.items("grid") %}{% for app in apps[:3] %}{{ ui.app_row(viewer.current, app) }}{% endfor %}{% endcall %}
  {{ ui.add_card("#sg-apps", "Deploy a new app", "Deploy any container image by its name, such as nginx:1.27.") }}
  <p class="sg-caption">Image icons (<code>image_icon</code>, sprite in <code>components/images.html.jinja</code>): well-known images get their own, any other Docker Hub image the whale, and an image from another registry the neutral box.</p>
  <ul class="sg-images">
    {% for key in gallery %}<li>{{ ui.image_icon(key) }}<code>{{ key }}</code></li>{% endfor %}
    <li>{{ ui.image_icon("docker") }}<code>docker</code></li>
    <li>{{ ui.image_icon("image") }}<code>image</code></li>
  </ul>
  <div class="sg-row">
    {{ ui.button("Primary", icon_name="plus") }}
    {{ ui.button("Secondary", kind="secondary") }}
    {{ ui.button("Danger", kind="danger", size="sm") }}
    {{ ui.button("Collapses on phones", href="#sg-apps", icon_name="plus", collapse=true) }}
  </div>
</section>

<section class="section" aria-labelledby="sg-forms">
  <div class="section-head"><h2 class="section-title" id="sg-forms">Forms</h2></div>
  <div class="auth-card">
    <div class="form">
      {{ ui.form_ok("Your email is confirmed. Sign in to continue.") }}
      {{ ui.form_error("That email, username or password is not right.") }}
      {{ ui.field("sg-email", "Email", type="email", hint="We send a link to confirm it.", required=false) }}
      {{ ui.field("sg-password", "Password", type="password", error="Use at least 12 characters.", required=false) }}
      <span class="btn btn-primary btn-block">Sign in</span>
    </div>
  </div>
  <p class="sg-caption">Tags: <span class="tag">Soon</span> <span class="tag tag-ok">Current</span></p>
</section>

<section class="section" aria-labelledby="sg-orgs">
  <div class="section-head"><h2 class="section-title" id="sg-orgs">Organisations</h2></div>
  {{ ui.org_tabs(viewer.current, "members") }}
  <p class="sg-caption">Tabs split one sidebar section into pages (the organisation's General and Members), so the sidebar keeps one item per area. The switcher tops the sidebar: the current organisation and the viewer's role, and a menu of the others (a <code>&lt;details&gt;</code>, so it needs no script). Members are listed as rows; an owner or admin gets a role select and a remove button on each row they may change.</p>
  <ul class="rows">
    <li class="row">
      <span class="row-icon"><span class="org-mark org-mark-lg" aria-hidden="true">a</span></span>
      <div><p class="row-name">ada <span class="tag">You</span></p><p class="row-sub">ada@nord.studio · joined 2 Sep 2026</p></div>
      {{ ui.status("Owner") }}
      <span class="row-end"><span class="btn btn-ghost btn-sm">Leave</span></span>
    </li>
    <li class="row">
      <span class="row-icon"><span class="org-mark org-mark-lg" aria-hidden="true">l</span></span>
      <div><p class="row-name">linus</p><p class="row-sub">linus@nord.studio · joined 9 Sep 2026</p></div>
      <div class="row-form">
        <label class="visually-hidden" for="sg-role">Role of linus</label>
        <select class="select" id="sg-role"><option>Member</option><option selected>Admin</option><option>Owner</option></select>
        <span class="btn btn-secondary btn-sm">Change</span>
      </div>
      <span class="row-end"><span class="btn btn-danger btn-sm">Remove</span></span>
    </li>
    <li class="row">
      <span class="row-icon">{{ ui.icon("mail", "icon-lg tone-violet") }}</span>
      <div><p class="row-name">grace@nord.studio</p><p class="row-sub">invited by ada · expires 2 Oct 2026</p></div>
      {{ ui.status("Member", "muted") }}
      <span class="row-end"><span class="btn btn-danger btn-sm">Withdraw</span></span>
    </li>
  </ul>
</section>

<section class="section" aria-labelledby="sg-empty">
  <div class="section-head"><h2 class="section-title" id="sg-empty">Empty state</h2></div>
  {{ ui.empty_state("No applications yet", "Deploy one and it shows up here.") }}
</section>
{% endblock %}
