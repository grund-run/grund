{% extends "pages/organisation.html.jinja" %}
{% set title = "Registries" %}
{% set tab = "registries" %}
{% set lede = "Logins to the registries " ~ viewer.current.slug ~ "'s private images come from. grund uses one to resolve a tag when you deploy, and gives it to a machine only to pull an image of an app placed on it." %}
{% block tab %}
{% call ui.section("credentials", "Registries with a login", count=credentials | length) %}
  {% if credentials %}
  {% call lists.rows() %}
    {% for credential in credentials %}
    {% call(slot) lists.row(credential.host, "as " ~ credential.username ~ " · " ~ credential.updated, icon_name="lock", tone="violet") %}
      {%- if slot == "end" and org.manages %}{{ forms.post_button("/" ~ org.slug ~ "/settings/registries/remove", csrf, "Remove", kind="danger", size="sm", hidden={"host": credential.host}) }}{% endif -%}
    {% endcall %}
    {% endfor %}
  {% endcall %}
  {% else %}
  {{ ui.empty_state(text="No registry logins. Public images need none.") }}
  {% endif %}
{% endcall %}

{% if org.manages %}
{% call ui.panel("set", "Add or replace a login", "An organisation holds logins for at most " ~ max ~ " registries.") %}
  {% call forms.form("/" ~ org.slug ~ "/settings/registries", csrf, autocomplete="off") %}
    {{ forms.banner(form_error, fields=[host_error, username_error, password_error]) }}
    {{ forms.field("host", "Registry", value=host, autocomplete="off", error=host_error, hint="The host your image names start with: ghcr.io, registry.gitlab.com, or docker.io for Docker Hub.", width="md", mono=true) }}
    {% call forms.grid() %}
    {{ forms.field("username", "Username", value=username, autocomplete="off", error=username_error) }}
    {{ forms.field("password", "Password or access token", type="password", autocomplete="new-password", error=password_error, hint="Prefer a token that can only read packages. Stored sealed, never shown again.") }}
    {% endcall %}
    {% call forms.actions("Saving a registry that has a login replaces it.") %}{{ ui.button("Save login") }}{% endcall %}
  {% endcall %}
{% endcall %}
{% endif %}
{% endblock %}
