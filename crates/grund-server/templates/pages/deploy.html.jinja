{% extends "layout-app.html.jinja" %}
{% import "components/images.html.jinja" as images %}
{% set title = "Deploy app" %}
{% block content %}
{{ images.sprite(image_keys) }}
{{ ui.page_head("Deploy app", back=("/" ~ org.slug ~ "/apps", "Back to apps")) }}
{% if org.manages %}
{{ ui.choice_links("Deployment mode", modes, mode) }}
{% call forms.form(action, csrf, autocomplete="off") %}
  {{ forms.hidden_field("mode", mode) }}
  {% if mode == "premade" %}
  {% call ui.panel("premade", "Premade app") %}
    {{ forms.banner(new_error) }}
    {{ forms.choice_field("template", "App", templates, new.template, error=errors.template, large=true, fill="name") }}
    {% call forms.grid() %}
      {{ forms.field("name", "Name", value=new.name, error=errors.name, hint="Lowercase letters, digits and -.") }}
      {{ forms.stepper_field("copies", "Copies", new.copies or "1", max=20, error=errors.copies) }}
      {{ forms.choice_field("exposure", "Exposure", exposures, new.exposure or "private", error=errors.exposure, hint=public_hint) }}
    {% endcall %}
  {% endcall %}
  {% else %}
  {% call ui.panel("custom", "Custom deployment") %}
    {{ forms.banner(new_error) }}
    {% call forms.grid() %}
      {{ forms.field("name", "Name", value=new.name, error=errors.name, hint="Lowercase letters, digits and -.") }}
      {{ forms.field("image", "Image", value=new.image, error=errors.image, hint="Such as nats:2.10 or ghcr.io/org/app:latest. The tag is resolved now.") }}
      {{ forms.choice_field("exposure", "Exposure", exposures, new.exposure or "private", error=errors.exposure, hint=public_hint) }}
      {% call forms.grid() %}
        {{ forms.field("port", "Port", type="number", value=new.port, required=false, error=errors.port, hint="Empty: from the image.") }}
        {{ forms.stepper_field("copies", "Copies", new.copies or "1", max=20, error=errors.copies) }}
      {% endcall %}
    {% endcall %}
    {% call ui.expanders() %}
    {% call ui.expander("Advanced options", "Environment variables, secrets, ready check, resources and command.", icon_name="gear", open=advanced) %}
      {{ forms.pairs_field("env", "Environment variables", new.env, error=errors.env, hint="Shown in the clear.") }}
      {{ forms.pairs_field("secrets", "Secrets", error=errors.secrets, secret=true, hint=("Enter them again: a refused form never shows a secret. " if secrets_dropped else "") ~ "Never shown again.") }}
      {% call forms.grid() %}
        {{ forms.chips_field("check", "Ready check", checks, new.check, multiple=false) }}
        {{ forms.field("check_path", "Check path", value=new.check_path, required=false, error=errors.check, hint="For an HTTP check. Empty: /.", mono=true) }}
        {{ forms.field("memory", "Memory", type="number", value=new.memory, required=false, error=errors.memory, hint="Per copy. Empty: 512.", unit="MiB", min=16, max=262144, suggestions=memory_steps) }}
        {{ forms.field("cpu", "CPU", type="number", value=new.cpu, required=false, error=errors.cpu, hint="Per copy. Empty: 1.", unit="vCPU", min=0.01, max=64, step="any", suggestions=cpu_steps) }}
        {{ forms.chips_field("stop_signal", "Stop signal", signals, new.stop_signal or "SIGTERM", multiple=false) }}
        {{ forms.field("stop_grace", "Grace (seconds)", type="number", value=new.stop_grace, required=false, error=errors.stop, hint="From the signal to a kill. Empty: 30.", width="sm") }}
      {% endcall %}
      {{ forms.code_field("command", "Command", value=new.command, error=errors.command, rows=3, hint="One argument per line. Empty: the image's own.") }}
      {{ ui.para("Volumes are not available yet: a replaced copy keeps nothing on disk.") }}
    {% endcall %}
    {% endcall %}
  {% endcall %}
  {% endif %}
  {% call forms.actions("Deploying makes the app and its first release.", "layers") %}{{ ui.button("Cancel", href="/" ~ org.slug ~ "/apps", kind="secondary") }}{{ ui.button("Deploy app") }}{% endcall %}
{% endcall %}
{% else %}
{{ ui.empty_state("Your role does not deploy apps", "Owners and admins deploy them.") }}
{% endif %}
{% endblock %}
