use crate::templates::compiled::components::{PageHead, Tabs, Banner, Section, Rows, Row, EmptyState, Facts, Fact, IconFact, Expanders, Expander, Form, Field, HiddenField, Button, PostButton, Panel, Actions, LinkMore, RowPill, ShortId, RelativeTime, CopyButton, ChoiceField, ChoiceCard, Para, External};
props crate::web::admin::AdminPage<'_> { slug, csrf, manages, tab, host_filter, retired_count, now, hosts, selected_host, machines, pools, failures, events, leases, organisations, available, leased, next_page, next_machines_page, organisation, entitlement, billing, billing_enabled, grant_key, revoke_key, error, notice };

<PageHead title="Admin" />
{let hosts_url = format!("/{slug}/admin");}
{let pool_url = format!("/{slug}/admin?tab=pool");}
{let leases_url = format!("/{slug}/admin?tab=leases");}
{let failures_url = format!("/{slug}/admin?tab=failures");}
{let events_url = format!("/{slug}/admin?tab=events");}
{let organisations_url = format!("/{slug}/admin?tab=organisations");}
<Tabs label="Admin" tabs={&[("hosts", hosts_url.as_str(), "Hosts", "server"), ("pool", pool_url.as_str(), "Pool", "layers"), ("leases", leases_url.as_str(), "Leases", "key"), ("failures", failures_url.as_str(), "Failures", "alert"), ("events", events_url.as_str(), "Events", "clock"), ("organisations", organisations_url.as_str(), "Organisations", "users")]} active={tab} />
{if !notice.is_empty() { <Banner text={notice} tone="ok" /> }}
{if !error.is_empty() { <Banner text={error} /> }}
{if *tab == "hosts" {
  {let active_url = format!("/{slug}/admin");}
  {let retired_url = format!("/{slug}/admin?host_filter=retired");}
  <Tabs label="Hosts" tabs={&[("active", active_url.as_str(), "Active", ""), ("retired", retired_url.as_str(), "Retired", "")]} counts={&[("active", hosts.len() - retired_count), ("retired", *retired_count)]} active={host_filter} />
  <Section id="hosts" title="Hosts" count={Some(if *host_filter == "retired" { *retired_count } else { hosts.len() - retired_count })}>
    {if hosts.is_empty() && error.is_empty() { <EmptyState text="No hosts reported." /> }}
    {if !hosts.is_empty() && hosts.iter().all(|host| (host.state == "retired") != (*host_filter == "retired")) && error.is_empty() { <EmptyState text={if *host_filter == "retired" { "No retired hosts." } else { "No active hosts." }} /> }}
    <Rows>{for item in hosts.iter().filter(|host| (host.state == "retired") == (*host_filter == "retired")) {
      {let href = format!("{}&host_filter={host_filter}", crate::web::admin::host_url(slug, &item.id, "", ""));}
      {let (word, tone) = crate::web::admin::fleet_state(&item.state);}
      {let retired = item.state == "retired";}
      {let cpu = if retired { format!("{} vCPU", item.vcpus) } else { format!("vCPU {}/{}", item.allocated_vcpus, item.vcpus) };}
      {let ram = if retired { format!("{} GB RAM", crate::web::admin::gb(item.memory_mib)) } else { format!("RAM {}/{} GB", crate::web::admin::gb(item.allocated_memory_mib), crate::web::admin::gb(item.memory_mib)) };}
      {let disk = if retired { format!("{} GB disk", item.disk_gib) } else { format!("Disk {}/{} GB", item.allocated_disk_gib, item.disk_gib) };}
      <Row name={if item.name.is_empty() { crate::templates::short_id(&item.id) } else { crate::web::admin::host_name(item) }} sub="" icon_name="server" tone={tone} href={href.as_str()}>
        <:name_suffix>{if retired && !item.name.is_empty() { <ShortId text={&item.id} label="the host identifier" /> }}</:name_suffix>
        <:sub_content>{item.provider} · {item.region} · <IconFact icon_name="cpu" text={&cpu} />{" · "}<IconFact icon_name="memory" text={&ram} />{" · "}<IconFact icon_name="disk" text={&disk} /> · {item.machine_count} VMs</:sub_content>
        <:status><RowPill text={word} tone={tone} /></:status>
        <:end>{if item.name.is_empty() { <CopyButton text={&item.id} label="the host identifier" /> }}</:end>
      </Row>
    }}</Rows>
  </Section>
  {if let Some(item) = selected_host.and_then(|index| hosts.get(index)) {
    {let (word, tone) = crate::web::admin::fleet_state(&item.state);}
    <Section id="host-detail" title={if item.name.is_empty() { crate::templates::short_id(&item.id) } else { crate::web::admin::host_name(item) }}>
      <Facts>
        <Fact label="State" value={word} tone={tone} />
        <Fact label="Reachable" value={if item.reachable { "Yes" } else { "No" }} />
        <Fact label="Free vCPU" value={format!("{} of {}", i128::from(item.vcpus) - i128::from(item.allocated_vcpus), item.vcpus)} />
        <Fact label="Free RAM" value={format!("{} of {} MiB", i128::from(item.memory_mib) - i128::from(item.allocated_memory_mib), item.memory_mib)} />
        <Fact label="Free disk" value={format!("{} of {} GiB", i128::from(item.disk_gib) - i128::from(item.allocated_disk_gib), item.disk_gib)} />
        <Fact label="Kernel" value={if item.host_kernel.is_empty() { "Not reported" } else { &item.host_kernel }} />
        <Fact label="Firecracker" value={if item.firecracker_version.is_empty() { "Not reported" } else { &item.firecracker_version }} />
        <Fact label="Last seen" value="">
          <RelativeTime value={&item.last_heartbeat_at} now={*now} />
        </Fact>
        {if !item.cordon_reason.is_empty() { <Fact label="Cordon reason" value={&item.cordon_reason} /> }}
      </Facts>
      {if *manages {
        <Expanders>
          <Expander title="Host actions" icon_name="gear">
            {if item.state == "cordoned" || !item.cordon_reason.is_empty() {
              <PostButton action="/{slug}/admin/hosts/action" csrf={csrf} label="Uncordon" kind="secondary" size="sm" hidden={&[("host_id", item.id.as_str()), ("action", "uncordon")]} />
            } else {
              <Form action="/{slug}/admin/hosts/action" csrf={csrf}><HiddenField name="host_id" value={&item.id} /><HiddenField name="action" value="cordon" /><Field name="reason" id="cordon-reason" label="Cordon reason" required /><Actions><Button label="Cordon" kind="secondary" /></Actions></Form>
            }}
            <PostButton action="/{slug}/admin/hosts/action" csrf={csrf} label="Drain" kind="danger" size="sm" hidden={&[("host_id", item.id.as_str()), ("action", "drain")]} />
          </Expander>
        </Expanders>
      }}
    </Section>
    <Section id="host-vms" title="Virtual machines" count={Some(machines.len())}>
      {if machines.is_empty() && error.is_empty() { <EmptyState text="No VMs reported on this host." /> }}
      <Rows>{for machine in machines {
        {let (word, tone) = crate::web::admin::fleet_state(&machine.state);}
        <Row name={&machine.id} name_id sub="" icon_name="box" tone={tone} detail={if machine.reason.is_empty() { if machine.assigned { "Assigned" } else { "Unassigned" } } else { machine.reason.as_str() }}>
          <:sub_content>{machine.size} · {machine.region} · updated <RelativeTime value={&machine.updated_at} now={*now} /></:sub_content>
          <:status><RowPill text={word} tone={tone} /></:status>
        </Row>
      }}</Rows>
      {if !next_machines_page.is_empty() { <LinkMore href={format!("{}&host_filter={host_filter}", crate::web::admin::host_url(slug, &item.id, "", next_machines_page))} label="Next VMs" /> }}
    </Section>
  }}
} else if *tab == "pool" {
  {let pool_href = format!("/{slug}/pool");}
  <Section id="grund-pool" title="grund pool" more={Some((pool_href.as_str(), "Management pool"))}>
    <Rows><Row name="Available" sub={&available.to_string()} icon_name="server" tone="ok"><:status><RowPill text="Available" tone="ok" /></:status></Row><Row name="Leased" sub={&leased.to_string()} icon_name="key" tone="violet"><:status><RowPill text="Leased" tone="violet" /></:status></Row></Rows>
    {if *manages { <LinkMore href={format!("/{slug}/pool#provision")} label="Provision machine" /> }}
  </Section>
  <Section id="fleet-pools" title="Fleet pools">
    {if pools.is_empty() && error.is_empty() { <EmptyState text="No fleet pools reported." /> }}
    <Rows>{for pool in pools {
      {let pool_word = if !pool.unschedulable_reason.is_empty() { "No capacity" } else if pool.ready > 0 { "Ready" } else if pool.desired > 0 { "Warming" } else { "Empty" };}
      {let pool_tone = if !pool.unschedulable_reason.is_empty() { "orange" } else if pool.ready > 0 { "ok" } else if pool.desired > 0 { "blue" } else { "muted" };}
      <Row name={if pool.name.is_empty() { &pool.id } else { &pool.name }} name_id={pool.name.is_empty()} sub="{pool.region} · {pool.size} · desired {pool.desired} · headroom {pool.headroom} · warm {pool.warm} · ready {pool.ready}" icon_name="layers" tone={pool_tone} detail={&pool.unschedulable_reason}>
        <:status><RowPill text={pool_word} tone={pool_tone} /></:status>
      </Row>
    }}</Rows>
    {if !next_page.is_empty() { <LinkMore href={crate::web::admin::admin_url(slug, "pool", "page", next_page)} label="Next pools" /> }}
  </Section>
} else if *tab == "leases" {
  <Section id="leases" title="Leases" count={Some(leases.len())}>
    {if leases.is_empty() && error.is_empty() { <EmptyState text="No active leases." /> }}
    <Rows>{for lease in leases {
      <Row name={&lease.name} sub="" icon_name="key" tone="violet">
        <:sub_content>{lease.lessee} · since <RelativeTime value={&lease.since} now={*now} /> · ends {lease.end}</:sub_content>
        <:status><RowPill text="Leased" tone="violet" /></:status>
      </Row>
    }}</Rows>
    {if *manages { <LinkMore href={format!("/{slug}/pool")} label="Manage leases" /> }}
  </Section>
} else if *tab == "failures" {
  <Section id="failures" title="Current fleet failures" count={Some(failures.len())}>
    {if failures.is_empty() && error.is_empty() { <EmptyState text="No current failures reported." /> }}
    <Rows>{for failure in failures {
      <Row name={&failure.machine_id} name_id sub="" icon_name="alert" tone="orange" detail={&failure.reason}>
        <:sub_content>Host <ShortId text={&failure.host_id} label="the host identifier" /> · updated <RelativeTime value={&failure.updated_at} now={*now} /></:sub_content>
        <:status>{let (word, tone) = crate::web::admin::fleet_state(&failure.state);}<RowPill text={word} tone={tone} /></:status>
      </Row>
    }}</Rows>
    {if !next_page.is_empty() { <LinkMore href={crate::web::admin::admin_url(slug, "failures", "page", next_page)} label="Next failures" /> }}
  </Section>
} else if *tab == "events" {
  <Section id="events" title="Recent events" count={Some(events.len())}>
    {if events.is_empty() && error.is_empty() { <EmptyState text="No recent events." /> }}
    <Rows>{for event in events {
      <Row name={crate::web::admin::fleet_event(&event.event_type)} sub="" icon_name="clock" tone="blue">
        <:sub_content><ShortId text={&event.resource_id} label="the resource identifier" /> · <RelativeTime value={&event.occurred_at} now={*now} /></:sub_content>
      </Row>
    }}</Rows>
    {if !next_page.is_empty() { <LinkMore href={crate::web::admin::admin_url(slug, "events", "page", next_page)} label="Earlier events" /> }}
  </Section>
} else {
  <Panel id="hosted-access" title="Hosted machine access">
    <Form action="/{slug}/admin" method={Some("get")}><HiddenField name="tab" value="organisations" /><Field name="organisation" label="Organisation slug" value={organisation} autocomplete="off" required /><Actions><Button label="Find organisation" kind="secondary" /></Actions></Form>
    {if let Some(enabled) = entitlement {
      <Rows><Row name={organisation} sub="Hosted machines" icon_name="users" tone={if *enabled { "ok" } else { "muted" }}><:status><RowPill text={if *enabled { "Enabled" } else { "Disabled" }} tone={if *enabled { "ok" } else { "muted" }} /></:status></Row></Rows>
      {if *manages {
        <PostButton action="/{slug}/admin/organisations/entitlement" csrf={csrf} label={if *enabled { "Revoke hosted access" } else { "Grant hosted access" }} kind={if *enabled { "danger" } else { "secondary" }} hidden={&[("organisation", organisation), ("action", if *enabled { "revoke" } else { "grant" })]} />
      }}
    }}
  </Panel>
  {if *billing_enabled && !organisation.is_empty() {
    <Panel id="complimentary-billing" title="Billing">
      {if let Some(account) = billing {
        <Facts>
          <Fact label="Plan" value={&account.details.plan} />
          {if !account.details.pending_plan.is_empty() { <Fact label="Next plan" value={&account.details.pending_plan} /> }}
          <Fact label="Complimentary" value={if account.details.complimentary { "Active" } else if account.details.complimentary_scheduled { "Scheduled" } else { "No" }} />
          {if account.details.complimentary_scheduled {
            {if let Some(date) = &account.details.complimentary_effective_at { <Fact label="Complimentary from" value={date} /> }}
            {if !account.details.complimentary_scheduled_plan.is_empty() { <Fact label="Complimentary plan" value={&account.details.complimentary_scheduled_plan} /> }}
          }}
          {if !account.details.complimentary_reason.is_empty() { <Fact label="Reason" value={&account.details.complimentary_reason} /> }}
          {if let Some(expiry) = &account.details.complimentary_expires_at { <Fact label="Until" value={expiry} /> }}
          {if account.details.complimentary { <Fact label="Total" value="€0" /> }}
        </Facts>
        {if account.details.complimentary_scheduled {
          <Para kind="hint">The current cycle is charged normally until the complimentary discount takes effect.</Para>
        }}
        {if *manages {
          {if account.operator_url_allowed {
            <Rows><Row name="Provider subscription ID" sub={&account.details.provider_subscription_id} plain /></Rows>
            <External href={&account.details.operator_url} label="Open payment provider" />
          }}
          <Form action="/{slug}/admin/organisations/complimentary" csrf={csrf}>
            <HiddenField name="organisation" value={organisation} />
            <HiddenField name="billing_action" value="grant" />
            <HiddenField name="idempotency_key" value={grant_key} />
            <ChoiceField name="plan" label="Complimentary plan">
              <ChoiceCard name="plan" value="Homelab" title="Homelab" selected />
              <ChoiceCard name="plan" value="Pro" title="Pro" />
              <ChoiceCard name="plan" value="Business" title="Business" />
            </ChoiceField>
            <Field name="reason" label="Reason" required />
            <Field name="expires_at" label="Expires at (ISO 8601 UTC)" placeholder={Some("2027-01-01T00:00:00Z")} required />
            <Actions><Button label="Grant complimentary billing" kind="secondary" /></Actions>
          </Form>
          {if account.details.complimentary || account.details.complimentary_scheduled {
            <Form action="/{slug}/admin/organisations/complimentary" csrf={csrf}>
              <HiddenField name="organisation" value={organisation} />
              <HiddenField name="billing_action" value="revoke" />
              <HiddenField name="idempotency_key" value={revoke_key} />
              <Field name="reason" label="Reason for revocation" required />
              <Actions><Button label="Revoke complimentary billing" kind="secondary" /></Actions>
            </Form>
          }}
        }}
      } else {
        <Banner text="Billing is unavailable. Try again later." />
      }}
    </Panel>
  }}
  <Section id="all-organisations" title="Organisations" count={Some(organisations.len())}>
    {if organisations.is_empty() && error.is_empty() { <EmptyState text="No organisations." /> }}
    <Rows>{for item in organisations {
      <Row name={&item.slug} sub="Hosted machines" icon_name="users" tone={if item.enabled { "ok" } else { "muted" }} href={crate::web::admin::admin_url(slug, "organisations", "organisation", &item.slug)}>
        <:status><RowPill text={if item.enabled { "Enabled" } else { "Disabled" }} tone={if item.enabled { "ok" } else { "muted" }} /></:status>
      </Row>
    }}</Rows>
  </Section>
}}