use crate::templates::compiled::layouts::App;
use crate::templates::compiled::components::{Contents, Specimen, Demos, Column, Labelled, Swatches, Borders, TypeScale, SpaceScale, Radii, IconGrid, Icon, ImageIcon, ImageSprite, Button, ButtonAdvanced, CopyButton, Mark, Tag, Para, LinkMore, External, IconLink, PageHead, Section, Panel, Tabs, Status, StatusLine, Pill, IconFact, Callout, Stats, EmptyState, AddCard, Code, DnsRecords, Rows, Row, Items, AppRow, AppMenu, MachineRow, ListTools, Links, Link, Tiles, Tile, Timeline, Event, Menu, MenuItem, Banner, PostButton, Search, SelectForm, Form, Field, Grid, Actions, ToggleField, PairsField, CodeField, ChipsField, ChoiceLinks, Facts, Fact, Endpoint, ChoiceField, ChoiceCard, StepperField, Group, RangeField, Expanders, Expander, Nav, NavItem, TopbarAction};
props crate::web::pages::StyleGuidePage { viewer, csrf, swatches, sprite_icons, gallery, icons, apps, machines };

<App title="Style guide" viewer={viewer} csrf={csrf} title_org={Some(false)}>
  <ImageSprite icons={icons.as_slice()} />
  <PageHead title="Style guide" />
  <Para kind="hint">The components live in <code>templates/components/</code>: <code>ui</code> (basics and page parts), <code>forms</code>, <code>lists</code>, <code>shell</code>, <code>images</code> and <code>catalogue</code>. Pages under <code>pages/</code> compose typed components, with no page-specific class rules.</Para>
  <Contents parts={&[("sg-tokens", "Tokens"), ("sg-icons", "Icons"), ("sg-buttons", "Buttons and links"), ("sg-heads", "Page and section heads"), ("sg-status", "Status and tags"), ("sg-messages", "Callouts and messages"), ("sg-empty", "Empty states and notes"), ("sg-code", "Code"), ("sg-forms", "Forms"), ("sg-choices", "Panels, facts, choices and steppers"), ("sg-rows", "Rows, links and timelines"), ("sg-items", "Apps, menus and list tools"), ("sg-shell", "Shell")]} />

  <Section id="sg-tokens" title="Tokens">
    <Specimen title="Colour" code="var(--surface)" note="Custom properties on :root. A rule never writes a raw hex; add a token instead."><Swatches swatches={swatches} /></Specimen>
    <Specimen title="Borders" code="var(--border-control)" note="Quiet edges for what holds content; edges of 3:1 or more for what you operate."><Borders /></Specimen>
    <Specimen title="Type" code="font-size: var(--text-md)" note="Inter for everything; JetBrains Mono (code, .mono) for what a person might copy."><TypeScale steps={&[("title", "2–2.5 rem", "page titles"), ("4xl", "2 rem", "signed-out titles"), ("3xl", "1.875 rem", "section titles"), ("subtitle", "1.5 rem", "panel titles"), ("2xl", "1.1875 rem", "row names, status lines"), ("xl", "1.125 rem", "card titles"), ("lg", "1.0625 rem", "buttons, stats"), ("base", "1 rem", "body"), ("md", "0.9375 rem", "small UI text, subs"), ("sm", "0.875 rem", "hints"), ("xs", "0.8125 rem", "roles, captions"), ("2xs", "0.75 rem", "tags")]} /></Specimen>
    <Specimen title="Spacing" code="gap: var(--space-4)" note="--space-N is N quarter-rems, for the gaps and margins between things. A literal length is a component's own geometry."><SpaceScale steps={&[(1, "0.25 rem"), (2, "0.5 rem"), (3, "0.75 rem"), (4, "1 rem"), (5, "1.25 rem"), (6, "1.5 rem"), (7, "1.75 rem"), (8, "2 rem"), (9, "2.25 rem"), (10, "2.5 rem"), (12, "3 rem"), (14, "3.5 rem"), (16, "4 rem")]} /></Specimen>
    <Specimen title="Radius" code="border-radius: var(--radius)"><Radii /></Specimen>
  </Section>

  <Section id="sg-icons" title="Icons">
    <Specimen title="Icon" code={r#"<Icon name="server" class="icon-lg tone-ok" />"#} note="24-unit stroke icons from the sprite in components/icons.html.sedge, in currentColor. icon-sm is 18 px, the default 22 px, icon-lg 36 px; tone-* colours them by what they stand for."><IconGrid names={sprite_icons.as_slice()} /></Specimen>
    <Specimen title="Tones" code={r#"<Icon name="server" class="icon-lg tone-blue" />"#}><Demos>{for (label, class) in [("tone-ok", "icon-lg tone-ok"), ("tone-blue", "icon-lg tone-blue"), ("tone-orange", "icon-lg tone-orange"), ("tone-violet", "icon-lg tone-violet"), ("tone-muted", "icon-lg tone-muted")] { <Labelled label={label}><Icon name="server" class={class} /></Labelled> }}</Demos></Specimen>
    <Specimen title="Image icons" code={r#"<ImageIcon key="nginx" size="" />"#} note="Well-known images get their own, any other Docker Hub image the whale, an image from another registry the neutral box. The page declares the icons it shows with ImageSprite."><Demos>{for key in gallery.iter() { <Labelled label={key}><ImageIcon key={key} /></Labelled> }}<Labelled label="docker"><ImageIcon key="docker" /></Labelled><Labelled label="image"><ImageIcon key="image" /></Labelled></Demos></Specimen>
    <Specimen title="Marks" code={r#"<Mark name="nord-studio" size="" /><Mark name="ada" size="lg" />"#} note="The letter for an organisation (in the switcher) or a person (in rows)."><Demos><Mark name="nord-studio" /><Mark name="ada" size="lg" /></Demos></Specimen>
  </Section>

  <Section id="sg-buttons" title="Buttons and links">
    <Specimen title="Kinds" code={r#"<ButtonAdvanced label="Deploy app" icon_name="plus" kind="primary" button_type="button" />
<ButtonAdvanced label="Change copies" kind="secondary" button_type="button" />
<ButtonAdvanced label="Delete storefront" kind="danger" button_type="button" />
<ButtonAdvanced label="Leave" kind="ghost" size="sm" button_type="button" />"#} note="One primary per page. Destructive actions are danger and say what they do. A link with href, else a button element."><Demos><ButtonAdvanced label="Deploy app" icon_name="plus" kind="primary" button_type="button" icon_size="sm" /><ButtonAdvanced label="Change copies" kind="secondary" button_type="button" icon_size="sm" /><ButtonAdvanced label="Delete storefront" kind="danger" button_type="button" icon_size="sm" /><ButtonAdvanced label="Leave" kind="ghost" size="sm" button_type="button" icon_size="sm" /></Demos></Specimen>
    <Specimen title="Sizes" code={r#"<ButtonAdvanced label="Run this again" kind="secondary" size="sm" />
<ButtonAdvanced label="Sign in" block={true} />
<ButtonAdvanced label="Deploy app" href={url} icon_name="plus" collapse={true} />"#} note="sm sits in rows; block fills a signed-out form; collapse shows only the icon below 520 px."><Demos><ButtonAdvanced label="Run this again" kind="secondary" size="sm" button_type="button" icon_size="sm" /><ButtonAdvanced label="Collapses on phones" href="#sg-buttons" icon_name="plus" kind="primary" collapse icon_size="sm" /></Demos><Column><ButtonAdvanced label="Sign in" kind="primary" button_type="button" block icon_size="sm" /></Column></Specimen>
    <Specimen title="States" code={r#"<ButtonAdvanced label="Deploy" kind="primary" extra="is-focus" />"#} note="Hover and focus are the browser's; the style guide pins them with is-hover and is-focus. Focus is the accent ring on everything a keyboard reaches."><Demos><Labelled label="rest"><ButtonAdvanced label="Deploy" kind="primary" button_type="button" /></Labelled><Labelled label="hover"><ButtonAdvanced label="Deploy" kind="primary" button_type="button" extra="is-hover" /></Labelled><Labelled label="focus"><ButtonAdvanced label="Deploy" kind="primary" button_type="button" extra="is-focus" /></Labelled><Labelled label="secondary hover"><ButtonAdvanced label="Change" kind="secondary" button_type="button" extra="is-hover" /></Labelled></Demos></Specimen>
    <Specimen title="Post button" code={r#"<PostButton action={url} csrf={csrf} label="Remove" kind="danger" size="sm" block={false} layout="" hidden={&[]} />"#} note="A form that is only a button, with the CSRF field: remove, stop, sign out, run again."><PostButton action="#sg-buttons" csrf={csrf} label="Remove" kind="danger" size="sm" /></Specimen>
    <Specimen title="Links" code={r#"<LinkMore href={url} label="View all" />
<External href={address} label={address} />
<IconLink href={url} icon_name="external" label="Open it in a new tab" external={true} />
<CopyButton text={text} label={label} labelled={false} />"#} note="Onward links are accent text and an arrow. An external link says it opens a new tab. Icon-only links and buttons always have an accessible name. The copy button shows only when the script runs."><Demos><LinkMore href="#sg-buttons" label="View all" /><External href="https://storefront-nord-studio.example.run" label="https://storefront-nord-studio.example.run" /><IconLink href="https://storefront-nord-studio.example.run" icon_name="external" label="Open storefront in a new tab" external /><CopyButton text="db.grund.internal:5432" label="db.grund.internal:5432" /></Demos></Specimen>
  </Section>

  <Section id="sg-heads" title="Page and section heads">
    <Specimen title="Page head" code={r#"<PageHead title="Apps" /><PageHead title={app.name} back={Some((url, "Back to apps"))} />"#} note="Every page starts with it: the title, and at the right the page's tools (list tools, a kebab). No primary button: the top bar's Deploy app is the only one outside a form. No line of prose under it. back puts a link above the title on detail pages."><PageHead title="Apps" /><PageHead title="storefront" back={Some(("#sg-heads", "Back to apps"))} /></Specimen>
    <Specimen title="A thing's head" code={r#"<PageHead title={app.name.as_str()} reference={Some(app.image.as_str())} back={Some((url, "Back to apps"))} image={Some(app.icon)} state={Some(("Live", "ok"))}><AppMenu slug={org} manages={true} name={app.name.as_str()} address={app.address.as_deref()} /></PageHead><Tabs label={app.name.as_str()} tabs={tabs} active="overview" counts={&[]} filter={false} />"#} note="A page about one thing (an app): its image icon large, a pill with its state beside the name, the image it runs (a digest cut to 12 hex, the whole in its title and its copy button), and its kebab. The name gives way; the kebab keeps its width. Tabs with an icon each split it into pages.">
      <PageHead title="storefront" reference={Some("nginx:1.27")} back={Some(("#sg-heads", "Back to apps"))} image={Some("nginx")} state={Some(("Live", "ok"))}><AppMenu slug="nord-studio" manages name={apps[0].name.as_str()} address={apps[0].address.as_deref()} /></PageHead>
      <PageHead title="customer-billing-reconciler" reference={Some("ghcr.io/nord-studio/customer-billing-reconciler:2026.10.06-3f9c0a1@sha256:200689790a0a0ea48ca45992e0450bc26ccab5307375b41c84dfc4f2475937ab")} back={Some(("#sg-heads", "Back to apps"))} image={Some("image")} state={Some(("Degraded", "orange"))}><AppMenu slug="nord-studio" manages name={apps[0].name.as_str()} address={apps[0].address.as_deref()} /></PageHead>
      <Tabs label="storefront" tabs={&[("overview", "#sg-heads", "Overview", "home"), ("deployments", "#sg-heads", "Deployments", "layers"), ("logs", "#sg-heads", "Logs", "file"), ("metrics", "#sg-heads", "Metrics", "bars"), ("settings", "#sg-heads", "Settings", "gear")]} active="overview" />
    </Specimen>
    <Specimen title="Section" code={r#"<Section id="versions" title="Versions" count={Some(3)} more={Some((url, "View all"))}>The section's content.</Section>"#} note="A titled part of a page. count is muted after the title; more is one onward link; first drops the gap under the page head."><Section id="sg-demo-section" title="Versions" count={Some(3)} more={Some(("#sg-heads", "View all"))} first={Some(true)}><p>The section's content.</p></Section></Specimen>
    <Specimen title="Tabs" code={r#"<Tabs label="Organisation" tabs={&[("general", url, "General", ""), ("members", url, "Members", "")]} active="members" counts={&[]} filter={false} />"#} note="Split one sidebar section into pages, so the sidebar keeps one item per area."><Tabs label="Example" tabs={&[("general", "#sg-heads", "General", ""), ("members", "#sg-heads", "Members", ""), ("billing", "#sg-heads", "Billing", "")]} active="members" /></Specimen>
    <Specimen title="Tabs with a count and a search" code={r#"<Tabs label="Machines" tabs={tabs} active={tab} counts={&[("disconnected", 1)]} filter={true}><Search action={url} label="Search machines" /></Tabs>"#} note="A list split by tabs that are links (?tab=), a count in a small box after a tab, and the list's own search at the end of the line, a GET form (?q=). filter: the script switches the tabs and filters as you type, in place. On a phone the search goes under the tabs."><Tabs label="Machines" tabs={&[("", "#sg-heads", "All machines", ""), ("disconnected", "#sg-heads", "Disconnected", "")]} counts={&[("disconnected", 1)]}><Search action="#sg-heads" label="Search machines" id="sg-machine-search" /></Tabs></Specimen>
  </Section>

  <Section id="sg-status" title="Status and tags">
    <Specimen title="Status" code={r#"<Status text="Serving" tone="ok" /><Status text="Offline" tone="muted" /><StatusLine text="All copies are ready." tone="ok" id="app-status" />"#} note="A toned check and a word for how a thing is. Colour means state: ok serving, blue in progress, orange attention, muted off."><Demos><Status text="Serving" tone="ok" /><Status text="Releasing" tone="blue" /><Status text="Failed" tone="orange" /><Status text="Running" tone="violet" /><Status text="Rejected" tone="danger" /><Status text="Offline" tone="muted" /></Demos><StatusLine text="All copies are ready." tone="ok" /></Specimen>
    <Specimen title="Pills" code={r#"<Pill text="Live" tone="ok" plain={false} />"#} note="Larger than a tag: a thing's state beside its name, as a dot of its tone (ok live, blue rolling out, orange degraded, danger failed, muted stopped)."><Demos><Pill text="Live" tone="ok" /><Pill text="Rolling out" tone="blue" /><Pill text="Degraded" tone="orange" /><Pill text="Failed" tone="danger" /><Pill text="Stopped" tone="muted" /></Demos></Specimen>
    <Specimen title="Plain pills" code={r#"<Pill text="Connected" tone="ok" plain={true} />"#} note="The dot and the word alone, small: how a thing in a list is, under its name."><Demos><Pill text="Connected" tone="ok" plain /><Pill text="Joining" tone="blue" plain /><Pill text="Disconnected" tone="orange" plain /><Pill text="Out of service" tone="muted" plain /></Demos></Specimen>
    <Specimen title="Facts with an icon" code={r#"<IconFact icon_name="cpu" text="16 vCPU" />"#} note="What a thing has, small, its icon before it, on one line; side by side in a row's right column."><Demos><IconFact icon_name="cpu" text="16 vCPU" /><IconFact icon_name="memory" text="64 GB RAM" /><IconFact icon_name="disk" text="1.2 TB" /></Demos></Specimen>
    <Specimen title="Tags" code={r#"<Tag text="You" />"#} note="Tiny, rounded and muted: You, Runs VMs, Needs storage."><Demos><Tag text="Needs storage" /><Tag text="You" /></Demos></Specimen>
  </Section>

  <Section id="sg-messages" title="Callouts and messages">
    <Specimen title="Callout" code={r#"<Callout title={title} text={text} icon_name="clock" tone="orange" danger={false} />"#} note="Something happening now or needing attention: a toned icon, a title naming the thing and one sentence. danger for failures."><Callout title="Deleting nord-studio" text="Waiting for billing. Nothing is deleted until it answers." icon_name="clock" tone="orange" /><Callout title="The release failed" text="v4 could not start: its ready check never answered." icon_name="alert" tone="orange" danger /></Specimen>
    <Specimen title="Banners" code={r#"<Banner text={error} tone="error" />"#} note="One banner for a whole form or page, above it: what happened and what to do next. Nothing renders when the message is empty."><Column><Banner text="Your email is confirmed. Sign in to continue." tone="ok" /><Banner text="That email, username or password is not right." /></Column></Specimen>
    <Specimen title="Stats" code={r#"<Stats facts={&[("server", "3 machines online"), ("globe", "4 domains")]} />"#} note="Small print at the foot of a page."><Stats facts={&[("server", "3 machines online"), ("globe", "4 domains connected")]} /></Specimen>
  </Section>

  <Section id="sg-empty" title="Empty states and notes">
    <Specimen title="Empty state" code={r#"<EmptyState title="No apps yet" text="Owners and admins deploy them." /><EmptyState title="" text="No versions yet." />"#} note="A dashed box: what is missing, and how it will appear. The body holds a link or code."><EmptyState title="No apps yet" text="Owners and admins deploy them." /><EmptyState text="No versions yet." /></Specimen>
    <Specimen title="Empty list" code={r#"<EmptyState title="Add your first machine" icon_name="server"><Button label="Add machine" href={url} kind="secondary" /></EmptyState>"#} note="In place of a whole list: the icon, what is missing, and what to do. Secondary, since the top bar holds the primary button. filter_empty: the one the script shows when a search (match) or a tab (tab) leaves the list empty."><EmptyState title="Add your first machine" icon_name="server"><Button label="Add machine" href="#sg-empty" icon_name="plus" kind="secondary" /><External href="https://git.kjuulh.io/grund/grund#self-hosting" label="Learn more" /></EmptyState><EmptyState title="No machines match" icon_name="search" /></Specimen>
    <Specimen title="Add card" code={r#"<AddCard href={url} title="Deploy your first app" />"#} note="The dashed card in place of an empty list, for those who can make the first one."><AddCard href="#sg-empty" title="Deploy your first app" /></Specimen>
    <Specimen title="Paragraphs" code={r#"<Para text="2 of 7 apps match “re”." kind="note" /><Para text="All copies run on homelab-1." kind="hint" /><Para text="" kind="aside">With grund installed, run <code>grund machines register</code>.</Para>"#} note="para(text, kind): hint (the default) is small print, a caveat or a reference; note a quiet line about the list under it; aside the other way to do it; auth-lede the line under a signed-out title."><Para kind="note">2 of 7 apps match “re”.</Para><Para kind="hint">All copies run on homelab-1; add a machine to spread them.</Para><Para kind="aside">With grund installed: <code>grund machines register</code>, then keep <code>grund agent</code> running.</Para></Specimen>
  </Section>

  <Section id="sg-code" title="Code">
    <Specimen title="Inline code" code="<code>grund.yaml</code>" note="In a sentence, a plain <code> sets a name, a path or a command in the mono face."><p>The newest release as <code>grund.yaml</code>, for your repository.</p></Specimen>
    <Specimen title="A file" code={r#"<Code text={file} filename="grund.yaml" download={url} copy={true} />"#} note="Anything grund offers as a file: its name in the head, Copy (with the script) and Download (a link, so it works without it), and the text in its own frame, its lines kept and scrolling sideways when long."><Code text={"apps:\n  storefront:\n    image: nginx:1.27\n    copies: 2\n    ports:\n    - name: http\n      port: 80\n      public: true"} filename="grund.yaml" download="#sg-code" copy /></Specimen>
    <Specimen title="A command or a token" code={r#"<Code text={install} id="setup-install" wrap={true} copy={true} />"#} note="Text to copy whole, wrapping anywhere, with a copy button in its corner (shown only with the script). copy=false for text too long to copy usefully, such as a licence."><Code text="curl -fsSL https://grund.example/install | sh -s -- --code 7KQ2-9XWD" copy wrap /></Specimen>
    <Specimen title="DNS records" code={r#"<DnsRecords records={records} label="Records for shop.example.com" />"#} note="Records for someone to make at their DNS provider: type, name and value, the name and value with copy buttons (shown only with the script). A table; each row stacks below 900 px."><DnsRecords records={&[("TXT", "_grund.shop.example.com", "grund-verify-3kQ9xYv2LmN8pR4tW6zB1cD5fG7hJ0kL2nM4qS6uV8w"), ("CNAME", "shop.example.com", "storefront-nord-studio.example.run")]} label="Records for shop.example.com" /></Specimen>
  </Section>

  <Section id="sg-forms" title="Forms">
    <Specimen title="The rule" code={r#"<Panel id="set" title="Add or replace a login"><Form action={url} csrf={csrf}><Banner text={error} tone="error" /><Field name="host" label="Registry" error={host_error} /><Actions note="Saving a registry that has a login replaces it."><Button label="Save login" /></Actions></Form></Panel>"#} note="A form on a signed-in page lives in a panel (or an expander): label, control, then one line, the hint or the error in its place. A refused form says so once at its top; banner(fields=…) does it when the handler only marked a field. It ends in actions(): what saving does on the left, the buttons on the right, the submit primary (danger when it destroys) and last. Short values take width sm, names md; the rest fill their column.">
      <Panel id="sg-rule" title="Add or replace a login">
        <Form action="#sg-forms" csrf={csrf}>
          <Banner fields={Some(&["That is not a registry host."])} />
          <Field name="sg-host" label="Registry" value="not a host" error="That is not a registry host, such as ghcr.io." required width={Some("md")} mono />
          <Grid><Field name="sg-user" label="Username" value="robot" required /><Field name="sg-secret" label="Password or access token" kind="password" hint="Never shown again." required /></Grid>
          <Actions note="Saving a registry that has a login replaces it."><ButtonAdvanced label="Save login" kind="primary" button_type="button" /></Actions>
        </Form>
      </Panel>
    </Specimen>
    <Specimen title="Field states and widths" code={r#"<Field name="name" label="Name" hint={hint} width={Some("md")} /><Field name="port" label="Port" kind="number" required={false} width={Some("sm")} /><Field name="name" label="Name" error={error} /><Field name="email" label="Email" value={email} disabled={true} />"#} note="required=false marks the label Optional. error sets aria-invalid and points aria-describedby at the message; disabled shows a known value that is not sent. width: sm (11 rem) for a number, md (26 rem) for a name.">
      <Column>
        <Field name="sg-rest" label="Name" hint="Letters a–z, digits and single hyphens." required width={Some("md")} />
        <Field name="sg-port" label="Port" kind="number" value="8080" hint="Found from the image when empty." width={Some("sm")} />
        <Field name="sg-focus" label="Name (focus)" value="storefront" required state={Some("focus")} />
        <Field name="sg-error" label="Name (error)" value="Store Front" error="Use letters a–z, digits and single hyphens." required />
        <Field name="sg-disabled" label="Email (disabled)" kind="email" value="ada@nord.studio" required disabled />
      </Column>
    </Specimen>
    <Specimen title="Switch" code={r#"<ToggleField name="auto_rollback" label="Roll back a failed release on its own" checked={true} hint={hint} state="" />"#} note="A switch is one yes or no: a checkbox that sends name=on, so the handler reads a missing value as off."><Column><ToggleField name="sg-rollback" label="Roll back a failed release on its own" checked hint="The release before keeps serving." /><ToggleField name="sg-rollback-off" label="Off (focus)" hint="To debug a failing release in place." state="focus" /></Column></Specimen>
    <Specimen title="Names and values" code={r#"<PairsField name="env" label="Environment variables" pairs={env} secret={false} blank={1} /><PairsField name="secrets" label="Secrets" pairs={secrets} secret={true} blank={0} />"#} note="A row for each pair and blank rows to add more; a row left empty is dropped. Rows post as env_key and env_value in order. With the script, Add another adds a row and each row can be removed. secret makes the values passwords, never written back.">
      <PairsField name="sg-env" label="Environment variables" pairs={&[("LOG_LEVEL", "info"), ("FEATURE_FLAGS", "search,beta")]} hint="Put passwords and keys in a secret." blank={1} key_label="Name" value_label="Value" />
      <PairsField name="sg-secrets" label="Secrets" pairs={&[("DB_PASSWORD", "")]} error="Row 1: a secret's name is letters, digits and _." secret blank={0} key_label="Name" value_label="Value" />
    </Specimen>
    <Specimen title="Code as input" code={r#"<CodeField name="file" label="grund.yaml" value={file} filename="grund.yaml" rows={14} required={true} />"#} note="Lines a machine reads, edited in the same frame Code shows them in: a whole file, or a command one argument per line."><CodeField name="sg-file" label="Your grund.yaml" value={"apps:\n  storefront:\n    image: nginx:1.27\n    copies: 2"} filename="grund.yaml" rows={4} required hint="Applied as a new release, checked as the API checks it." /></Specimen>
    <Specimen title="Fields in a row" code={r#"<Form action={url} csrf={csrf} layout={Some("row")}><Field name="email" label="Email" kind="email" /><ChipsField name="role" label="Role" options={roles} multiple={false} /><Button label="Send invitation" /></Form>"#} note="A form of one or two fields and its button: side by side, the button level with the boxes; each field takes the whole width below 900 px.">
      <Form action="#sg-forms" csrf={csrf} layout={Some("row")}><Field name="sg-invite" label="Email" kind="email" required placeholder={Some("name@example.com")} /><ChipsField name="sg-invite-role" label="Role" options={&[("member", "Member"), ("admin", "Admin")]} selected="member" /><ButtonAdvanced label="Send invitation" kind="primary" button_type="button" /></Form>
    </Specimen>
    <Specimen title="Select in a row" code={r#"<SelectForm action={url} csrf={csrf} name="role" id={id} label="Role of linus" options={roles} selected="admin" button="Change" />"#} note="One choice posted from a row, such as a member's role. With the script it applies on change and the button hides."><SelectForm action="#sg-forms" csrf={csrf} name="role" id="sg-member-role" label="Role of linus" options={&[("member", "Member"), ("admin", "Admin"), ("owner", "Owner")]} selected="admin" button="Change" /></Specimen>
  </Section>

  <Section id="sg-choices" title="Panels, facts, choices and steppers">
    <Specimen title="Choice links" code={r#"<ChoiceLinks label="Deployment mode" choices={modes} active="custom" />"#} note="A choice between ways of doing a page's work, as large cards that are links, so it works without the script; the chosen one is marked like a selected radio. Each mode has key, href, icon, title, text and sub."><ChoiceLinks label="Deployment mode" choices={&[crate::templates::ChoiceLink { key: "premade", href: "#sg-choices", icon: "grid", title: "Premade", text: "A pinned version of a common app", sub: "NATS, whoami, nginx" }, crate::templates::ChoiceLink { key: "custom", href: "#sg-choices", icon: "box", title: "Custom", text: "Any container image", sub: "" }]} active="custom" /></Specimen>
    <Specimen title="Panel and grid" code={r#"<Panel id="custom" title="Custom deployment"><Grid><Field name="name" label="Name" /><StepperField name="copies" label="Copies" max="20" /></Grid></Panel><Actions note="Deploying makes the app and its first release." note_icon="layers"><Button label="Deploy app" /></Actions>"#} note="A titled box for one part of a page's work. grid() puts fields in two columns (one below 900 px), and a grid inside a grid splits a column. actions() ends a form: the note says what it does, the primary is last.">
      <Panel id="sg-panel" title="Custom deployment"><Grid>
        <Field name="sg-app-name" label="Name" value="storefront" hint="Lowercase letters, digits and -." />
        <Grid><Field name="sg-port-2" label="Port" kind="number" hint="Empty: from the image." /><StepperField name="sg-copies" label="Copies" value="2" min="1" max="20" /></Grid>
      </Grid></Panel>
      <Actions note="Deploying makes the app and its first release." note_icon="layers"><Button label="Cancel" kind="secondary" href="#sg-choices" /><ButtonAdvanced label="Deploy app" kind="primary" button_type="button" /></Actions>
    </Specimen>
    <Specimen title="Panel with an action, and facts" code={r#"<Panel id="status" title="Application status" action={Some((url, "All releases"))}><Facts><Fact label="Reachable at" wide={true}><Endpoint text={address} href={address} /></Fact><Fact label="Status" value="Live" tone="ok" /></Facts></Panel>"#} note={r#"action puts one secondary button at the right of a panel's title. facts() is fact()s divided by lines: a wide one on a row of its own, the rest three across (two below 900 px): a label, the value large with an icon or a state's dot (after: quieter words on its line, "· kjuulh"), and at most a quieter line, each on one line, cut with an ellipsis, the whole in its title. Each fact says one thing once (Kasper, 2026-10-06: the version appears once). endpoint() is an address with a copy button: a link when public, code when internal."#}>
      <Panel id="sg-facts" title="Application status" action={Some(("#sg-choices", "All releases"))}><Facts>
        <Fact label="Reachable at" wide><Endpoint text="https://storefront-nord-studio.example.run" href="#sg-choices" /></Fact>
        <Fact label="Status" value="Live" tone="ok" />
        <Fact label="Running" value="v8" icon_name="layers" lines={&[("nginx:1.27 · 2006897a0a1c", "nginx:1.27@sha256:2006897a0a1c0ea48ca45992e0450bc26ccab5307375b41c84dfc4f2475937ab")]} />
        <Fact label="Last change" value="2 hours ago" icon_name="clock" after="· a-rather-long-account-name" />
      </Facts></Panel>
      <Panel id="sg-facts-private" title="Internal"><Facts><Fact label="Reachable at" wide><Endpoint text="db.grund.internal:5432" /></Fact><Fact label="Status" value="Failed" tone="danger" /></Facts></Panel>
    </Specimen>
    <Specimen title="Choice field" code={r#"<ChoiceField name="exposure" label="Exposure" hint={hint}><ChoiceCard name="exposure" value="private" title="Private" selected={true} /></ChoiceField>"#} note="A choice of one as cards over radio buttons. Each option has value, title, text and icon or image; disabled and tag mark one not offered yet; state pins hover or focus (the style guide only); error replaces the hint. large widens the cards; fill names a field the script fills with the chosen value.">
      <ChoiceField name="sg-exposure" label="Exposure" hint="Public: https://<name>-nord-studio.example.run">
        <ChoiceCard name="sg-exposure" value="private" title="Private" text="Only other apps reach it" icon="lock" selected />
        <ChoiceCard name="sg-exposure" value="public" title="Public HTTP" text="Via a example.run address" icon="globe" />
      </ChoiceField>
      <ChoiceField name="sg-template" label="App (large, with a disabled one and an error)" error="Choose one of the apps." large>
        <ChoiceCard name="sg-template" value="nats" title="NATS" text="A messaging server for your apps." image="nats" />
        <ChoiceCard name="sg-template" value="postgres" title="PostgreSQL" text="A relational database." image="postgres" disabled tag="Needs storage" />
      </ChoiceField>
      <ChoiceField name="sg-states" label="States (hover, focus)"><ChoiceCard name="sg-states" value="a" title="Hover" text="state: hover" icon="lock" state="hover" /><ChoiceCard name="sg-states" value="b" title="Focus" text="state: focus" icon="globe" state="focus" /></ChoiceField>
    </Specimen>
    <Specimen title="Stepper" code={r#"<StepperField name="copies" label="Copies" value="1" min="1" max="20" hint="" error="" />"#} note="A whole number with − and +. The buttons show only with the script; without it the number is typed, with the browser's own arrows."><Column><StepperField name="sg-copies-2" label="Copies" value="1" min="1" max="20" error="Copies is a whole number from 1 to 20." /></Column></Specimen>
    <Specimen title="Chips" code={r#"<ChipsField name="machines" label="Machines" options={machines} selected_many={selected} multiple={true} search="Search machines" /><ChipsField name="days" label="Expires after" options={lifetimes} selected="90" multiple={false} />"#} note="A choice among values that exist (machines, apps, labels) or a short fixed set (a role, a lifetime), every option in sight: checkboxes, or radio buttons drawn as buttons with multiple=false. Without the script it is the same list; with it, search filters the chips as you type once there are eight or more. empty says what to do when there is nothing to choose.">
      <Column>
        <ChipsField name="sg-machines" label="Machines" options={&[("edge-1", "edge-1"), ("edge-2", "edge-2"), ("web-1", "web-1"), ("web-2", "web-2"), ("web-3", "web-3"), ("db-1", "db-1"), ("db-2", "db-2"), ("batch-1", "batch-1"), ("lab", "lab")]} selected_many={&["web-1", "db-1"]} multiple search="Search machines" />
        <ChipsField name="sg-days" label="Expires after" options={&[("30", "30 days"), ("90", "90 days"), ("365", "365 days")]} selected="90" />
        <ChipsField name="sg-near" label="Prefer near apps" options={&[("db", "db")]} multiple error="db is also in apart; name it in one of them." />
        <ChipsField name="sg-none" label="Labels" multiple empty="No machine has a label yet. Set them on Machines." />
      </Column>
    </Specimen>
    <Specimen title="Suggestions and units" code={r#"<Field name="spread_by" label="Label key" suggestions={Some(&["disk", "gpu", "zone"])} mono /><Field name="reschedule_after" label="Replace after unreachable for" kind="number" unit={Some("seconds")} min={Some("30")} max={Some("3600")} />"#} note="suggestions offers what exists as you type (a datalist: the label keys set on machines, the ports the image listens on); any other value can still be typed. unit sits after a number's box, and min and max bound it; the hint says the bounds and the default."><Column><Field name="sg-spread-by" label="Label key" value="zone" required mono suggestions={Some(&["disk", "gpu", "zone"])} /><Field name="sg-reschedule" label="Replace after unreachable for" kind="number" value="120" hint="30 to 3600. Empty: 120." unit={Some("seconds")} min={Some("30")} max={Some("3600")} width={Some("md")} /></Column></Specimen>
    <Specimen title="Group, and a choice with fields inside" code={r#"<Group id="spread-copies" title="Spread copies" optional={false}><ChoiceField name="spread" label="" error="" hint="" large={false}><ChoiceCard name="spread" value="label" selected={true}><Field name="spread_by" label="Label key" /></ChoiceCard></ChoiceField></Group>"#} note="group() boxes related fields under a heading in a long form; optional=true marks it. ChoiceCard holds each option's own fields, shown inside its card while it is chosen (CSS :has, no script); the handler reads only the chosen card's.">
      <Group id="sg-spread" title="Spread copies"><ChoiceField name="sg-spread-choice">
        <ChoiceCard name="sg-spread-choice" value="machines" title="Spread across machines" text="Copies go to different machines first." />
        <ChoiceCard name="sg-spread-choice" value="label" title="Spread across label" text="Copies go to different values of a label first, such as zones." selected><Field name="sg-spread-key" label="Label key" value="zone" required mono suggestions={Some(&["zone", "rack"])} /></ChoiceCard>
      </ChoiceField></Group>
      <Group id="sg-affinity" title="Affinity" optional><ChipsField name="sg-near-2" label="Prefer near apps" options={&[("db", "db"), ("cache", "cache")]} selected_many={&["db"]} multiple /></Group>
    </Specimen>
    <Specimen title="Number and slider, and presets" code={r#"<RangeField name="memory" label="Memory" value="512" steps={memory_steps} unit="MiB" icon_name="memory" min="16" max="2048" step="1" /><ChoiceField name="preset" label="" error="" hint="" large={false}><ChoiceCard name="preset" value="medium" sets={preset_json} has_presets={true} /></ChoiceField>"#} note="A number with its unit and a slider that snaps to the usual values, kept in step by the script; without it the slider is hidden and the box suggests the same values. Steps are (value, label) pairs that stop at what the largest machine can give. A choice field whose options carry sets fills those fields; changing them chooses the matching preset or Custom.">
      <RangeField name="sg-memory" label="Memory" value="512" steps={&[("64", "64"), ("128", "128"), ("256", "256"), ("512", "512"), ("1024", "1 GB"), ("2048", "2 GB")]} unit="MiB" icon_name="memory" hint="Per copy" min="16" max="2048" step="1" />
      <RangeField name="sg-cpu" label="CPU" value="0.3" steps={&[("0.1", "0.1"), ("0.25", "0.25"), ("0.5", "0.5"), ("1", "1")]} unit="vCPU" icon_name="cpu" hint="Per copy" error="The largest machine here gives one copy at most 1 vCPU." min="0.01" max="1" step="any" />
      <ChoiceField name="sg-preset"><ChoiceCard name="sg-preset" value="low" title="Low" text="128 MiB · 0.25 vCPU" sets="sg-cpu=0.25 sg-memory=128" has_presets /><ChoiceCard name="sg-preset" value="medium" title="Medium" text="512 MiB · 1 vCPU" sets="sg-cpu=1 sg-memory=512" has_presets /><ChoiceCard name="sg-preset" value="custom" title="Custom" text="The values above" icon="sliders" selected has_presets /></ChoiceField>
    </Specimen>
    <Specimen title="Expanders" code={r#"<Expanders><Expander title="v8" summary="Rolled back to v5" state={Some(("Live", "ok"))}>Its details.</Expander><Expander title="Delete nord-studio" summary="Cannot be undone." kind="danger">Its form.</Expander></Expanders>"#} note="Things in one line each that open to show more, as details elements, so they open without the script: a release, a form's optional part, an organisation's rename and delete. kind danger is delete. state puts a pill after the title. Open the one a refused form is in.">
      <Expanders>
        <Expander title="v8" summary="Rolled back to v5 by ada from the dashboard" icon_name="layers" tone="ok" state={Some(("Live", "ok"))} meta={&["2006897a", "2 hours ago"]}><p>Its details.</p></Expander>
        <Expander title="Copies (open)" summary="2 copies · rolls back a failed release on its own" icon_name="copy" open><Form action="#sg-choices" csrf={csrf}><StepperField name="sg-copies-3" label="Copies" value="2" min="1" max="20" /><Actions note="Saving applies at once, without a release."><ButtonAdvanced label="Save" kind="primary" button_type="button" /></Actions></Form></Expander>
        <Expander title="Delete nord-studio" summary="Cannot be undone." icon_name="trash" kind="danger"><p>Its form.</p></Expander>
      </Expanders>
    </Specimen>
  </Section>

  <Section id="sg-rows" title="Rows, links and timelines">
    <Specimen title="Rows" code={r#"<Rows><Row name="homelab-1" sub="Connected" icon_name="server"><:end><PostButton action={url} csrf={csrf} label="Remove" kind="danger" size="sm" /></:end></Row></Rows>"#} note="Resources divided by lines, no box: an icon, the name over a mono sub-line, a status, an action. letter puts a person's mark in place of the icon; plain drops both for a name over a value.">
      <Rows>
        <Row name="homelab-1" sub="Connected · homelab-1.lan" icon_name="server" tone="ok" tags={&["Runs VMs"]} status_text={Some("Connected")} status_tone="ok"><:end><PostButton action="#sg-rows" csrf={csrf} label="Remove" kind="danger" size="sm" /></:end></Row>
        <Row name="v3 · nginx:1.27" sub="5 Oct 2026 · ada from the dashboard · sha256:2006" icon_name="grid" tone="orange" detail="v3 could not start: its ready check never answered." status_text={Some("Failed")} status_tone="orange"><:end><PostButton action="#sg-rows" csrf={csrf} label="Run this again" kind="secondary" size="sm" /></:end></Row>
        <Row name="linus" sub="linus@nord.studio · joined 9 Sep 2026" tone="ok" letter="linus" status_tone="ok"><:status><SelectForm action="#sg-rows" csrf={csrf} name="role" id="sg-linus-role" label="Role of linus" options={&[("member", "Member"), ("admin", "Admin")]} selected="admin" button="Change" /></:status><:end><PostButton action="#sg-rows" csrf={csrf} label="Remove" kind="danger" size="sm" /></:end></Row>
        <Row name="ada" sub="ada@nord.studio · joined 2 Sep 2026" tone="ok" letter="ada" tags={&["You"]} status_text={Some("Owner")} status_tone="ok"><:end><PostButton action="#sg-rows" csrf={csrf} label="Leave" kind="ghost" size="sm" /></:end></Row>
        <Row name="storefront" sub="https://storefront-nord-studio.example.run" icon_name="globe" tone="ok" href="#sg-rows" status_tone="ok" />
      </Rows>
      <Rows><Row name="Plan" sub="Free" tone="ok" status_tone="ok" plain><:end><Para kind="hint">Nothing is charged.</Para></:end></Row><Row name="Managed by" sub="ada" tone="ok" status_tone="ok" plain><:end><LinkMore href="#sg-rows" label="Manage billing" /></:end></Row></Rows>
    </Specimen>
    <Specimen title="Links and tiles" code={r#"<Panel id="configured" title="Configured"><Links><Link href={url} title="Exposure" value="Public HTTP" /></Links></Panel>
<Panel id="more" title="Add more"><Tiles><Tile href={url} title="Secrets" /></Tiles></Panel>"#} note="An app's Settings: links() is a box of lines that each open a page of their own (icon, name, value, action word, chevron); tiles() a grid of things to add, three across and one on a phone. A link after a panel stands alone, as Delete does.">
      <Panel id="sg-configured" title="Configured"><Links>
        <Link href="#sg-rows" title="Exposure" value="Public HTTP on port 80 · https://storefront-nord-studio.example.run" icon_name="globe" action="Edit" />
        <Link href="#sg-rows" title="Copies (hover)" value="3 copies" icon_name="copy" action="Edit" state="hover" />
        <Link href="#sg-rows" title="Resources (focus)" value="64 MiB and 0.20 CPU per copy" icon_name="bars" action="Edit" state="focus" />
      </Links></Panel>
      <Panel id="sg-more" title="Add more"><Tiles><Tile href="#sg-rows" title="Environment variables" /><Tile href="#sg-rows" title="Secrets (hover)" state="hover" /><Tile href="#sg-rows" title="Custom domain (focus)" state="focus" /></Tiles></Panel>
      <Links><Link href="#sg-rows" title="Delete storefront" icon_name="trash" danger /></Links>
    </Specimen>
    <Specimen title="Timeline" code={r#"<Timeline><Event title="Rolling out" when="just now" at={timestamp} iso={iso} meta="v4" state="busy">Deployed by <strong>ada</strong></Event></Timeline>"#} note="What happened, newest first, on a line. The marker says how it ended: ok a check (what runs now), failed an alert, busy a blue ring, otherwise a quiet ring. The time is a time element with the exact time as its title.">
      <Timeline>
        <Event title="Rolling out" when="just now" at="6 Oct 2026 10:02 UTC" iso="2026-10-06T10:02:00Z" meta="v4" state="busy">Deployed by <strong>ada</strong> from the API</Event>
        <Event title="Deployment successful" when="2 hours ago" at="6 Oct 2026 08:00 UTC" iso="2026-10-06T08:00:00Z" meta="v3" state="ok">Deployed by <strong>ada</strong> from the dashboard</Event>
        <Event title="Deployment failed" when="1 day ago" at="5 Oct 2026 09:00 UTC" iso="2026-10-05T09:00:00Z" meta="v2" state="failed">Deployed by <strong>linus</strong> from grund.yaml</Event>
        <Event title="Deployment successful" when="3 days ago" at="3 Oct 2026 09:00 UTC" iso="2026-10-03T09:00:00Z" meta="v1">Rolled back to v1 by <strong>ada</strong></Event>
      </Timeline>
    </Specimen>
  </Section>

  <Section id="sg-items" title="Apps, menus and list tools">
    <Specimen title="Apps as a list" code={r#"<ListTools sorts={sorts} sort="name" list_href={url} grid_href={url} view="list" hidden={&[]} /><Items view="list">{for app in apps { <AppRow slug={org} manages={true} app={app} /> }}</Items>"#} note="items is one bordered box of rows; each app_row is its image icon, its name over its image, its address and its menu. A public app shows its https address; one with a port its internal name with a copy button; one with no port nothing.">
      <ListTools sorts={&[("name", "Name"), ("deployed", "Last deployed"), ("created", "Newest")]} sort="name" list_href="#sg-items" grid_href="#sg-items" view="list" />
      <Items view="list">{for app in apps { <AppRow slug="nord-studio" manages app={app} /> }}</Items>
    </Specimen>
    <Specimen title="Apps as a grid" code={r#"<Items view="grid">{for app in apps { <AppRow slug={org} manages={true} app={app} /> }}</Items>"#} note="The same rows as cards."><Items view="grid">{for app in apps.iter().take(3) { <AppRow slug="nord-studio" manages app={app} /> }}</Items></Specimen>
    <Specimen title="Machines" code={r#"<Items view="list">{for machine in machines { <MachineRow slug={org} manages={true} machine={machine} csrf={csrf} /> }}</Items>"#} note="machine_row: the server icon, the name with its kind (Hosted) and labels as tags (three, then +N), a plain pill and one more fact under it, the icon facts it reported at the right (disk only once its agent reports it), and machine_menu, whose actions post at once through menu_post."><Items view="list">{for machine in machines { <MachineRow slug="nord-studio" manages machine={machine} csrf={csrf} /> }}</Items></Specimen>
    <Specimen title="Menu" code={r#"<Menu label="Actions for storefront" icon_name="more" open={false}><MenuItem href={url} icon_name="grid" label="Details" danger={false} external={false} state="" /></Menu>"#} note="A details element, so it opens without script; the script closes it on Escape (focus back on the button) or a click elsewhere. Items link to where the action lives; a destructive one is danger and ends in … when it leads to a confirmation."><Demos><Labelled label="closed"><Menu label="Actions for storefront" icon_name="more"><MenuItem href="#sg-items" icon_name="grid" label="Details" /></Menu></Labelled></Demos><Column><Menu label="Actions for api" icon_name="more" open><MenuItem href="#sg-items" icon_name="external" label="Open" external /><MenuItem href="#sg-items" icon_name="grid" label="Details" state="hover" /><MenuItem href="#sg-items" icon_name="clock" label="Releases" /><MenuItem href="#sg-items" icon_name="trash" label="Delete…" danger /></Menu></Column></Specimen>
  </Section>
  <Section id="sg-shell" title="Shell">
    <Specimen title="Nav items" code={r#"<Nav><NavItem href="/{org}/apps" icon_name="grid" label="Apps" active={section == "apps"} /></Nav>"#} note="The shell is put together by the App layout only: the sidebar with the organisation switcher, the nav and the account menu, and the top bar with the search and Deploy app. A page passes section in its context to mark its item."><Column><Nav><NavItem href="#sg-shell" icon_name="home" label="Overview" /><NavItem href="#sg-shell" icon_name="grid" label="Apps (current)" active /><NavItem href="#sg-shell" icon_name="server" label="Machines (hover)" state="hover" /></Nav></Column></Specimen>
    <Specimen title="Top bar action" code={r#"<TopbarAction org={org} section={section} state="" />"#} note="The screen's one primary button, by section: Add machine on Machines, none on the page an action opens (Deploy app, Add machine), Deploy app everywhere else. Only for owners and admins."><Demos>{if let Some(org) = viewer.current.as_ref() { <Labelled label="machines"><TopbarAction org={org} section="machines" /></Labelled><Labelled label="apps"><TopbarAction org={org} section="apps" /></Labelled><Labelled label="hover"><TopbarAction org={org} section="apps" state="hover" /></Labelled> }}</Demos></Specimen>
  </Section>
</App>
