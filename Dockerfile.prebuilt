# Packages the static musl binary that CI already built and tested. Nothing is
# compiled, pulled or run here: the image holds exactly the artifact the
# accepttests ran against, and the release step stages everything else beside
# it in the build context (.image/):
#
#   grund                  the binary
#   ca-certificates.crt    Alpine's CA bundle, from the release step's image
#                          after `apk add ca-certificates`: a CA bundle, not
#                          compiled-in roots, so a root change is a rebuild,
#                          not a code change
#   var/lib/grund/         empty, so a named volume mounted there starts out
#                          writable for `grund init`
#
# A base stage (FROM alpine + apk add) cost every publish a base-image pull and
# a package download, and put the Alpine mirrors on the path to dev.
# `Dockerfile` builds the same image from source for `docker compose up`; keep
# the final stages of the two files identical.
FROM scratch
COPY ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chown=65532:65532 var/lib/grund /var/lib/grund
COPY grund /grund
# Numeric because scratch has no /etc/passwd.
USER 65532:65532
ENV GRUND_LISTEN=0.0.0.0:8080 \
    GRUND_LOG_FORMAT=json
EXPOSE 8080 443
ENTRYPOINT ["/grund"]
CMD ["serve"]
